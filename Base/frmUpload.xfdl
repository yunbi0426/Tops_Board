                      <Cell id="cell_body_2_0_file_name" col="2" row="0" text="bind:file_name" displaytype="normal" edittype="none"/>
                      <Cell id="cell_body_3_0_row_count" col="3" row="0" text="bind:row_count" displaytype="number" edittype="none"/>
                      <Cell id="cell_body_4_0_new_count" col="4" row="0" text="bind:new_count" displaytype="number" edittype="none"/>
                      <Cell id="cell_body_5_0_changed_count" col="5" row="0" text="bind:changed_count" displaytype="number" edittype="none"/>
                      <Cell id="cell_body_6_0_uploaded_at" col="6" row="0" text="bind:uploaded_at" displaytype="normal" edittype="none"/>
                    </Band>
                  </Format>
                </Formats>
              </Grid>
            </Layout>
          </Layouts>
          <Objects/>
          <Script><![CDATA[this._fnViewOnLoad = function(objForm){/* Sets the view form reference so that functions declared in the view can access it */this._ownerForm = objForm;};]]>
          </Script>
        </View>
      </Layout>
