<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="frmUpload" width="1050" height="736" titletext="New Form">
    <Layouts>
      <Layout width="1050" height="736">
        <View id="viewUpload" left="10" top="10" taborder="3" height="50" text="View00" right="10" viewdataset="_dstops_importTopsExcel_ds_input">
          <Layouts>
            <Layout>
              <Static id="staBaseDate" left="10" top="10" width="56" height="32" text="기준일" _fieldid="base_date" _fieldcomptype="label"/>
              <Calendar id="calBaseDate" left="72" top="10" width="140" height="32" dateformat="yyyy-MM-dd" editformat="yyyy-MM-dd" _fieldid="base_date" _fieldcomptype="comp"/>
              <Static id="staFileName" left="228" top="10" width="40" height="32" text="파일" _fieldid="file_name" _fieldcomptype="label"/>
              <Edit id="edtFileName" left="274" top="10" width="300" height="32" readonly="true" _fieldid="file_name" _fieldcomptype="comp"/>
              <Button id="btnSelect" left="582" top="10" width="90" height="32" text="파일 선택"/>
              <Button id="btnUpload" left="680" top="10" width="110" height="32" text="업로드"/>
            </Layout>
          </Layouts>
          <Objects>
            <FileDialog id="fdgExcel" filter="Excel(*.xlsx)|*.xlsx|"/>
          </Objects>
          <Bind>
            <BindItem id="bind_calBaseDate" compid="calBaseDate" propid="value" datasetid="_dstops_importTopsExcel_ds_input" columnid="base_date"/>
            <BindItem id="bind_edtFileName" compid="edtFileName" propid="value" datasetid="_dstops_importTopsExcel_ds_input" columnid="file_name"/>
          </Bind>
          <Script><![CDATA[
	this.fvBaseDateField = "base_date";
	this.fvFileNameField = "file_name";

	this._fnViewOnLoad = function(objForm) {
		/* Sets the view form reference so that functions declared in the view can access it */
		this._ownerForm = objForm;

		/* 업로드 Action 이 읽어가는 파일 목록 */
		this.oUploadFileList = [];

		/* View Dataset : 1행 보장 + 기준일 기본값(오늘) */
		var oDs = this.parent.getViewDataset();
		if (oDs) {
			/* 기본 행(Normal)을 지우고 Insert 상태 행으로 새로 만든다 */
			oDs.clearData();
			oDs.addRow();
		
			if (this.fvBaseDateField) {
				var vDate = oDs.getColumn(0, this.fvBaseDateField);
				if (vDate === undefined || vDate === null || vDate === "") {
					oDs.setColumn(0, this.fvBaseDateField, this.fn_getToday());
				}
			}
		} else if (this.calBaseDate) {
			this.calBaseDate.set_value(this.fn_getToday());
		}

		this.fdgExcel.addEventHandler("onclose", this.fn_fileDialog_onclose, this);
		this.btnSelect.addEventHandler("onclick", this.fn_btnSelect_onclick, this);
	};

	this.fn_getToday = function() {
		var d = new Date();
		var m = d.getMonth() + 1;
		var n = d.getDate();
		return "" + d.getFullYear() + (m < 10 ? "0" + m : m) + (n < 10 ? "0" + n : n);
	};

	this.fn_setFileName = function(sFileName) {
		var oDs = this.parent.getViewDataset();
		if (oDs && this.fvFileNameField) {
			if (oDs.getRowCount() < 1) {
				oDs.addRow();
			}
			oDs.setColumn(0, this.fvFileNameField, sFileName);
		} else if (this.edtFileName) {
			this.edtFileName.set_value(sFileName);
		}
	};

	this.fn_btnSelect_onclick = function(obj, e) {
		/* 1 : FileDialog.LOAD (파일 1개) */
		this.fdgExcel.open("엑셀 파일 선택", 1);
	};

	this.fn_fileDialog_onclose = function(obj, e) {
		var aFiles = e.virtualfiles;
		if (!aFiles || aFiles.length < 1) {
			return;		// 취소 : 기존 선택 유지
		}

		var oFile = aFiles[0];
		var sName = oFile.filename ? ("" + oFile.filename) : "";
		if (sName.toLowerCase().lastIndexOf(".xlsx") != sName.length - 5 || sName.length < 6) {
			this.fn_clearFile();
			this.alert("xlsx 파일만 업로드할 수 있습니다.");
			return;
		}

		this.oUploadFileList = [oFile];
		this.fn_setFileName(sName);
	};

	this.fn_clearFile = function() {
		this.oUploadFileList = [];
		this.fn_setFileName("");
	};
]]>
          </Script>
        </View>
        <View id="viewResult" left="10" top="viewUpload:10" taborder="1" height="110" text="viewResult" right="10" viewdataset="_dstops_uploadLogSelect_ds_output">
          <Layouts>
            <Layout>
              <Static id="staFrame" left="10" top="10" right="10" bottom="10" text="" border="1px solid #E0DED6" borderRadius="12px" background="#FFFFFF"/>
              <Static id="staHeader" left="22" top="22" right="22" height="22" text="" color="#5F5E5A" font="normal 12px/normal &quot;Malgun Gothic&quot;" usedecorate="true"/>
              <Static id="staTotal" left="50%" top="22" right="22" height="22" text="" color="#5F5E5A" font="normal 12px/normal &quot;Malgun Gothic&quot;" usedecorate="true" textAlign="right"/>
              <Static id="staTrack" left="22" top="52" right="22" height="10" text="" background="#D3D1C7" borderRadius="5px"/>
              <Static id="staSeg_new_count" left="22" top="52" width="0" height="10" text="" background="#639922" _fieldid="new_count" _fieldcomptype="comp"/>
              <Static id="staSeg_changed_count" left="staSeg_new_count:0" top="52" width="0" height="10" text="" background="#EF9F27" _fieldid="changed_count" _fieldcomptype="comp"/>
              <Static id="staLegend" left="22" top="70" right="22" height="22" text="" color="#5F5E5A" font="normal 12px/normal &quot;Malgun Gothic&quot;" usedecorate="true"/>
            </Layout>
          </Layouts>
          <Script><![CDATA[
	this.fvHeaderFormat = "<b v='true'>{upload_id}회차</b>   기준일 {base_date}";
	this.fvEmptyText = "업로드 이력이 없습니다";
	this.fvTotalField = "row_count";
	this.fvTotalLabel = "전체";
	this.fvRestLabel = "변동 없음";
	this.fvValueSuffix = "건";
	this.fvSegFields = ["new_count","changed_count"];
	this.fvSegLabels = ["신규","변경"];
	this.fvSegColors = ["#639922","#EF9F27","#378ADD","#D4537E"];
	this.fvRestColor = "#D3D1C7";
	this.fvMinSegPx = 3;

	this._fnViewOnLoad = function(objForm) {
		/* Sets the view form reference so that functions declared in the view can access it */
		this._ownerForm = objForm;

		var oDs = this.parent.getViewDataset();
		if (!this._bSummaryInit) {
			/* 조회 완료 / 값 변경 / 행 이동 때 갱신, 크기 변경 때 막대 길이 재계산. 재호출 시 중복 등록 방지 */
			if (oDs) {
				oDs.addEventHandler("onload", this.fn_ds_onchanged, this);
				oDs.addEventHandler("oncolumnchanged", this.fn_ds_onchanged, this);
				oDs.addEventHandler("onrowposchanged", this.fn_ds_onchanged, this);
			}
			this.addEventHandler("onsize", this.fn_onsize, this);
			this._bSummaryInit = true;
		}

		this.fn_refresh();
	};

	this.fn_ds_onchanged = function(obj, e) {
		this.fn_refresh();
	};

	this.fn_onsize = function(obj, e) {
		this.fn_refresh();
	};

	this.fn_refresh = function() {
		var oDs    = this.parent.getViewDataset();
		var bData  = oDs && oDs.getRowCount() > 0 && oDs.rowposition >= 0;
		var nRow   = bData ? oDs.rowposition : -1;
		var oThis  = this;
		var sUnit  = this.fvValueSuffix ? " " + this.fvValueSuffix : "";
		var i;

		// 제목
		if (!bData) {
			this.staHeader.set_text(this.fvEmptyText);
		} else {
			this.staHeader.set_text(("" + this.fvHeaderFormat).replace(/\{([A-Za-z0-9_]+)\}/g, function(sAll, sCol) {
				return oThis.fn_formatValue(oDs.getColumn(nRow, sCol));
			}));
		}

		// 구간 값과 합계 (합계 필드가 없으면 구간 합을 합계로)
		var arrValues = [];
		var nSegSum   = 0;
		for (i = 0; i < this.fvSegFields.length; i++) {
			var n = bData ? this.fn_toNumber(oDs.getColumn(nRow, this.fvSegFields[i])) : 0;
			arrValues.push(n);
			nSegSum += n;
		}
		var nTotal = (bData && this.fvTotalField) ? this.fn_toNumber(oDs.getColumn(nRow, this.fvTotalField)) : nSegSum;
		var nRest  = Math.max(nTotal - nSegSum, 0);

		// 합계 (오른쪽)
		this.staTotal.set_text(bData
			? this.fvTotalLabel + " <b v='true'><fs v='12'>" + this.fn_formatNumber(nTotal) + "</fs></b>" + sUnit
			: "");

		// 막대 : 실제 막대 너비(px) 기준으로 구간 길이 계산
		var nTrackW = this.staTrack.getOffsetWidth();
		for (i = 0; i < this.fvSegFields.length; i++) {
			var oSeg = this["staSeg_" + this.fvSegFields[i]];
			if (!oSeg) {
				continue;
			}
			var nW = 0;
			if (nTotal > 0 && arrValues[i] > 0) {
				nW = Math.max(Math.round(nTrackW * arrValues[i] / nTotal), this.fvMinSegPx);
			}
			oSeg.set_width(nW);
		}

		// 범례
		var sLegend = "";
		if (bData) {
			for (i = 0; i < this.fvSegFields.length; i++) {
				var sColor = this.fvSegColors.length > 0 ? this.fvSegColors[i % this.fvSegColors.length] : "#639922";
				sLegend += "<fc v='" + sColor + "'>■</fc> " + this.fvSegLabels[i] + " " + this.fn_formatNumber(arrValues[i]) + sUnit + "      ";
			}
			sLegend += "<fc v='" + this.fvRestColor + "'>■</fc> " + this.fvRestLabel + " " + this.fn_formatNumber(nRest) + sUnit;
		}
		this.staLegend.set_text(sLegend);
	};

	this.fn_toNumber = function(v) {
		var n = parseFloat(v);
		return isNaN(n) ? 0 : n;
	};

	this.fn_formatValue = function(v) {
		if (v === undefined || v === null) {
			return "";
		}
		if (v.getFullYear) {
			var p = function(n) { return n < 10 ? "0" + n : "" + n; };
			var sDate = v.getFullYear() + "-" + p(v.getMonth() + 1) + "-" + p(v.getDate());
			if (v.getHours() == 0 && v.getMinutes() == 0) {
				return sDate;
			}
			return sDate + " " + p(v.getHours()) + ":" + p(v.getMinutes());
		}
		return "" + v;
	};

	this.fn_formatNumber = function(v) {
		var s = "" + v;
		if (!/^-?\d+(\.\d+)?$/.test(s)) {
			return this.fn_formatValue(v);
		}
		var arr = s.split(".");
		arr[0] = arr[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
		return arr.join(".");
	};
]]>
          </Script>
        </View>
        <View id="viewHistory" left="10" top="viewResult:10" taborder="0" text="viewHistory" right="10" bottom="10" viewdataset="_dstops_uploadLogSelect_ds_output">
          <Layouts>
