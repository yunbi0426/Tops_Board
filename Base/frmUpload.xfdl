    <Objects>
      <Transaction id="Transaction00" alias="업로드 회차 조회" servicemodel="tops::upload/uploadLogSelect" serviceurl="NexaLAPServer::api/v1/execute">
        <Contents><![CDATA[{
    "outputdatasets": [
        {
            "modelid": "ds_output",
            "datasetid": "_dstops_uploadLogSelect_ds_output"
        }
    ]
}]]>
        </Contents>
