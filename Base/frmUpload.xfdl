      <RunScript id="RunScript01" alias="삭제 칸 클릭 확인">
        <Contents><![CDATA[`let e = this._current_action.getEventInfo();
return !!(e && e.row == 0 && e.cell == 7);`]]>
        </Contents>
      </RunScript>
      <Message id="Message02" alias="최근 회차 삭제 확인" message="최근 회차를 삭제할까요? 이 회차에서 바뀐 요구사항 상태가 직전 회차로 되돌아가며, 삭제 후에는 복구할 수 없습니다." messagetype="confirm"/>
      <Transaction id="Transaction03" alias="최근 회차 삭제" servicemodel="tops::upload/uploadDelete" serviceurl="NexaLAPServer::api/v1/execute">
        <Contents><![CDATA[{
    "inputdatasets": [
        {
            "modelid": "ds_input",
            "datasetid": "_dstops_upload_uploadDelete_ds_input",
            "type": "A"
        }
    ],
    "outputdatasets": [
        {
            "modelid": "ds_output",
            "datasetid": "_dstops_upload_uploadDelete_ds_output"
        }
    ]
}]]>
        </Contents>
      </Transaction>
      <Message id="Message03" alias="회차 삭제 완료 안내" message="최근 회차를 성공적으로 삭제했습니다." messagetype="alert"/>
      <Message id="Message04" alias="최근 회차 아님 안내" message="최근 회차만 삭제할 수 있습니다. 이력을 다시 불러옵니다." messagetype="alert"/>
      <Dataset id="_dstops_upload_uploadDelete_ds_input">
        <ColumnInfo>
          <Column id="upload_id" type="INT" size="10" description="업로드 회차"/>
        </ColumnInfo>
        <Rows>
          <Row/>
        </Rows>
      </Dataset>
      <Dataset id="_dstops_upload_uploadDelete_ds_output">
        <ColumnInfo>
          <Column id="deleted_yn" type="int" size="2" description="deleted_yn"/>
          <Column id="latest_id" type="int" size="11" description="latest_id"/>
        </ColumnInfo>
        <Rows/>
      </Dataset>
      <RunScript id="RunScript02" alias="삭제 대상 회차 담기">
        <Contents><![CDATA[`let ds = this._dstops_upload_uploadDelete_ds_input;
let src = this._dstops_uploadLogSelect_ds_output;
ds.clearData();
let nRow = ds.addRow();
ds.setColumn(nRow, "upload_id", src.getColumn(0, "upload_id"));`]]>
        </Contents>
      </RunScript>
    </Objects>
    <Trigger>
      <TriggerItem id="item0" triggertype="onload" triggerview="" triggerobj="" targetaction="Transaction00"/>
      <TriggerItem id="item1" triggertype="onload" triggerview="" triggerobj="" targetaction="OnLoadView00"/>
      <TriggerItem id="item4" triggertype="Action Success" triggerview="" triggerobj="Transaction01" targetaction="Transaction00"/>
      <TriggerItem id="item2" triggertype="Action Success" triggerview="" triggerobj="Transaction01" targetaction="OnLoadView00"/>
      <TriggerItem id="item13" triggertype="onclick" triggerview="viewUpload" triggerobj="btnUpload" targetaction="ClearData00"/>
      <TriggerItem id="item14" triggertype="Action Success" triggerview="" triggerobj="ClearData00" targetaction="CopyRow00"/>
      <TriggerItem id="item5" triggertype="Action Success" triggerview="" triggerobj="CopyRow00" targetaction="Transaction02"/>
      <TriggerItem id="item8" triggertype="Action Success" triggerview="" triggerobj="Transaction02" targetaction="Message00" condition="this._dstops_upload_uploadDupCheck_ds_dup.getColumn(0, &quot;future_yn&quot;) == 1"/>
      <TriggerItem id="item7" triggertype="Action Success" triggerview="" triggerobj="FileUploadTransfer00" targetaction="Transaction01"/>
      <TriggerItem id="item6" triggertype="Action Success" triggerview="" triggerobj="Transaction02" targetaction="Message01" condition="this._dstops_upload_uploadDupCheck_ds_dup.getColumn(0, &quot;future_yn&quot;) == 0 &amp;&amp; this._dstops_upload_uploadDupCheck_ds_dup.getColumn(0, &quot;dup_cnt&quot;) &gt; 0"/>
      <TriggerItem id="item9" triggertype="Action Success" triggerview="" triggerobj="Transaction02" targetaction="FileUploadTransfer00" condition="this._dstops_upload_uploadDupCheck_ds_dup.getColumn(0, &quot;future_yn&quot;) == 0 &amp;&amp; this._dstops_upload_uploadDupCheck_ds_dup.getColumn(0, &quot;dup_cnt&quot;) == 0"/>
      <TriggerItem id="item10" triggertype="Action Success" triggerview="" triggerobj="Message01" targetaction="FileUploadTransfer01"/>
      <TriggerItem id="item11" triggertype="Action Success" triggerview="" triggerobj="FileUploadTransfer01" targetaction="Transaction01"/>
      <TriggerItem id="item12" triggertype="onclick" triggerview="viewUpload" triggerobj="btnFileClear" targetaction="RunScript00"/>
      <TriggerItem id="item3" triggertype="onclick" triggerview="viewUpload" triggerobj="btnGroupingRequester" targetaction="OpenPopup00"/>
      <TriggerItem id="item15" triggertype="oncellclick" triggerview="viewHistory" triggerobj="grdList" targetaction="RunScript01"/>
      <TriggerItem id="item16" triggertype="Action Success" triggerview="" triggerobj="RunScript01" targetaction="Message02"/>
      <TriggerItem id="item24" triggertype="Action Success" triggerview="" triggerobj="Message02" targetaction="RunScript02"/>
      <TriggerItem id="item25" triggertype="Action Success" triggerview="" triggerobj="RunScript02" targetaction="Transaction03"/>
      <TriggerItem id="item20" triggertype="Action Success" triggerview="" triggerobj="Transaction03" targetaction="Message03" condition="this._dstops_upload_uploadDelete_ds_output.getColumn(0, &apos;deleted_yn&apos;) == 1"/>
      <TriggerItem id="item17" triggertype="Action Success" triggerview="" triggerobj="Transaction03" targetaction="Message04" condition="this._dstops_upload_uploadDelete_ds_output.getColumn(0, &apos;deleted_yn&apos;) == 0"/>
      <TriggerItem id="item22" triggertype="Action Success" triggerview="" triggerobj="Message03" targetaction="Transaction00"/>
      <TriggerItem id="item23" triggertype="Action Success" triggerview="" triggerobj="Message04" targetaction="Transaction00"/>
    </Trigger>
    <ViewGenerationInfo>
      <ViewInfo viewid="frmUpload">
        <ModelInfo modelserviceid="tops" serviceid="upload/importTopsExcel" modelid="_FileMetaInfo" datasetid="_dstops_importTopsExcel__FileMetaInfo00" filepath="upload\.model\importTopsExcel.model"/>
        <ViewTemplateInfo/>
