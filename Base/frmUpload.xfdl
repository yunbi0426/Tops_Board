        <ModelInfo modelserviceid="tops" serviceid="upload/uploadDupCheck" modelid="ds_input" datasetid="_dstops_upload_uploadDupCheck_ds_input" filepath="upload\.model\uploadDupCheck.model"/>
        <ModelInfo modelserviceid="tops" serviceid="upload/uploadDelete" modelid="ds_input" datasetid="_dstops_upload_uploadDelete_ds_input" filepath="upload\.model\uploadDelete.model"/>
        <ModelInfo modelserviceid="tops" serviceid="upload/uploadDelete" modelid="ds_output" datasetid="_dstops_upload_uploadDelete_ds_output" filepath="upload\.model\uploadDelete.model"/>
      </ViewInfo>
      <ViewInfo viewid="viewUpload">
