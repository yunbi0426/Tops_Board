                    </Band>
                    <Band id="body">
                      <Cell id="cell_body_0_0_upload_id" row="0" col="0" textAlign="center" text="bind:upload_id" displaytype="number" edittype="none"/>
                      <Cell id="cell_body_1_0_base_date" row="0" col="1" textAlign="center" text="bind:base_date" displaytype="date" edittype="none" calendardateformat="yyyy-MM-dd" calendardisplaynulltype="none"/>
                      <Cell id="cell_body_2_0_file_name" row="0" col="2" textAlign="center" text="bind:file_name" displaytype="normal" edittype="none"/>
                      <Cell id="cell_body_3_0_row_count" row="0" col="3" textAlign="center" text="bind:row_count" displaytype="number" edittype="none"/>
                      <Cell id="cell_body_4_0_new_count" row="0" col="4" textAlign="center" text="bind:new_count" displaytype="number" edittype="none"/>
                      <Cell id="cell_body_5_0_changed_count" row="0" col="5" textAlign="center" text="bind:changed_count" displaytype="number" edittype="none"/>
                      <Cell id="cell_body_6_0_uploaded_at" row="0" col="6" textAlign="center" text="bind:uploaded_at" displaytype="normal" edittype="none"/>
                      <Cell id="cell_body_7_0_undefined" row="0" col="7" textAlign="center" text="expr:currow == 0 ? &apos;삭제&apos; : &apos;&apos;" cssclass="cell_WF_Delete"/>
                    </Band>
                  </Format>
                </Formats>
              </Grid>
            </Layout>
          </Layouts>
          <Objects/>
          <Script><![CDATA[this._fnViewOnLoad = function(objForm){/* Sets the view form reference so that functions declared in the view can access it */this._ownerForm = objForm;};]]>
          </Script>
        </View>
