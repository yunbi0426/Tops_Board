      </ViewInfo>
      <ViewInfo viewid="viewHistory">
        <ModelInfo modelserviceid="tops" serviceid="upload/uploadLogSelect" modelid="ds_output" datasetid="_dstops_uploadLogSelect_ds_output" filepath="upload\.model\uploadLogSelect.model">
