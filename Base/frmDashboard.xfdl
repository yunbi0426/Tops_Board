<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="frmDashboard" width="1050" height="736">
    <Layouts>
      <Layout width="1050" height="736">
        <View id="Summary" left="10" top="10" height="140" text="Summary" right="10" viewdataset="_dstops_dashboard_statSelect_ds_summary">
          <Layouts>
            <Layout>
              <Static id="staFrame" left="0" top="0" right="0" bottom="0" text="" border="1px solid #E0DED6" borderRadius="12px" background="#FFFFFF"/>
              <Static id="staHeader" left="12" top="12" right="12" height="20" text="" color="#5F5E5A" font="normal 12px/normal &quot;Malgun Gothic&quot;" usedecorate="true"/>
              <Static id="staCard_total_cnt" left="12" top="40" bottom="12" text="전체" background="#F1EFE8" borderRadius="8px" color="#444441" padding="0px 14px" verticalAlign="middle" usedecorate="true" font="normal 500 22px/normal &quot;Malgun Gothic&quot;" _fieldid="total_cnt" _fieldcomptype="comp" width="23%"/>
              <Static id="staCard_done_cnt" left="staCard_total_cnt:8" top="40" bottom="12" text="완료" background="#EAF3DE" borderRadius="8px" color="#27500A" padding="0px 14px" verticalAlign="middle" usedecorate="true" font="normal 500 22px/normal &quot;Malgun Gothic&quot;" _fieldid="done_cnt" _fieldcomptype="comp" width="23%"/>
              <Static id="staCard_remain_cnt" left="staCard_done_cnt:8" top="40" bottom="12" text="잔여" background="#FAEEDA" borderRadius="8px" color="#633806" padding="0px 14px" verticalAlign="middle" usedecorate="true" font="normal 500 22px/normal &quot;Malgun Gothic&quot;" _fieldid="remain_cnt" _fieldcomptype="comp" width="23%"/>
              <Static id="staCard_done_rate" left="staCard_remain_cnt:8" top="40" bottom="12" text="완료율" background="#E6F1FB" borderRadius="8px" color="#0C447C" padding="0px 14px" verticalAlign="middle" usedecorate="true" font="normal 500 22px/normal &quot;Malgun Gothic&quot;" _fieldid="done_rate" _fieldcomptype="comp" right="12"/>
            </Layout>
          </Layouts>
          <Script><![CDATA[
	this.fvHeaderFormat = "반려 {exclude_cnt}건 제외";
	this.fvEmptyText = "데이터가 없습니다";
	this.fvValueSuffix = ["건","건","건","%"];
	this.fvCardFields = ["total_cnt","done_cnt","remain_cnt","done_rate"];
	this.fvCardLabels = ["전체","완료","잔여","완료율"];
	this.fvLabelColors = ["#5F5E5A","#3B6D11","#854F0B","#185FA5"];
	this.fvSmallPt = 9;

	this._fnViewOnLoad = function(objForm) {
			/* Sets the view form reference so that functions declared in the view can access it */
			this._ownerForm = objForm;

			var oDs = this.parent.getViewDataset();
			if (oDs && !this._bSummaryInit) {
				/* 조회 완료(onload) / 값 변경(oncolumnchanged) / 행 이동(onrowposchanged) 때 갱신. 재호출 시 중복 등록 방지 */
				oDs.addEventHandler("onload", this.fn_ds_onchanged, this);
				oDs.addEventHandler("oncolumnchanged", this.fn_ds_onchanged, this);
				oDs.addEventHandler("onrowposchanged", this.fn_ds_onchanged, this);
				this._bSummaryInit = true;
			}

			this.fn_refresh();
		};

	this.fn_ds_onchanged = function(obj, e) {
			this.fn_refresh();
		};

	this.fn_refresh = function() {
			var oDs   = this.parent.getViewDataset();
			var bData = oDs && oDs.getRowCount() > 0 && oDs.rowposition >= 0;
			var nRow  = bData ? oDs.rowposition : -1;
			var oThis = this;

			// 제목 줄
			if (this.staHeader && this.fvHeaderFormat) {
				if (!bData) {
					this.staHeader.set_text(this.fvEmptyText);
				} else {
					var sText = ("" + this.fvHeaderFormat).replace(/\{([A-Za-z0-9_]+)\}/g, function(sAll, sCol) {
						return oThis.fn_formatValue(oDs.getColumn(nRow, sCol));
					});
					this.staHeader.set_text(sText);
				}
			}

			// 카드 : 1줄 라벨(작게, 라벨색) + 2줄 값(천 단위 쉼표) + 작은 단위
			var sSmall = "<fs v='" + this.fvSmallPt + "'>";
			for (var i = 0; i < this.fvCardFields.length; i++) {
				var sCol  = this.fvCardFields[i];
				var oCard = this["staCard_" + sCol];
				if (!oCard) {
					continue;
				}

				var sColor = this.fvLabelColors.length > 0 ? this.fvLabelColors[i % this.fvLabelColors.length] : "#5F5E5A";
				var sLabel = "<fc v='" + sColor + "'>" + sSmall + this.fvCardLabels[i] + "</fs></fc>";

				var sValue = "-";
				if (bData) {
					var v = oDs.getColumn(nRow, sCol);
					if (v !== undefined && v !== null && v !== "") {
						var sSuffix = this.fvValueSuffix[i] || "";
						sValue = this.fn_formatNumber(v) + (sSuffix ? sSmall + " " + sSuffix + "</fs>" : "");
					}
				}

				oCard.set_text(sLabel + "\n" + sValue);
			}
		};

	this.fn_formatValue = function(v) {
			if (v === undefined || v === null) {
				return "";
			}
			if (v.getFullYear) {
				var p = function(n) { return n < 10 ? "0" + n : "" + n; };
				var sDate = v.getFullYear() + "-" + p(v.getMonth() + 1) + "-" + p(v.getDate());
				if (v.getHours() == 0 && v.getMinutes() == 0) {
					return sDate;
				}
				return sDate + " " + p(v.getHours()) + ":" + p(v.getMinutes());
			}
			return "" + v;
		};

	this.fn_formatNumber = function(v) {
			var s = "" + v;
			if (!/^-?\d+(\.\d+)?$/.test(s)) {
				return this.fn_formatValue(v);
			}
			var arr = s.split(".");
			arr[0] = arr[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
			return arr.join(".");
		};
]]>
          </Script>
        </View>
        <View id="Chart" left="10" top="Summary:10" width="40%" height="50%" text="Chart" viewtype="Chart" viewdataset="_dstops_dashboard_statSelect_ds_rank">
          <Layouts>
            <Layout>
              <Static id="staFrame" left="0" top="0" right="0" bottom="0" text="" border="1px solid #E0DED6" borderRadius="12px" background="#FFFFFF"/>
              <Spin id="spnTopN" top="12" right="12" width="64" height="26" min="1" max="15" value="5" increment="1"/>
              <Static id="staTopN" top="12" right="spnTopN:4" width="40" height="26" text="상위" textAlign="right" color="#888780" font="normal 12px/normal &quot;Malgun Gothic&quot;"/>
              <Static id="staTitle" left="12" top="12" right="staTopN:8" height="26" text="잔여 상위 요구처" color="#444441" font="normal 500 13px/normal &quot;Malgun Gothic&quot;"/>
              <Div id="divBars" left="12" top="46" right="12" bottom="12" text="" border="0px none" background="transparent">
                <Layouts>
                  <Layout/>
                </Layouts>
              </Div>
              <Static id="staEmpty" left="12" top="46" right="12" bottom="12" text="데이터가 없습니다" textAlign="center" color="#888780" font="normal 12px/normal &quot;Malgun Gothic&quot;" visible="false"/>
            </Layout>
          </Layouts>
          <Script><![CDATA[
	this.fvConf = {"labelField":"req_name","valueField":"remain_cnt","etcField":"etc_yn","etcValue":"Y","barColor":"#534AB7","etcColor":"#B4B2A9","trackColor":"#F1EFE8","labelWidth":140,"rowHeight":26,"barHeight":10,"valueWidth":56,"scrollW":14,"textFont":"normal 12px/normal \"Malgun Gothic\"","textColor":"#444441","mutedColor":"#888780"};

	this._fnViewOnLoad = function(objForm) {
			/* Sets the view form reference so that functions declared in the view can access it */
			this._ownerForm = objForm;

			if (!this._bRankInit) {
				/* 조회 완료 / 값 변경 / 필터 때 다시 그림, 크기 변경 때 다시 배치. 중복 등록 방지 */
				var oDs = this.parent.getViewDataset();
				if (oDs) {
					oDs.addEventHandler("onload", this.fn_ds_onchanged, this);
					oDs.addEventHandler("oncolumnchanged", this.fn_ds_onchanged, this);
					oDs.addEventHandler("onrowsetchanged", this.fn_ds_onchanged, this);
				}
				this.addEventHandler("onsize", this.fn_onsize, this);
				this.arrBarComps = [];
				this._bRankInit = true;
			}

			this.fn_render();
		};

	this.fn_ds_onchanged = function(obj, e) {
			this.fn_render();
		};

	this.fn_onsize = function(obj, e) {
			/* 너비가 실제로 바뀐 경우에만 다시 그림 */
			if (this.divBars && this.divBars.getOffsetWidth() != this._nLastWidth) {
				this.fn_render();
			}
		};

	this.fn_clearBars = function() {
			var oForm = this.divBars.form;
			var arr = this.arrBarComps || [];
			for (var i = 0; i < arr.length; i++) {
				var oComp = oForm.removeChild(arr[i]);
				if (oComp) {
					oComp.destroy();
				}
			}
			this.arrBarComps = [];
		};

	this.fn_addStatic = function(sId, nLeft, nTop, nWidth, nHeight, oProps) {
			var oForm = this.divBars.form;
			var oSta = new Static(sId, nLeft, nTop, nWidth, nHeight, null, null, null, null, null, null, oForm);
			for (var sKey in oProps) {
				var fnSet = oSta["set_" + sKey];
				if (typeof fnSet == "function") {
					fnSet.call(oSta, oProps[sKey]);
				}
			}
			oForm.addChild(sId, oSta);
			oSta.show();
			this.arrBarComps.push(sId);
			return oSta;
		};

	this.fn_render = function() {
			var c     = this.fvConf;
			var oDs   = this.parent.getViewDataset();
			var nRows = (oDs && c.labelField && c.valueField) ? oDs.getRowCount() : 0;
			var i;

			this.fn_clearBars();
			this.staEmpty.set_visible(nRows < 1);
			if (nRows < 1) {
				this.divBars.form.resetScroll();
				return;
			}

			/* 행 높이 합이 영역보다 크면 스크롤바 자리만큼 오른쪽을 비움 */
			var nAreaW  = this.divBars.getOffsetWidth();
			var nAreaH  = this.divBars.getOffsetHeight();
			var nRight  = (nRows * c.rowHeight > nAreaH) ? c.scrollW : 0;
			var nTrackL = c.labelWidth + 8;
			var nTrackW = Math.max(nAreaW - nTrackL - c.valueWidth - 8 - nRight, 20);
			var nValueL = nTrackL + nTrackW + 8;
			var nBarTop = Math.floor((c.rowHeight - c.barHeight) / 2);
			this._nLastWidth = nAreaW;

			/* 막대 길이 기준 : 기타가 아닌 행의 최댓값 (전부 기타면 전체 최댓값) */
			var nMax = 0, nMaxAll = 0;
			for (i = 0; i < nRows; i++) {
				var nV = parseFloat(oDs.getColumn(i, c.valueField)) || 0;
				var bE = c.etcField && ("" + oDs.getColumn(i, c.etcField)) == c.etcValue;
				nMaxAll = Math.max(nMaxAll, nV);
				if (!bE) {
					nMax = Math.max(nMax, nV);
				}
			}
			if (nMax <= 0) {
				nMax = nMaxAll > 0 ? nMaxAll : 1;
			}

			for (i = 0; i < nRows; i++) {
				var sLabel = oDs.getColumn(i, c.labelField);
				var nValue = parseFloat(oDs.getColumn(i, c.valueField)) || 0;
				var bEtc   = c.etcField && ("" + oDs.getColumn(i, c.etcField)) == c.etcValue;
				var nTop   = i * c.rowHeight;
				var nFillW = nValue > 0 ? Math.max(Math.round(nTrackW * Math.min(nValue / nMax, 1)), 2) : 0;
				var sColor = bEtc ? c.mutedColor : c.textColor;

				this.fn_addStatic("staBarLabel_" + i, 0, nTop, c.labelWidth, c.rowHeight, {
					text: sLabel == null ? "" : "" + sLabel, color: sColor, font: c.textFont, tooltiptext: sLabel == null ? "" : "" + sLabel
				});
				this.fn_addStatic("staBarTrack_" + i, nTrackL, nTop + nBarTop, nTrackW, c.barHeight, {
					text: "", background: c.trackColor, borderRadius: "4px"
				});
				if (nFillW > 0) {
					this.fn_addStatic("staBarFill_" + i, nTrackL, nTop + nBarTop, nFillW, c.barHeight, {
						text: "", background: bEtc ? c.etcColor : c.barColor, borderRadius: "4px"
					});
				}
				this.fn_addStatic("staBarValue_" + i, nValueL, nTop, c.valueWidth, c.rowHeight, {
					text: this.fn_formatNumber(nValue), color: sColor, font: c.textFont, textAlign: "right"
				});
			}

			this.divBars.form.resetScroll();
		};

	this.fn_formatNumber = function(v) {
			var s = "" + v;
			if (!/^-?\d+(\.\d+)?$/.test(s)) {
				return s;
			}
			var arr = s.split(".");
			arr[0] = arr[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
			return arr.join(".");
		};
]]>
          </Script>
        </View>
        <View id="Main" left="Chart:10" top="Summary:10" height="50%" text="Main" right="10" viewtype="Grid" viewdataset="_dstops_dashboard_statSelect_ds_requester">
          <Layouts>
            <Layout>
              <Static id="sta_frame" left="0" top="0" right="0" bottom="0" text="" border="1px solid #E0DED6" borderRadius="12px" background="#FFFFFF" _fieldid="FRAME" _fieldcomptype="label"/>
              <Edit id="edt_filterSearch" top="12" right="12" width="240" height="30" displaynulltext="검색" padding="0px 30px 0px 30px" _fieldid="_filterSearch" _fieldcomptype="comp"/>
              <Static id="sta_searchIcon" left="edt_filterSearch:-240" top="12" width="30" height="30" text="" background="URL(&apos;theme://images/btn_WF_InputSearchN.png&apos;) no-repeat center center" _fieldid="_searchIcon" _fieldcomptype="label"/>
              <Button id="btn_searchClear" top="12" right="12" width="30" height="30" text="✕" tooltiptext="검색어 지우기" border="0px none" background="transparent" color="#888780" _fieldid="_searchClear" _fieldcomptype="comp"/>
              <Grid id="grdList" left="12" right="12" bottom="12" top="50" binddataset="_dstops_dashboard_statSelect_ds_requester" autofittype="col" nodatatext="데이터가 없습니다" cssclass="grd_WF_Detail" _fieldid="grdList" _fieldcomptype="comp">
                <Formats>
                  <Format id="default">
                    <Columns>
                      <Column size="70" band="body"/>
                      <Column size="30" band="body"/>
                      <Column size="30" band="body"/>
                      <Column size="30" band="body"/>
                      <Column size="100" band="body"/>
                    </Columns>
                    <Rows>
                      <Row size="32" band="head"/>
                      <Row size="32" band="body"/>
                    </Rows>
                    <Band id="head">
                      <Cell id="cell_head_0_0_요구처" row="0" col="0" textAlign="center" text="요구처" tooltiptext="클릭하여 정렬"/>
                      <Cell id="cell_head_1_0_전체" row="0" col="1" textAlign="center" text="전체" tooltiptext="클릭하여 정렬"/>
                      <Cell id="cell_head_2_0_완료" row="0" col="2" textAlign="center" text="완료" tooltiptext="클릭하여 정렬"/>
                      <Cell id="cell_head_3_0_잔여" row="0" col="3" textAlign="center" text="잔여" tooltiptext="클릭하여 정렬"/>
                      <Cell id="cell_head_4_0_진행율" row="0" col="4" text="진행율" tooltiptext="클릭하여 정렬"/>
                    </Band>
                    <Band id="body">
                      <Cell id="cell_body_0_0_req_name" row="0" col="0" textAlign="center" text="bind:req_name" displaytype="normal" edittype="none"/>
                      <Cell id="cell_body_1_0_total_cnt" row="0" col="1" textAlign="center" text="bind:total_cnt" displaytype="normal" edittype="none"/>
                      <Cell id="cell_body_2_0_done_cnt" row="0" col="2" textAlign="center" text="bind:done_cnt" displaytype="normal" edittype="none"/>
                      <Cell id="cell_body_3_0_remain_cnt" row="0" col="3" textAlign="center" text="bind:remain_cnt" displaytype="normal" edittype="none"/>
                      <Cell id="cell_body_4_0_done_rate" row="0" col="4" progressbarsmooth="true" text="bind:done_rate" displaytype="progressbarcontrol" edittype="none"/>
                    </Band>
                  </Format>
                </Formats>
              </Grid>
            </Layout>
          </Layouts>
          <Objects/>
          <Script><![CDATA[this.fvConf = {"titleText":"","showCount":true,"headSort":true,"selectFirst":true,"mutedColor":"#888780","defaultSort":""};this._fnViewOnLoad = function(objForm) {/* Sets the view form reference so that functions declared in the view can access it */this._ownerForm = objForm;if (!this._bSearchGridInit) {var oDs = this.parent.getViewDataset();if (oDs) {oDs.addEventHandler("onload", this.fn_ds_onchanged, this);oDs.addEventHandler("onrowsetchanged", this.fn_ds_onchanged, this);}if (this.fvConf.headSort && this.grdList) {this.grdList.addEventHandler("onheadclick", this.fn_grid_onheadclick, this);}if (this.fvConf.headSort && this.grdList) {var sDef = this.fvConf.defaultSort;var nDefCell = -1;var sColDef = "";if (sDef) {sColDef = sDef.replace(/^[+-]/, "");for (var j = 0; j < this.grdList.getCellCount("body"); j++) {if (this.grdList.getCellProperty("body", j, "text") == "bind:" + sColDef) {nDefCell = j;break;}}}this.fn_applySort(this.grdList, nDefCell, nDefCell < 0 ? "" : sColDef, sDef.charAt(0) != "+", true);}this._bSearchGridInit = true;}this.fn_updateCount();};this.fn_ds_onchanged = function(obj, e) {this.fn_updateCount();};this.fn_updateCount = function() {if (!this.sta_title) {return;}var c = this.fvConf;var sText = "<b v='true'>" + c.titleText + "</b>";var oDs = this.parent.getViewDataset();if (c.showCount && oDs) {var nShow = oDs.getRowCount();var nAll = oDs.getRowCountNF();var sCount = (nShow == nAll) ? (nAll + "건") : (nShow + " / " + nAll + "건");sText += "   <fc v='" + c.mutedColor + "'>" + sCount + "</fc>";}this.sta_title.set_text(sText);};this.fn_grid_onheadclick = function(obj, e) {var sBind = "" + obj.getCellProperty("body", e.cell, "text");if (sBind.indexOf("bind:") != 0) {return;}var sCol = sBind.substr(5);var bDesc = !(this._sSortCol == sCol && this._bSortDesc);this.fn_applySort(obj, e.cell, sCol, bDesc);var oDs = obj.getBindDataset();if (this.fvConf.selectFirst && oDs.getRowCount() > 0) {oDs.set_rowposition(-1);oDs.set_rowposition(0);}this.fn_applySort(obj, e.cell, sCol, bDesc, false);};this.fn_applySort = function(oGrid, nCell, sCol, bDesc, bHint) {var i;if (!this._arrHeadText) {this._arrHeadText = [];for (i = 0; i < oGrid.getCellCount("head"); i++) {this._arrHeadText[i] = oGrid.getCellProperty("head", i, "text");}}if (sCol) {this._sSortCol = sCol;this._bSortDesc = bDesc;oGrid.getBindDataset().set_keystring("S:" + (bDesc ? "-" : "+") + sCol);}for (i = 0; i < this._arrHeadText.length; i++) {var sMark = "";if (i == nCell) {sMark = bDesc ? " ▼" : " ▲";} else if (bHint && ("" + oGrid.getCellProperty("body", i, "text")).indexOf("bind:") == 0) {sMark = " ⇅";}oGrid.setCellProperty("head", i, "text", this._arrHeadText[i] + sMark);}};]]>
          </Script>
        </View>
        <View id="Detail" left="10" top="Chart:10" text="Detail" right="10" bottom="10" viewtype="Grid" viewdataset="_dstops_dashboard_statSelect_ds_remain">
          <Layouts>
            <Layout>
              <Grid id="grdList" left="0" top="0" right="0" bottom="0" binddataset="_dstops_dashboard_statSelect_ds_remain" autofittype="col" cssclass="grd_WF_Detail" _fieldid="grdList" _fieldcomptype="comp">
                <Formats>
