      <ViewInfo viewid="Detail">
        <ModelInfo modelserviceid="tops" serviceid="dashboard/statSelect" modelid="ds_requester" datasetid="_dstops_dashboard_statSelect_ds_requester" filepath="dashboard\.model\statSelect.model">
          <Fields>
            <Field id="req_name"/>
