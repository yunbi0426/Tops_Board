                      <Cell id="cell_body_2_0_status" row="0" col="2" text="expr:&quot;&lt;fc v=&apos;&quot; + (String(status).indexOf(&apos;완료&apos;)&gt;=0 ? &apos;#16A34A&apos; : String(status).indexOf(&apos;반려&apos;)&gt;=0 ? &apos;#DC2626&apos; : String(status).indexOf(&apos;대기&apos;)&gt;=0 ? &apos;#A1A1AA&apos; : &apos;#2563EB&apos;) + &quot;&apos;&gt;●&lt;/fc&gt; &quot; + status" displaytype="decoratetext" edittype="none"/>
