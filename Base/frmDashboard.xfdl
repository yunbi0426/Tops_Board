<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="frmDashboard" width="1050" height="736" titletext="New Form">
    <Layouts>
      <Layout width="1050" height="736">
        <View id="Summary" left="10" top="10" height="110" text="Summary" right="10" viewdataset="_dstops_dashboard_statSelect_ds_requester">
          <Layouts>
            <Layout>
              <Static id="staFrame" left="10" top="10" right="10" bottom="10" text="" border="1px solid #E0DED6" borderRadius="12px" background="#FFFFFF"/>
              <Static id="staCard_req_name" left="22" top="22" bottom="22" text="req_name" background="#F1EFE8" borderRadius="8px" color="#444441" padding="0px 14px" verticalAlign="middle" usedecorate="true" font="normal 500 22px/normal &quot;Malgun Gothic&quot;" _fieldid="req_name" _fieldcomptype="comp" width="23%"/>
              <Static id="staCard_total_cnt" left="staCard_req_name:8" top="22" bottom="22" text="total_cnt" background="#EAF3DE" borderRadius="8px" color="#27500A" padding="0px 14px" verticalAlign="middle" usedecorate="true" font="normal 500 22px/normal &quot;Malgun Gothic&quot;" _fieldid="total_cnt" _fieldcomptype="comp" width="23%"/>
              <Static id="staCard_done_cnt" left="staCard_total_cnt:8" top="22" bottom="22" text="done_cnt" background="#FAEEDA" borderRadius="8px" color="#633806" padding="0px 14px" verticalAlign="middle" usedecorate="true" font="normal 500 22px/normal &quot;Malgun Gothic&quot;" _fieldid="done_cnt" _fieldcomptype="comp" width="23%"/>
              <Static id="staCard_remain_cnt" left="staCard_done_cnt:8" top="22" bottom="22" text="remain_cnt" background="#E6F1FB" borderRadius="8px" color="#0C447C" padding="0px 14px" verticalAlign="middle" usedecorate="true" font="normal 500 22px/normal &quot;Malgun Gothic&quot;" _fieldid="remain_cnt" _fieldcomptype="comp" right="22"/>
            </Layout>
          </Layouts>
          <Script><![CDATA[
	this.fvHeaderFormat = "";
	this.fvEmptyText = "데이터가 없습니다";
	this.fvValueSuffix = [];
	this.fvCardFields = ["req_name","total_cnt","done_cnt","remain_cnt"];
	this.fvCardLabels = ["req_name","total_cnt","done_cnt","remain_cnt"];
	this.fvLabelColors = ["#5F5E5A","#3B6D11","#854F0B","#185FA5"];
	this.fvSmallPt = 9;

	this._fnViewOnLoad = function(objForm) {
	    /* Sets the view form reference so that functions declared in the view can access it */
	    this._ownerForm = objForm;

	    var oDs = this.parent.getViewDataset();
	    if (oDs && !this._bSummaryInit) {
	        /* 조회 완료(onload) / 값 변경(oncolumnchanged) / 행 이동(onrowposchanged) 때 갱신. 재호출 시 중복 등록 방지 */
	        oDs.addEventHandler("onload", this.fn_ds_onchanged, this);
	        oDs.addEventHandler("oncolumnchanged", this.fn_ds_onchanged, this);
	        oDs.addEventHandler("onrowposchanged", this.fn_ds_onchanged, this);
	        this._bSummaryInit = true;
	    }

	    this.fn_refresh();
	};

	this.fn_ds_onchanged = function(obj, e) {
	    this.fn_refresh();
	};

	this.fn_refresh = function() {
	    var oDs   = this.parent.getViewDataset();
	    var bData = oDs && oDs.getRowCount() > 0 && oDs.rowposition >= 0;
	    var nRow  = bData ? oDs.rowposition : -1;
	    var oThis = this;

	    // 제목 줄
	    if (this.staHeader && this.fvHeaderFormat) {
	        if (!bData) {
	            this.staHeader.set_text(this.fvEmptyText);
	        } else {
	            var sText = ("" + this.fvHeaderFormat).replace(/\{([A-Za-z0-9_]+)\}/g, function(sAll, sCol) {
	                return oThis.fn_formatValue(oDs.getColumn(nRow, sCol));
	            });
	            this.staHeader.set_text(sText);
	        }
	    }

	    // 카드 : 1줄 라벨(작게, 라벨색) + 2줄 값(천 단위 쉼표) + 작은 단위
	    var sSmall = "<fs v='" + this.fvSmallPt + "'>";
	    for (var i = 0; i < this.fvCardFields.length; i++) {
	        var sCol  = this.fvCardFields[i];
	        var oCard = this["staCard_" + sCol];
	        if (!oCard) {
	            continue;
	        }

	        var sColor = this.fvLabelColors.length > 0 ? this.fvLabelColors[i % this.fvLabelColors.length] : "#5F5E5A";
	        var sLabel = "<fc v='" + sColor + "'>" + sSmall + this.fvCardLabels[i] + "</fs></fc>";

	        var sValue = "-";
	        if (bData) {
	            var v = oDs.getColumn(nRow, sCol);
	            if (v !== undefined && v !== null && v !== "") {
	                var sSuffix = this.fvValueSuffix.length > 0 ? this.fvValueSuffix[i % this.fvValueSuffix.length] : "";
	                sValue = this.fn_formatNumber(v) + (sSuffix ? sSmall + " " + sSuffix + "</fs>" : "");
	            }
	        }

	        oCard.set_text(sLabel + "\n" + sValue);
	    }
	};

	this.fn_formatValue = function(v) {
	    if (v === undefined || v === null) {
	        return "";
	    }
	    if (v.getFullYear) {
	        var p = function(n) { return n < 10 ? "0" + n : "" + n; };
	        var sDate = v.getFullYear() + "-" + p(v.getMonth() + 1) + "-" + p(v.getDate());
	        if (v.getHours() == 0 && v.getMinutes() == 0) {
	            return sDate;
	        }
	        return sDate + " " + p(v.getHours()) + ":" + p(v.getMinutes());
	    }
	    return "" + v;
	};

	this.fn_formatNumber = function(v) {
	    var s = "" + v;
	    if (!/^-?\d+(\.\d+)?$/.test(s)) {
	        return this.fn_formatValue(v);
	    }
	    var arr = s.split(".");
	    arr[0] = arr[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
	    return arr.join(".");
	};
]]>
          </Script>
        </View>
        <View id="Chart" left="10" top="Summary:10" width="40%" height="50%" text="Chart" viewtype="Chart" viewdataset="_dstops_dashboard_statSelect_ds_requester">
          <Layouts>
            <Layout>
              <Static id="staFrame" left="10" top="10" right="10" bottom="10" text="" border="1px solid #E0DED6" borderRadius="12px" background="#FFFFFF"/>
              <Spin id="spnTopN" top="22" right="22" width="64" height="26" min="1" max="15" value="5" increment="1"/>
              <Static id="staTopN" top="22" right="spnTopN:4" width="40" height="26" text="상위" textAlign="right" color="#888780" font="normal 12px/normal &quot;Malgun Gothic&quot;"/>
              <Static id="staTitle" left="22" top="22" right="staTopN:8" height="26" text="" color="#444441" font="normal 500 13px/normal &quot;Malgun Gothic&quot;"/>
              <Div id="divBars" left="22" top="56" right="22" bottom="22" text="" border="0px none" background="transparent">
                <Layouts>
                  <Layout/>
                </Layouts>
              </Div>
              <Static id="staEmpty" left="22" top="56" right="22" bottom="22" text="데이터가 없습니다" textAlign="center" color="#888780" font="normal 12px/normal &quot;Malgun Gothic&quot;" visible="false"/>
            </Layout>
          </Layouts>
          <Script><![CDATA[
	this.fvConf = {"labelField":"","valueField":"","etcField":"","etcValue":"Y","barColor":"#534AB7","etcColor":"#B4B2A9","trackColor":"#F1EFE8","labelWidth":140,"rowHeight":26,"barHeight":10,"valueWidth":56,"scrollW":14,"textFont":"normal 12px/normal \"Malgun Gothic\"","textColor":"#444441","mutedColor":"#888780"};

	this._fnViewOnLoad = function(objForm) {
			/* Sets the view form reference so that functions declared in the view can access it */
			this._ownerForm = objForm;

			if (!this._bRankInit) {
				/* 조회 완료 / 값 변경 / 필터 때 다시 그림, 크기 변경 때 다시 배치. 중복 등록 방지 */
				var oDs = this.parent.getViewDataset();
				if (oDs) {
					oDs.addEventHandler("onload", this.fn_ds_onchanged, this);
					oDs.addEventHandler("oncolumnchanged", this.fn_ds_onchanged, this);
					oDs.addEventHandler("onrowsetchanged", this.fn_ds_onchanged, this);
				}
				this.addEventHandler("onsize", this.fn_onsize, this);
				this.arrBarComps = [];
				this._bRankInit = true;
			}

			this.fn_render();
		};

	this.fn_ds_onchanged = function(obj, e) {
			this.fn_render();
		};

	this.fn_onsize = function(obj, e) {
			/* 너비가 실제로 바뀐 경우에만 다시 그림 */
			if (this.divBars && this.divBars.getOffsetWidth() != this._nLastWidth) {
				this.fn_render();
			}
		};

	this.fn_clearBars = function() {
			var oForm = this.divBars.form;
			var arr = this.arrBarComps || [];
			for (var i = 0; i < arr.length; i++) {
				var oComp = oForm.removeChild(arr[i]);
				if (oComp) {
					oComp.destroy();
				}
			}
			this.arrBarComps = [];
		};

	this.fn_addStatic = function(sId, nLeft, nTop, nWidth, nHeight, oProps) {
			var oForm = this.divBars.form;
			var oSta = new Static(sId, nLeft, nTop, nWidth, nHeight, null, null, null, null, null, null, oForm);
			for (var sKey in oProps) {
				var fnSet = oSta["set_" + sKey];
				if (typeof fnSet == "function") {
					fnSet.call(oSta, oProps[sKey]);
				}
			}
			oForm.addChild(sId, oSta);
			oSta.show();
			this.arrBarComps.push(sId);
			return oSta;
		};

	this.fn_render = function() {
			var c     = this.fvConf;
			var oDs   = this.parent.getViewDataset();
			var nRows = (oDs && c.labelField && c.valueField) ? oDs.getRowCount() : 0;
			var i;

			this.fn_clearBars();
			this.staEmpty.set_visible(nRows < 1);
			if (nRows < 1) {
				this.divBars.form.resetScroll();
				return;
			}

			/* 행 높이 합이 영역보다 크면 스크롤바 자리만큼 오른쪽을 비움 */
			var nAreaW  = this.divBars.getOffsetWidth();
			var nAreaH  = this.divBars.getOffsetHeight();
			var nRight  = (nRows * c.rowHeight > nAreaH) ? c.scrollW : 0;
			var nTrackL = c.labelWidth + 8;
			var nTrackW = Math.max(nAreaW - nTrackL - c.valueWidth - 8 - nRight, 20);
			var nValueL = nTrackL + nTrackW + 8;
			var nBarTop = Math.floor((c.rowHeight - c.barHeight) / 2);
			this._nLastWidth = nAreaW;

			/* 막대 길이 기준 : 기타가 아닌 행의 최댓값 (전부 기타면 전체 최댓값) */
			var nMax = 0, nMaxAll = 0;
			for (i = 0; i < nRows; i++) {
				var nV = parseFloat(oDs.getColumn(i, c.valueField)) || 0;
				var bE = c.etcField && ("" + oDs.getColumn(i, c.etcField)) == c.etcValue;
				nMaxAll = Math.max(nMaxAll, nV);
				if (!bE) {
					nMax = Math.max(nMax, nV);
				}
			}
			if (nMax <= 0) {
				nMax = nMaxAll > 0 ? nMaxAll : 1;
			}

			for (i = 0; i < nRows; i++) {
				var sLabel = oDs.getColumn(i, c.labelField);
				var nValue = parseFloat(oDs.getColumn(i, c.valueField)) || 0;
				var bEtc   = c.etcField && ("" + oDs.getColumn(i, c.etcField)) == c.etcValue;
				var nTop   = i * c.rowHeight;
				var nFillW = nValue > 0 ? Math.max(Math.round(nTrackW * Math.min(nValue / nMax, 1)), 2) : 0;
				var sColor = bEtc ? c.mutedColor : c.textColor;

				this.fn_addStatic("staBarLabel_" + i, 0, nTop, c.labelWidth, c.rowHeight, {
					text: sLabel == null ? "" : "" + sLabel, color: sColor, font: c.textFont, tooltiptext: sLabel == null ? "" : "" + sLabel
				});
				this.fn_addStatic("staBarTrack_" + i, nTrackL, nTop + nBarTop, nTrackW, c.barHeight, {
					text: "", background: c.trackColor, borderRadius: "4px"
				});
				if (nFillW > 0) {
					this.fn_addStatic("staBarFill_" + i, nTrackL, nTop + nBarTop, nFillW, c.barHeight, {
						text: "", background: bEtc ? c.etcColor : c.barColor, borderRadius: "4px"
					});
				}
				this.fn_addStatic("staBarValue_" + i, nValueL, nTop, c.valueWidth, c.rowHeight, {
					text: this.fn_formatNumber(nValue), color: sColor, font: c.textFont, textAlign: "right"
				});
			}

			this.divBars.form.resetScroll();
		};

	this.fn_formatNumber = function(v) {
			var s = "" + v;
			if (!/^-?\d+(\.\d+)?$/.test(s)) {
				return s;
			}
			var arr = s.split(".");
			arr[0] = arr[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
			return arr.join(".");
		};
]]>
          </Script>
        </View>
