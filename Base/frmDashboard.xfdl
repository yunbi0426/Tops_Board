          <Column id="requester" type="string" size="200" description="요구처"/>
        </ColumnInfo>
        <Rows/>
      </Dataset>
      <OnLoadView id="OnLoadView00" alias="OnLoadView"/>
      <Transaction id="Transaction00" alias="Dashboard 데이터 가져오기" servicemodel="tops::dashboard/statSelect" serviceurl="NexaLAPServer::api/v1/execute">
        <Contents><![CDATA[{
    "outputdatasets": [
        {
            "modelid": "ds_requester",
            "datasetid": "_dstops_dashboard_statSelect_ds_requester"
        },
        {
            "modelid": "ds_remain",
            "datasetid": "_dstops_dashboard_statSelect_ds_remain"
        },
        {
            "modelid": "ds_summary",
            "datasetid": "_dstops_dashboard_statSelect_ds_summary"
        },
        {
            "modelid": "ds_rank",
            "datasetid": "_dstops_dashboard_statSelect_ds_rank"
        }
    ]
}]]>
        </Contents>
      </Transaction>
      <MasterRowFilter id="MasterRowFilter00" alias="잔여 목록 필터" master="_dstops_dashboard_statSelect_ds_requester.req_name" target="_dstops_dashboard_statSelect_ds_remain.req_name"/>
      <Dataset id="_dstops_dashboard_statSelect_ds_option">
        <ColumnInfo>
          <Column id="top_n" type="INT" size="100" description="top_n"/>
        </ColumnInfo>
        <Rows>
          <Row/>
        </Rows>
      </Dataset>
      <RunScript id="RunScript00" alias="잔여 상위 요구처 상위 Spin 변경">
        <Contents><![CDATA[`var oAction = this._current_action;      // 이 RunScript Action 자신

var fnApply = function(obj, e) {
    var v = (e && e.postvalue != null) ? e.postvalue : obj.value;
    if (v == this._nLastTopN) {
        return;
    }
    this._nLastTopN = v;

    var ds = this._dstops_dashboard_statSelect_ds_option;
    if (ds.rowcount == 0) {
        ds.addRow();
    }
    ds.setColumn(0, "top_n", v);

    oAction.on_fire_onsuccess();         // ← Transaction01을 직접 부르지 않고 Success만 발생
};

var oSpin = this.Chart.form.spnTopN;
oSpin.addEventHandler("onspin", fnApply, this);
oSpin.addEventHandler("onchanged", fnApply, this);
this._nLastTopN = oSpin.value;

return false;   // 등록할 때는 Success를 안 내보냄 (화면 열 때 중복 조회 방지)`]]>
        </Contents>
      </RunScript>
      <Transaction id="Transaction01" alias="상위 N 요구처 조회" servicemodel="tops::dashboard/statSelect" serviceurl="NexaLAPServer::api/v1/execute">
        <Contents><![CDATA[{
    "inputdatasets": [
        {
            "modelid": "ds_option",
            "datasetid": "_dstops_dashboard_statSelect_ds_option"
        }
    ],
    "outputdatasets": [
        {
            "modelid": "ds_rank",
            "datasetid": "_dstops_dashboard_statSelect_ds_rank"
        }
    ]
}]]>
        </Contents>
      </Transaction>
      <InputFilter id="InputFilter00" alias="요구처 필터링" targetview="Main" sourcecomp="edt_filterSearch" searchcolumns="_dstops_dashboard_statSelect_ds_requester.req_name"/>
      <Dataset id="_dstops_dashboard_statSelect_ds_rank">
        <ColumnInfo>
          <Column id="req_name" type="string" size="200" description="req_name"/>
          <Column id="remain_cnt" type="float" size="43" description="remain_cnt"/>
          <Column id="etc_yn" type="string" size="1" description="etc_yn"/>
          <Column id="rn" type="bigdecimal" size="21" description="rn"/>
        </ColumnInfo>
        <Rows/>
      </Dataset>
      <Dataset id="_dstops_dashboard_statSelect_ds_summary">
        <ColumnInfo>
          <Column id="total_cnt" type="float" size="24" description="total_cnt"/>
          <Column id="done_cnt" type="float" size="24" description="done_cnt"/>
          <Column id="remain_cnt" type="float" size="24" description="remain_cnt"/>
          <Column id="done_rate" type="float" size="28" description="done_rate"/>
          <Column id="exclude_cnt" type="float" size="24" description="exclude_cnt"/>
        </ColumnInfo>
        <Rows/>
      </Dataset>
