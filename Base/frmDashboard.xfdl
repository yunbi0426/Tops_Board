            "datasetid": "_dstops_dashboard_statSelect_ds_option"
        }
    ],
    "outputdatasets": [
        {
            "modelid": "ds_rank",
            "datasetid": "_dstops_dashboard_statSelect_ds_rank"
        }
    ]
}]]>
        </Contents>
      </Transaction>
