          <Script><![CDATA[this.fvConf = {"titleText":"","showCount":true,"headSort":true,"selectFirst":true,"mutedColor":"#A1A1AA","defaultSort":""};this._fnViewOnLoad = function(objForm) {/* Sets the view form reference so that functions declared in the view can access it */this._ownerForm = objForm;if (!this._bSearchGridInit) {let oDs = this.parent.getViewDataset();if (oDs) {oDs.addEventHandler("onload", this.fn_ds_onchanged, this);oDs.addEventHandler("onrowsetchanged", this.fn_ds_onchanged, this);}if (this.fvConf.headSort && this.grdList) {this.grdList.addEventHandler("onheadclick", this.fn_grid_onheadclick, this);}if (this.fvConf.headSort && this.grdList) {let sDef = this.fvConf.defaultSort;let nDefCell = -1;let sColDef = "";if (sDef) {sColDef = sDef.replace(/^[+-]/, "");for (let j = 0; j < this.grdList.getCellCount("body"); j++) {if (this.fn_getSortCol(this.grdList, j) == sColDef) {nDefCell = j;break;}}}this.fn_applySort(this.grdList, nDefCell, nDefCell < 0 ? "" : sColDef, sDef.charAt(0) != "+", true);}this._bSearchGridInit = true;}this.fn_updateCount();};this.fn_ds_onchanged = function(obj, e) {this.fn_updateCount();};this.fn_updateCount = function() {if (!this.sta_title) {return;}let c = this.fvConf;let sText = "<b v='true'>" + c.titleText + "</b>";let oDs = this.parent.getViewDataset();if (c.showCount && oDs) {let nShow = oDs.getRowCount();let nAll = oDs.getRowCountNF();let sCount = (nShow == nAll) ? (nAll + "건") : (nShow + " / " + nAll + "건");sText += "   <fc v='" + c.mutedColor + "'>" + sCount + "</fc>";}this.sta_title.set_text(sText);};this.fn_grid_onheadclick = function(obj, e) {let sCol = this.fn_getSortCol(obj, e.cell);if (!sCol) { return;}let bDesc = !(this._sSortCol == sCol && this._bSortDesc);this.fn_applySort(obj, e.cell, sCol, bDesc);let oDs = obj.getBindDataset();if (this.fvConf.selectFirst && oDs.getRowCount() > 0) {oDs.set_rowposition(-1);oDs.set_rowposition(0);}this.fn_applySort(obj, e.cell, sCol, bDesc, false);};this.fn_applySort = function(oGrid, nCell, sCol, bDesc, bHint) {let i;if (!this._arrHeadText) {this._arrHeadText = [];for (i = 0; i < oGrid.getCellCount("head"); i++) {this._arrHeadText[i] = oGrid.getCellProperty("head", i, "text");}}if (sCol) {this._sSortCol = sCol;this._bSortDesc = bDesc;oGrid.getBindDataset().set_keystring("S:" + (bDesc ? "-" : "+") + sCol);}for (i = 0; i < this._arrHeadText.length; i++) {let sMark = "";if (i == nCell) {sMark = bDesc ? " ▼" : " ▲";} else if (bHint && this.fn_getSortCol(oGrid, i) != "") {sMark = " ⇅";}oGrid.setCellProperty("head", i, "text", this._arrHeadText[i] + sMark);}};this.fn_getSortCol = function(oGrid, nCell) {let sText = "" + oGrid.getCellProperty("body", nCell, "text");if (sText.indexOf("bind:") == 0) {return sText.substr(5);}if (sText.indexOf("expr:") == 0) {let arr = /^expr:\s*([A-Za-z_][A-Za-z0-9_]*)/.exec(sText);let oDs = oGrid.getBindDataset();if (arr && oDs && oDs.getColIndex(arr[1]) >= 0) {return arr[1];}}return "";};]]>
          </Script>
        </View>
