              <Static id="sta_title" left="16" top="16" height="30" right="edt_filterSearch:8" text="요구처 시트" font="normal 700 13px/normal &quot;NotoSansKR-Bold&quot;" color="#18181B" usedecorate="true" _fieldid="TITLE" _fieldcomptype="label"/>
