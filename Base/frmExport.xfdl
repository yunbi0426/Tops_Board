oGrid, nCell, sCol, bDesc, bHint) {let i;if (!this._arrHeadText) {this._arrHeadText = [];for (i = 0; i < oGrid.getCellCount("head"); i++) {this._arrHeadText[i] = oGrid.getCellProperty("head", i, "text");}}if (sCol) {this._sSortCol = sCol;this._bSortDesc = bDesc;oGrid.getBindDataset().set_keystring("S:" + (bDesc ? "-" : "+") + sCol);}for (i = 0; i < this._arrHeadText.length; i++) {let sMark = "";if (i == nCell) {sMark = bDesc ? " ▼" : " ▲";} else if (bHint && this.fn_getSortCol(oGrid, i) != "") {sMark = " ⇅";}oGrid.setCellProperty("head", i, "text", this._arrHeadText[i] + sMark);}};this.fn_getSortCol = function(oGrid, nCell) {let sText = "" + oGrid.getCellProperty("body", nCell, "text");if (sText.indexOf("bind:") == 0) {return sText.substr(5);}if (sText.indexOf("expr:") == 0) {let arr = /^expr:\s*([A-Za-z_][A-Za-z0-9_]*)/.exec(sText);let oDs = oGrid.getBindDataset();if (arr && oDs && oDs.getColIndex(arr[1]) >= 0) {return arr[1];}}return "";};]]>
