          <Script><![CDATA[this.fvConf = {"keys":[["rp","RP"],["rc","RC"]],"badgeCol":"status","toneCol":"dev_result","titleCol":"title","infoCols":["req_type","req_name","product_module","reg_date","reg_user","developer","worker","work_patch","deploy_patch","inspector","last_work_date","inspect_date"],"groups":[["txt_reg"],["txt_receipt"],["txt_analysis"],["txt_design"],["txt_impl","txt_impl_detail"],["txt_inspect"]],"defaultTab":"first","toneMap":{},"tones":{"neutral":["#F1EFE8","#5F5E5A"],"info":["#E6F1FB","#0C447C"],"success":["#EAF3DE","#27500A"],"warning":["#FAEEDA","#854F0B"],"danger":["#FCEBEB","#A32D2D"]},"bodyTop":12,"subHeight":18,"inset":0};this._fnViewOnLoad = function(objForm) {this._ownerForm = objForm;if (!this._bDetailInit) {var oDs = this.parent.getViewDataset();if (oDs) {oDs.addEventHandler("onload", this.fn_detail_ondatachange, this);oDs.addEventHandler("onrowposchanged", this.fn_detail_ondatachange, this);oDs.addEventHandler("oncolumnchanged", this.fn_detail_ondatachange, this);}this._bDetailInit = true;}this.fn_detail_refresh();};this.fn_detail_ondatachange = function(obj, e) {this.fn_detail_refresh();};this.fn_detail_refresh = function() {var c = this.fvConf;var oDs = this.parent.getViewDataset();var nRow = oDs ? oDs.rowposition : -1;var fnVal = function(sCol) {if (!oDs || nRow < 0 || !sCol) { return ""; }var v = oDs.getColumn(nRow, sCol);if (v == null) { return ""; }if (typeof v == "object" && v.getFullYear) {var m = v.getMonth() + 1, d = v.getDate();return v.getFullYear() + "-" + (m > 9 ? "" : "0") + m + "-" + (d > 9 ? "" : "0") + d;}return String(v);};if (this.sta_key) {var arrKey = [];for (var k = 0; k < c.keys.length; k++) {var sKey = fnVal(c.keys[k][0]);if (sKey != "") { arrKey.push(c.keys[k][1] + " " + sKey); }}this.sta_key.set_text(arrKey.join("  ·  "));}if (this.sta_title) { this.sta_title.set_text(fnVal(c.titleCol)); this.resetScroll(); }if (this.sta_badge) {var sBadge = fnVal(c.badgeCol);var arrTone = c.toneMap[fnVal(c.toneCol)];var oTone = (arrTone && c.tones[arrTone[0]]) ? c.tones[arrTone[0]] : c.tones.neutral;if (sBadge != "" && arrTone && arrTone[1]) { sBadge += "  ·  " + arrTone[1]; }this.sta_badge.set_text(sBadge);this.sta_badge.set_visible(sBadge != "");this.sta_badge.set_background(oTone[0]);this.sta_badge.set_color(oTone[1]);}for (var i = 0; i < c.infoCols.length; i++) {var oValue = this["sta_infoValue" + i];if (oValue) {var sInfo = fnVal(c.infoCols[i]);oValue.set_text(sInfo == "" ? "-" : sInfo);oValue.set_tooltiptext(sInfo);}}var oTab = this.tabBody;if (!oTab) { return; }var nFirst = -1, nLast = -1;for (var g = 0; g < c.groups.length; g++) {var oPage = oTab["tp" + g];if (!oPage) { continue; }var arrCols = c.groups[g];var arrHas = [];var nHas = 0;for (var f = 0; f < arrCols.length; f++) {arrHas[f] = fnVal(arrCols[f]).replace(/\s/g, "") != "";if (arrHas[f]) { nHas++; }}var nShow = nHas > 0 ? nHas : 1;var nIdx = 0;for (var f2 = 0; f2 < arrCols.length; f2++) {var oSub = oPage.form["staSub" + g + "_" + f2];var oText = oPage.form["txtBody" + g + "_" + f2];var bShow = arrHas[f2] || (nHas == 0 && f2 == 0);if (oText) { oText.set_visible(bShow); }if (oSub) { oSub.set_visible(bShow && nShow > 1); }if (!bShow || !oText) { continue; }if (nShow == 1) {oText.move(c.inset, c.bodyTop, null, null, 0, 0);} else {var nTopPct = Math.round(nIdx * 100 / nShow);var nBottomPct = Math.round((nShow - 1 - nIdx) * 100 / nShow);if (oSub) { oSub.move(c.inset, nIdx == 0 ? c.bodyTop : nTopPct + "%", null, nIdx == 0 ? c.subHeight : c.subHeight + 10, 0, null); }oText.move(c.inset, oSub ? oSub.id + ":4" : nTopPct + "%", null, null, 0, nBottomPct > 0 ? nBottomPct + "%" : 0);}nIdx++;}oPage.set_enable(nHas > 0);if (nHas > 0) { if (nFirst < 0) { nFirst = g; } nLast = g; }}if (nFirst < 0) {if (oTab.tp0) { oTab.tp0.set_enable(true); }oTab.set_tabindex(0);return;}oTab.set_tabindex(c.defaultTab == "first" ? nFirst : nLast);};]]>
          </Script>
        </View>
