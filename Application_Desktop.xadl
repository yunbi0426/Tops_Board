<?xml version="1.0" encoding="utf-8"?>
<ADL version="2.0">
  <Application id="Tops_Board" screenid="Desktop_screen" licenseurl="./license/NexaLAP_client_license.xml">
    <Layout>
      <MainFrame id="mainframe" showtitlebar="false" showstatusbar="false" titletext="TOPS Board" left="0" top="0" width="1280" height="720">
        <VFrameSet id="vfrs" separatesize="50,*">
          <Frames>
            <ChildFrame id="frmTop" showtitlebar="false" showstatusbar="false" formurl="NexaFrame::frmTop.xfdl"/>
            <ChildFrame id="frmWork" showtitlebar="false" showstatusbar="false" formurl="NexaFrame::frmWork.xfdl"/>
          </Frames>
        </VFrameSet>
      </MainFrame>
    </Layout>
    <Style url="xcssrc::Tops_Board_Asset_TopsBoard.xcss"/>
  </Application>
  <Script type="xscript5.1"><![CDATA[let objEnv = nexacro.getEnvironment();

// Top 템플릿이라 Left 메뉴는 없음 → 빈 함수
objEnv.fnSetLeftMenu = function (sMenuId) {};

// gdsMenu의 MENU_URL을 frmWork의 div_work에 연다
objEnv.fnOpenForm = function (sMenuId, bPopup) {
    let app = nexacro.getApplication();
    let ds = app.gdsMenu;
    let nRow = ds.findRow("MENU_ID", sMenuId);
    if (nRow < 0) {
        return;
    }

    let url = ds.getColumn(nRow, "MENU_URL");
    let compDivWork = app.mainframe.vfrs.frmWork.form.div_work;
    if (url && compDivWork) {
        compDivWork.set_url(url);
        objEnv.fnSetPageTitle(url);
    };
};

// frmWork 제목 줄(staPageTitle)을 gdsMenu의 PAGE_TITLE / PAGE_DESC로 갱신
objEnv.fnSetPageTitle = function (sUrl) {
    objEnv.fvCurrentUrl = sUrl;
    objEnv.fnHighlightMenu(sUrl);

    let app = nexacro.getApplication();
    let oWorkForm = app.mainframe.vfrs.frmWork.form;
    let oTitle = oWorkForm ? oWorkForm.staPageTitle : null;
    if (!oTitle) {
        return;
    }

    let ds = app.gdsMenu;
    let nRow = ds.findRow("MENU_URL", sUrl);
    if (nRow < 0) {
        oTitle.set_text("");
        return;
    }

    let sTitle = ds.getColumn(nRow, "PAGE_TITLE") || ds.getColumn(nRow, "MENU_NM") || "";
    let sDesc  = ds.getColumn(nRow, "PAGE_DESC") || "";

    let sText = "<b v='true'><fs v='16'>" + sTitle + "</fs></b>";
    if (sDesc) {
        sText += "   <fc v='#6B7280'>" + sDesc + "</fc>";
    }
    oTitle.set_text(sText);
};

// 열린 화면 URL과 같은 메뉴만 강조 (btn_TF_MenuS), 나머지는 기본 (btn_TF_Menu)
objEnv.fnHighlightMenu = function (sUrl) {
    let app = nexacro.getApplication();
    let oTop = app.mainframe.vfrs.frmTop.form;
    if(!oTop || !oTop.divTopMenu) {
        return;
    }

    let ds = app.gdsMenu;
    let nRow = ds.findRow("MENU_URL", sUrl);
    let sMenuId = nRow < 0 ? "" : ds.getColumn(nRow, "MENU_ID");
    let arrComp = oTop.divTopMenu.form.components;
    for(let i = 0; i < arrComp.length; i++) {
        let oBtn = arrComp[i];
        if(oBtn.menuid === undefined) {
            continue;
        }
        oBtn.set_cssclass(oBtn.menuid === sMenuId ? "btn_TF_MenuS" : "btn_TF_Menu");
    }
}
]]>
  </Script>
</ADL>