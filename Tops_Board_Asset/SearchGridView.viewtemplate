	"sectionComments": {
		"viewProperties": "View generation options (set_viewProperties)"
	},
	"functionsCode": "\n/************************************************************************************************\n * Functions Related to the main() Execution Flow\n ************************************************************************************************/\n\t// View property value (없으면 기본값)\n\tthis.fn_GetProp = function(sId, vDefault) {\n\t\tlet oAttr = (this.oViewProperties && this.oViewProperties.attributes) ? this.oViewProperties.attributes : null;\n\t\tif (oAttr && oAttr[sId] !== undefined && oAttr[sId] !== null && oAttr[sId] !== \"\") {\n\t\t\treturn oAttr[sId];\n\t\t}\n\t\treturn vDefault;\n\t};\n\n\tthis.fn_GetBoolProp = function(sId, vDefault) {\n\t\treturn (\"\" + this.fn_GetProp(sId, vDefault)).toLowerCase() == \"true\";\n\t};\n\n\t// Model 에 컴포넌트 하나 추가\n\tthis.fn_AddComp = function(sFieldId, sTag, oAttr) {\n\t\tthis.oContents.View.Model.push({ \"fieldid\": sFieldId, \"Components\": [{ \"tag\": sTag, \"attribute\": oAttr }] });\n\t};\n\n\tthis.fn_GetModel = function() {\n\t\tlet nPad    = this.VIEW_PADDING;\n\t\tlet nInner  = nPad + this.FRAME_PADDING;\n\t\tlet sTitle  = this.fn_GetProp(\"titletext\", this.TITLE_TEXT);\n\t\tlet bSearch = this.fn_GetBoolProp(\"usesearch\", this.USE_SEARCH);\n\t\tlet bHeader = (sTitle != \"\") || bSearch;\n\n\t\t//---------------- 카드 배경 (가장 먼저 = 맨 뒤에 깔림) ----------------\n\t\tthis.fn_AddComp(\"FRAME\", \"Static\", {\n\t\t\t\"id\": this.ID_FRAME, \"left\": nPad, \"top\": nPad, \"right\": nPad, \"bottom\": nPad,\n\t\t\t\"text\": \"\", \"border\": this.FRAME_BORDER, \"borderRadius\": this.FRAME_RADIUS, \"background\": \"#FFFFFF\",\n\t\t\t\"_fieldid\": \"FRAME\", \"_fieldcomptype\": \"label\"\n\t\t});\n\n\t\t//---------------- 제목 (+ 건수는 실행 시점에 채움) ----------------\n\t\tif (sTitle != \"\") {\n\t\t\tthis.fn_AddComp(\"TITLE\", \"Static\", {\n\t\t\t\t\"id\": this.ID_TITLE, \"left\": nInner, \"top\": nInner, \"height\": this.HEADER_HEIGHT,\n\t\t\t\t\"right\": bSearch ? this.ID_SEARCH + \":8\" : nInner,\n\t\t\t\t\"text\": sTitle, \"font\": this.TITLE_FONT, \"color\": this.TITLE_COLOR, \"usedecorate\": \"true\",\n\t\t\t\t\"_fieldid\": \"TITLE\", \"_fieldcomptype\": \"label\"\n\t\t\t});\n\t\t}\n\n\t\t//---------------- 검색칸 + 아이콘(왼쪽 안) + 지우기 버튼(오른쪽 안) ----------------\n\t\tif (bSearch) {\n\t\t\tlet nSearchW = parseInt(this.fn_GetProp(\"searchwidth\", this.SEARCH_WIDTH), 10);\n\t\t\tif (isNaN(nSearchW) || nSearchW < 60) {\n\t\t\t\tnSearchW = this.SEARCH_WIDTH;\n\t\t\t}\n\t\t\tthis.fn_AddComp(\"_filterSearch\", \"Edit\", {\n\t\t\t\t\"id\": this.ID_SEARCH, \"top\": nInner, \"right\": nInner, \"width\": nSearchW, \"height\": this.HEADER_HEIGHT,\n\t\t\t\t\"displaynulltext\": this.fn_GetProp(\"searchplaceholder\", this.SEARCH_PLACEHOLDER),\n\t\t\t\t\"padding\": \"0px \" + this.ICON_WIDTH + \"px 0px \" + this.ICON_WIDTH + \"px\",\n\t\t\t\t\"_fieldid\": \"_filterSearch\", \"_fieldcomptype\": \"comp\"\n\t\t\t});\n\t\t\t/* 아이콘 / 지우기 버튼은 검색칸보다 뒤에 추가해야 위에 그려짐 */\n\t\t\tthis.fn_AddComp(\"_searchIcon\", \"Static\", {\n\t\t\t\t\"id\": this.ID_ICON, \"left\": this.ID_SEARCH + \":-\" + nSearchW, \"top\": nInner,\n\t\t\t\t\"width\": this.ICON_WIDTH, \"height\": this.HEADER_HEIGHT, \"text\": \"\", \"background\": this.SEARCH_ICON,\n\t\t\t\t\"_fieldid\": \"_searchIcon\", \"_fieldcomptype\": \"label\"\n\t\t\t});\n\t\t\tthis.fn_AddComp(\"_searchClear\", \"Button\", {\n\t\t\t\t\"id\": this.ID_CLEAR, \"top\": nInner, \"right\": nInner, \"width\": this.ICON_WIDTH, \"height\": this.HEADER_HEIGHT,\n\t\t\t\t\"text\": \"✕\", \"tooltiptext\": \"검색어 지우기\", \"border\": \"0px none\", \"background\": \"transparent\", \"color\": this.MUTED_COLOR,\n\t\t\t\t\"_fieldid\": \"_searchClear\", \"_fieldcomptype\": \"comp\"\n\t\t\t});\n\t\t}\n\n\t\t//---------------- 그리드 ----------------\n\t\tlet oLayout;\n\t\tlet sLayout = this.fn_GetProp(\"gridlayout\", \"\");\n\t\tif (sLayout) {\n\t\t\toLayout = (typeof sLayout == \"string\") ? this.lfn_StringToJson(sLayout) : sLayout;\n\t\t} else {\n\t\t\t/* Layout 속성이 비어 있으면 필드 순서대로 새로 만들고, 그 값을 Layout 속성에 돌려줌 */\n\t\t\tthis.bNewLayout = true;\n\t\t\toLayout = this.fn_MakeLayout();\n\t\t\tthis.oViewPropertiesValue = { \"gridlayout\": JSON.parse(JSON.stringify(oLayout)) };\n\t\t}\n\n\t\tlet oGrid = {\n\t\t\t\"tag\": \"Grid\",\n\t\t\t\"attribute\": {\n\t\t\t\t\"id\": this.ID_GRID, \"left\": nInner, \"right\": nInner, \"bottom\": nInner,\n\t\t\t\t\"top\": bHeader ? nInner + this.HEADER_HEIGHT + this.HEADER_GAP : nInner,\n\t\t\t\t\"binddataset\": \"${VIEW_DATASET}\",\n\t\t\t\t\"autofittype\": this.fn_GetProp(\"autofittype\", this.AUTOFIT_TYPE),\n\t\t\t\t\"nodatatext\": this.fn_GetProp(\"nodatatext\", this.NODATA_TEXT),\n\t\t\t\t\"cssclass\": \"grd_WF_Detail\",\n\t\t\t\t\"_fieldid\": \"grdList\", \"_fieldcomptype\": \"comp\"\n\t\t\t},\n\t\t\t\"Grid\": [{ \"tag\": \"Formats\", \"attribute\": {}, \"Formats\": [this.fn_GetFormat(oLayout)] }]\n\t\t};\n\t\toGrid = this.fn_MergeField(oGrid);\n\n\t\tlet arrIds = [];\n\t\tfor (let i = 0; i < this.oFieldArray.fields.length; i++) {\n\t\t\tarrIds.push(this.oFieldArray.fields[i].id);\n\t\t}\n\t\tthis.oContents.View.Model.push({ \"fieldid\": arrIds.join(\",\"), \"Components\": [oGrid] });\n\t};\n\n\t// 함수를 한 줄 문자열로 변환 (실행 함수 안에는 // 주석 금지 : 줄바꿈이 지워지면 뒤가 주석이 됨)\n\tthis.fn_FuncString = function(sName) {\n\t\tlet s = this[sName].toString().replace(/[\\r\\n\\t]/g, \"\");\n\t\treturn \"this.\" + sName + \" = \" + s + \";\";\n\t};\n\n\tthis.fn_GetScript = function() {\n\t\tlet oConf = {\n\t\t\t\"titleText\"   : this.fn_GetProp(\"titletext\", this.TITLE_TEXT),\n\t\t\t\"showCount\"   : this.fn_GetBoolProp(\"showcount\", this.SHOW_COUNT),\n\t\t\t\"headSort\"    : this.fn_GetBoolProp(\"useheadsort\", this.USE_HEAD_SORT),\n\t\t\t\"selectFirst\" : this.fn_GetBoolProp(\"sortselectfirst\", this.SORT_SELECT_FIRST),\n\t\t\t\"mutedColor\"  : this.MUTED_COLOR,\n\t\t\t\"defaultSort\" : this.fn_GetProp(\"defaultsort\", \"\")\n\t\t};\n\n\t\tlet sValue = \"this.fvConf = \" + JSON.stringify(oConf) + \";\";\n\t\tsValue += this.fn_FuncString(\"_fnViewOnLoad\");\n\t\tsValue += this.fn_FuncString(\"fn_ds_onchanged\");\n\t\tsValue += this.fn_FuncString(\"fn_updateCount\");\n\t\tsValue += this.fn_FuncString(\"fn_grid_onheadclick\");\n\t\tsValue += this.fn_FuncString(\"fn_applySort\");\n\t\tsValue += this.fn_FuncString(\"fn_getSortCol\");\n\n\t\treturn { \"tag\": \"Script\", \"attribute\": { \"type\": \"xscript5.1\" }, \"value\": sValue };\n\t};\n\n\t/* 이전에 템플릿이 만든 컴포넌트(_fieldid 있음)는 지우고, 사용자가 추가한 컴포넌트는 Model 뒤에 붙임 */\n\tthis.fn_ClearContents = function() {\n\t\tlet oLayout = this.oContents.View.View[0].Layouts[0].Layout;\n\t\tlet oModel  = this.oContents.View.Model;\n\t\tif (!oLayout) {\n\t\t\treturn;\n\t\t}\n\t\tfor (let i = oLayout.length - 1; i >= 0; i--) {\n\t\t\tlet oComp = oLayout.splice(i, 1);\n\t\t\tif (!(oComp[0].attribute && oComp[0].attribute._fieldid)) {\n\t\t\t\toModel.push({ \"fieldid\": \"\", \"Components\": oComp });\n\t\t\t}\n\t\t}\n\t};\n\n\t/* 다시 생성할 때 사용자가 그리드에 직접 바꾼 속성(위치 제외)은 유지 */\n\tthis.fn_MergeField = function(oComp) {\n\t\tif (this.bNewLayout) {\n\t\t\treturn oComp;\n\t\t}\n\t\tlet oLayout = this.oContents.View.View[0].Layouts[0].Layout;\n\t\tif (!oLayout) {\n\t\t\treturn oComp;\n\t\t}\n\t\tlet nIdx = oLayout.findIndex(function(item) {\n\t\t\treturn item.attribute && item.attribute._fieldid === oComp.attribute._fieldid\n\t\t\t    && item.attribute._fieldcomptype === oComp.attribute._fieldcomptype;\n\t\t});\n\t\tif (nIdx < 0) {\n\t\t\treturn oComp;\n\t\t}\n\t\tlet oOrg = oLayout.splice(nIdx, 1)[0];\n\t\tif (oOrg.tag != oComp.tag) {\n\t\t\treturn oComp;\n\t\t}\n\t\tlet arrExclude = [\"top\", \"left\", \"width\", \"height\", \"right\", \"bottom\"];\n\t\tfor (let sKey in oOrg.attribute) {\n\t\t\tif (arrExclude.indexOf(sKey) < 0 && !this.lfn_IsNull(oOrg.attribute[sKey]) && this.lfn_IsNull(oComp.attribute[sKey])) {\n\t\t\t\toComp.attribute[sKey] = oOrg.attribute[sKey];\n\t\t\t}\n\t\t}\n\t\treturn oComp;\n\t};\n\n/************************************************************************************************\n * Grid Format Functions (Layout 속성 → <Format>)\n ************************************************************************************************/\n\t/* Layout 편집기 셀 속성 목록 (head / body / summary) */\n\tthis.fn_GetCellProperties = function() {\n\t\tlet fnStr  = function(id, text, desc) { return { \"id\": id, \"displaytext\": text, \"edittype\": \"String\", \"defaultvalue\": \"\", \"description\": desc }; };\n\t\tlet fnEnum = function(id, text, list, def, desc) { return { \"id\": id, \"displaytext\": text, \"edittype\": \"Enum\", \"enumlist\": list, \"defaultvalue\": def, \"description\": desc }; };\n\t\treturn {\n\t\t\t\"headproperties\": [\n\t\t\t\tfnStr(\"text\", \"Text\", \"셀 글자\"),\n\t\t\t\tfnStr(\"cssclass\", \"CSS class\", \"셀 스타일 (XCSS class)\")\n\t\t\t],\n\t\t\t\"bodyproperties\": [\n\t\t\t\tfnStr(\"text\", \"Text\", \"셀 글자\"),\n\t\t\t\tfnEnum(\"textAlign\", \"Text align\", [\"left\", \"center\", \"right\"], \"center\", \"글자 정렬\"),\n\t\t\t\t{ \"id\": \"suppress\", \"displaytext\": \"Suppress\", \"edittype\": \"Number\", \"defaultvalue\": \"\", \"description\": \"같은 값 셀 합쳐 보이기\" },\n\t\t\t\tfnEnum(\"wordWrap\", \"Word wrap\", [\"none\", \"char\", \"english\"], \"none\", \"줄바꿈\"),\n\t\t\t\tfnStr(\"tooltipText\", \"Tooltip text\", \"툴팁\"),\n\t\t\t\tfnStr(\"maskeditformat\", \"Maskedit format\", \"마스크 형식\"),\n\t\t\t\tfnStr(\"cssclass\", \"CSS class\", \"셀 스타일 (XCSS class, 식이면 ? 포함)\"),\n\t\t\t\t{ \"id\": \"progressbarsmooth\", \"displaytext\": \"Progressbar smooth\", \"edittype\": \"Boolean\", \"defaultvalue\": \"false\", \"description\": \"진행 막대를 이어진 막대로\" }\n\t\t\t],\n\t\t\t\"summproperties\": []\n\t\t};\n\t};\n\n\t/* Layout 속성이 없을 때 : 필드마다 컬럼 1개, 헤더 = 라벨, 바디 = 바인딩 */\n\tthis.fn_MakeLayout = function() {\n\t\tlet oLayout = { \"columns\": [], \"rows\": [{ \"band\": \"head\", \"size\": 32 }, { \"band\": \"body\", \"size\": 32 }], \"head\": [], \"body\": [] };\n\t\tlet arrFields = this.oFieldArray.fields;\n\t\tfor (let i = 0; i < arrFields.length; i++) {\n\t\t\toLayout.columns.push({ \"band\": \"body\", \"size\": 100 });\n\t\t\toLayout.head.push({ \"col\": i, \"row\": 0, \"text\": arrFields[i].label });\n\t\t\toLayout.body.push({ \"col\": i, \"row\": 0, \"field\": arrFields[i].id });\n\t\t}\n\t\treturn oLayout;\n\t};\n\n\tthis.fn_GetFormat = function(oLayout) {\n\t\tlet oFormat = { \"tag\": \"Format\", \"attribute\": { \"id\": \"default\" }, \"Format\": [] };\n\t\tlet i;\n\n\t\tlet arrCols = [];\n\t\tfor (i = 0; i < oLayout.columns.length; i++) {\n\t\t\tarrCols.push({ \"tag\": \"Column\", \"attribute\": { \"size\": oLayout.columns[i].size, \"band\": oLayout.columns[i].band } });\n\t\t}\n\t\toFormat.Format.push({ \"tag\": \"Columns\", \"attribute\": {}, \"Columns\": arrCols });\n\n\t\tlet arrRows = [];\n\t\tfor (i = 0; i < oLayout.rows.length; i++) {\n\t\t\tarrRows.push({ \"tag\": \"Row\", \"attribute\": { \"size\": oLayout.rows[i].size, \"band\": oLayout.rows[i].band } });\n\t\t}\n\t\toFormat.Format.push({ \"tag\": \"Rows\", \"attribute\": {}, \"Rows\": arrRows });\n\n\t\toFormat.Format.push({ \"tag\": \"Band\", \"attribute\": { \"id\": \"head\" }, \"Band\": this.fn_GetCells(oLayout.head, \"head\") });\n\t\toFormat.Format.push({ \"tag\": \"Band\", \"attribute\": { \"id\": \"body\" }, \"Band\": this.fn_GetCells(oLayout.body, \"body\") });\n\t\tif (oLayout.summary && oLayout.summary.length > 0) {\n\t\t\toFormat.Format.push({ \"tag\": \"Band\", \"attribute\": { \"id\": \"summary\" }, \"Band\": this.fn_GetCells(oLayout.summary, \"summary\") });\n\t\t}\n\t\treturn oFormat;\n\t};\n\n\t/* Layout 셀 → <Cell>. body 는 필드의 Display / Edit type 을 반영 */\n\tthis.fn_GetCells = function(arrLayout, sBand) {\n\t\tlet arrCells = [];\n\t\tfor (let i = 0; i < arrLayout.length; i++) {\n\t\t\tlet oItem = arrLayout[i];\n\t\t\tlet oCell = { \"tag\": \"Cell\", \"attribute\": {} };\n\t\t\tlet sSuffix = (sBand == \"body\") ? oItem.field : (sBand == \"head\" ? oItem.text : \"\");\n\t\t\toCell.attribute.id = \"cell_\" + sBand + \"_\" + oItem.col + \"_\" + oItem.row + (sSuffix ? \"_\" + sSuffix : \"\");\n\n\t\t\tfor (let sKey in oItem) {\n\t\t\t\tif (sKey == \"field\") {\n\t\t\t\t\tif (sBand != \"body\" || !oItem.text) {\n\t\t\t\t\t\toCell.attribute.text = \"bind:\" + oItem[sKey];\n\t\t\t\t\t}\n\t\t\t\t} else if (sKey == \"halign\") {\n\t\t\t\t\toCell.attribute.textAlign = oItem[sKey];\n\t\t\t\t} else if (sKey == \"valign\") {\n\t\t\t\t\toCell.attribute.verticalAlign = oItem[sKey];\n\t\t\t\t} else if (sKey == \"cssclass\" && sBand == \"body\" && (\"\" + oItem[sKey]).indexOf(\"?\") >= 0) {\n\t\t\t\t\toCell.attribute.cssclass = \"expr:\" + oItem[sKey];\n\t\t\t\t} else {\n\t\t\t\t\toCell.attribute[sKey] = oItem[sKey];\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tif (sBand == \"body\") {\n\t\t\t\tlet oField = this.fn_FindField(oItem.field);\n\t\t\t\tif (oField) {\n\t\t\t\t\tlet sDisplay = this.fn_GetDisplayType(oField);\n\t\t\t\t\tlet sEdit = oField.edittype;\n\t\t\t\t\tif (sDisplay) {\n\t\t\t\t\t\toCell.attribute.displaytype = sDisplay;\n\t\t\t\t\t}\n\t\t\t\t\tif (sEdit) {\n\t\t\t\t\t\toCell.attribute.edittype = sEdit;\n\t\t\t\t\t}\n\t\t\t\t\tlet oCellProp = this.lfn_GetCellProp(\"body\", sDisplay, sEdit, oField);\n\t\t\t\t\tif (oCellProp) {\n\t\t\t\t\t\tObject.assign(oCell.attribute, oCellProp);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\t\n\t\t\tif (sBand == \"head\" && this.fn_GetBoolProp(\"useheadsort\", this.USE_HEAD_SORT)) {\n\t\t\t\toCell.attribute.tooltiptext = \"클릭하여 정렬\";\n\t\t\t}\n\n\t\t\tarrCells.push(oCell);\n\t\t}\n\t\treturn arrCells;\n\t};\n\n\tthis.fn_FindField = function(sId) {\n\t\tlet arrFields = this.oFieldArray.fields;\n\t\tfor (let i = 0; i < arrFields.length; i++) {\n\t\t\tif (arrFields[i].id == sId) {\n\t\t\t\treturn arrFields[i];\n\t\t\t}\n\t\t}\n\t\treturn null;\n\t};\n\n\t/* Display type 이 auto 면 필드 타입으로 정함 */\n\tthis.fn_GetDisplayType = function(oField) {\n\t\tlet sDisplay = oField.displaytype;\n\t\tif (sDisplay != \"auto\") {\n\t\t\treturn sDisplay;\n\t\t}\n\t\tlet oMap = {\n\t\t\t\"Boolean\": \"checkboxcontrol\", \"Date\": \"calendarcontrol\", \"Image\": \"imagecontrol\",\n\t\t\t\"Select\": \"combotext\", \"MultiSelect\": \"multicombocontrol\", \"Progressbar\": \"progressbarcontrol\",\n\t\t\t\"Email\": \"mask\", \"Phone\": \"mask\", \"Number\": \"number\", \"Price\": \"number\"\n\t\t};\n\t\treturn oMap[oField.fieldtype] ? oMap[oField.fieldtype] : \"normal\";\n\t};\n\n/************************************************************************************************\n * Runtime Functions (생성된 View 안에서 실행. this = View 내부 폼)\n * 주의 : 한 줄로 합쳐서 넣기 때문에 슬래시 두 개 주석은 쓰면 안 됨 (블록 주석만 사용)\n ************************************************************************************************/\n\tthis._fnViewOnLoad = function(objForm) {\n\t\t/* Sets the view form reference so that functions declared in the view can access it */\n\t\tthis._ownerForm = objForm;\n\t\tif (!this._bSearchGridInit) {\n\t\t\tlet oDs = this.parent.getViewDataset();\n\t\t\tif (oDs) {\n\t\t\t\toDs.addEventHandler(\"onload\", this.fn_ds_onchanged, this);\n\t\t\t\toDs.addEventHandler(\"onrowsetchanged\", this.fn_ds_onchanged, this);\n\t\t\t}\n\n\t\t\tif (this.fvConf.headSort && this.grdList) {\n\t\t\t\tthis.grdList.addEventHandler(\"onheadclick\", this.fn_grid_onheadclick, this);\n\t\t\t}\n\n\t\t\tif (this.fvConf.headSort && this.grdList) {\n\t\t\t\tlet sDef = this.fvConf.defaultSort;\n\t\t\t\tlet nDefCell = -1;\n\t\t\t\tlet sColDef = \"\";\n\t\t\t\tif (sDef) {\n\t\t\t\t\tsColDef = sDef.replace(/^[+-]/, \"\");\n\t\t\t\t\tfor (let j = 0; j < this.grdList.getCellCount(\"body\"); j++) {\n\t\t\t\t\t\tif (this.fn_getSortCol(this.grdList, j) == sColDef) {\n\t\t\t\t\t\t\tnDefCell = j;\n\t\t\t\t\t\t\tbreak;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tthis.fn_applySort(this.grdList, nDefCell, nDefCell < 0 ? \"\" : sColDef, sDef.charAt(0) != \"+\", true);\n\t\t\t}\n\n\t\t\tthis._bSearchGridInit = true;\n\t\t}\n\t\tthis.fn_updateCount();\n\t};\n\n\tthis.fn_ds_onchanged = function(obj, e) {\n\t\tthis.fn_updateCount();\n\t};\n\n\t/* 제목 옆 건수 : 필터 중이면 보이는 건수 / 전체 건수 */\n\tthis.fn_updateCount = function() {\n\t\tif (!this.sta_title) {\n\t\t\treturn;\n\t\t}\n\t\tlet c = this.fvConf;\n\t\tlet sText = \"<b v='true'>\" + c.titleText + \"</b>\";\n\t\tlet oDs = this.parent.getViewDataset();\n\t\tif (c.showCount && oDs) {\n\t\t\tlet nShow = oDs.getRowCount();\n\t\t\tlet nAll = oDs.getRowCountNF();\n\t\t\tlet sCount = (nShow == nAll) ? (nAll + \"건\") : (nShow + \" / \" + nAll + \"건\");\n\t\t\tsText += \"   <fc v='\" + c.mutedColor + \"'>\" + sCount + \"</fc>\";\n\t\t}\n\t\tthis.sta_title.set_text(sText);\n\t};\n\n\t/* 셀 Text 에서 정렬할 컬럼명 : bind:컬럼, 또는 expr: 식의 첫 단어가 데이터셋 컬럼일 때 */\n\tthis.fn_getSortCol = function(oGrid, nCell) {\n\t\tlet sText = \"\" + oGrid.getCellProperty(\"body\", nCell, \"text\");\n\t\tif (sText.indexOf(\"bind:\") == 0) {\n\t\t\treturn sText.substr(5);\n\t\t}\n\t\tif (sText.indexOf(\"expr:\") == 0) {\n\t\t\tlet arr = /^expr:\\s*([A-Za-z_][A-Za-z0-9_]*)/.exec(sText);\n\t\t\tlet oDs = oGrid.getBindDataset();\n\t\t\tif (arr && oDs && oDs.getColIndex(arr[1]) >= 0) {\n\t\t\t\treturn arr[1];\n\t\t\t}\n\t\t}\n\t\treturn \"\";\n\t};\n\n\t/* 정렬 적용 + 헤더 화살표 */\n\tthis.fn_applySort = function(oGrid, nCell, sCol, bDesc, bHint) {\n\t\tlet i;\n\t\t\n\t\tif (!this._arrHeadText) {\n\t\t\tthis._arrHeadText = [];\n\t\t\tfor (i = 0; i < oGrid.getCellCount(\"head\"); i++) {\n\t\t\t\tthis._arrHeadText[i] = oGrid.getCellProperty(\"head\", i, \"text\");\n\t\t\t}\n\t\t}\n\t\t\n\t\tif (sCol) {\n\t\t\tthis._sSortCol = sCol;\n\t\t\tthis._bSortDesc = bDesc;\n\t\t\toGrid.getBindDataset().set_keystring(\"S:\" + (bDesc ? \"-\" : \"+\") + sCol);\n\t\t}\n\t\t\n\t\tfor (i = 0; i < this._arrHeadText.length; i++) {\n\t\t\tlet sMark = \"\";\n\t\t\tif (i == nCell) {\n\t\t\t\tsMark = bDesc ? \" ▼\" : \" ▲\";\n\t\t\t} else if (bHint && this.fn_getSortCol(oGrid, i) != \"\") {\n\t\t\t\tsMark = \" ⇅\";\n\t\t\t}\n\t\t\toGrid.setCellProperty(\"head\", i, \"text\", this._arrHeadText[i] + sMark);\n\t\t}\n\t};\n\n\tthis.fn_grid_onheadclick = function(obj, e) {\n\t\tlet sCol = this.fn_getSortCol(obj, e.cell);\n\t\tif (!sCol) { \n\t\t\treturn;\n\t\t}\n\n\t\tlet bDesc = !(this._sSortCol == sCol && this._bSortDesc);\n\t\tthis.fn_applySort(obj, e.cell, sCol, bDesc);\n\n\t\tlet oDs = obj.getBindDataset();\n\t\tif (this.fvConf.selectFirst && oDs.getRowCount() > 0) {\n\t\t\toDs.set_rowposition(-1);\n\t\t\toDs.set_rowposition(0);\n\t\t}\n\n\t\tthis.fn_applySort(obj, e.cell, sCol, bDesc, false);\n\t};",
	"viewPropertiesValueBody": "return this.oViewPropertiesValue ? JSON.stringify(this.oViewPropertiesValue, null, \"\\t\") : \"\";"
}]]>
  </UIConfig>
  <Script version="1.0" type="xscript5.1"><![CDATA[/************************************************************************************************
 * Include Declarations
 ************************************************************************************************/
	include "./_lib_/util.xjs";
	include "./_lib_/basicCommon.xjs";

/************************************************************************************************
 * Variable Definitions
 ************************************************************************************************/
	// Layout
	this.VIEW_PADDING = 0;
	this.FRAME_PADDING = 16;
	this.HEADER_HEIGHT = 30;
	this.HEADER_GAP = 8;
	this.SEARCH_WIDTH = 240;
	this.ICON_WIDTH = 30;

	// Fonts / colors
	this.TITLE_FONT = "normal 700 13px/normal \"NotoSansKR-Bold\"";
	this.TITLE_COLOR = "#18181B";
	this.MUTED_COLOR = "#A1A1AA";
	this.FRAME_BORDER = "1px solid #E4E4E7";
	this.SEARCH_ICON = "URL('theme://images/btn_WF_InputSearchN.png') no-repeat center center";
	this.FRAME_RADIUS = "10px";

	// Default values of view properties
	this.TITLE_TEXT = "";
	this.USE_SEARCH = "true";
	this.SEARCH_PLACEHOLDER = "검색";
	this.SHOW_COUNT = "true";
	this.USE_HEAD_SORT = "true";
	this.SORT_SELECT_FIRST = "true";
	this.NODATA_TEXT = "데이터가 없습니다";
	this.AUTOFIT_TYPE = "col";
	this.DISPLAY_TYPE = "auto";
	this.EDIT_TYPE = "none";
	this.ARR_GRD_DISPLAY_TYPE = ["auto", "normal", "none", "buttoncontrol", "calendarcontrol", "date", "checkboxcontrol", "combocontrol", "combotext", "currency", "decoratetext", "editcontrol", "imagecontrol", "mask", "maskeditcontrol", "multicombocontrol", "number", "progressbarcontrol", "text", "textareacontrol", "treeitemcontrol"];
	this.ARR_GRD_EDIT_TYPE = ["auto", "normal", "none", "button", "checkbox", "combo", "date", "mask", "multicombo", "readonly", "text", "textarea", "tree"];

	// Component ids
	this.ID_FRAME = "sta_frame";
	this.ID_TITLE = "sta_title";
	this.ID_SEARCH = "edt_filterSearch";
	this.ID_ICON = "sta_searchIcon";
	this.ID_CLEAR = "btn_searchClear";
	this.ID_GRID = "grdList";

	// View-related variables
	this.oFieldArray;
	this.oContents;
	this.oViewProperties;
	this.oViewPropertiesValue;
	this.bNewLayout = false;

/************************************************************************************************
 * Required Function Area for NexaLAP Studio
 ************************************************************************************************/

	this.set_viewProperties = function() {
		let oViewAttr = { "attributes": [] };
		let oProperties;
		let oProperty;
		// View generation options (set_viewProperties)

		oProperties = {};
		oProperties.id = "titletext";
		oProperties.displaytext = "Title text";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.TITLE_TEXT;
		oProperties.description = "제목. 비우면 제목 없이 검색칸만 표시";
		oProperties.group = "Title";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "showcount";
		oProperties.displaytext = "Show count";
		oProperties.edittype = "Boolean";
		oProperties.defaultvalue = this.SHOW_COUNT;
		oProperties.description = "제목 옆 건수 (필터 중이면 '보이는 건수 / 전체 건수')";
		oProperties.group = "Title";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "usesearch";
		oProperties.displaytext = "Use search";
		oProperties.edittype = "Boolean";
		oProperties.defaultvalue = this.USE_SEARCH;
		oProperties.description = "검색칸(edt_filterSearch) + 지우기 버튼(btn_searchClear) 표시";
		oProperties.group = "Search";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "searchplaceholder";
		oProperties.displaytext = "Search placeholder";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.SEARCH_PLACEHOLDER;
		oProperties.description = "검색칸 안내 문구";
		oProperties.group = "Search";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "useheadsort";
		oProperties.displaytext = "Use head sort";
		oProperties.edittype = "Boolean";
		oProperties.defaultvalue = this.USE_HEAD_SORT;
		oProperties.description = "헤더 클릭 정렬 (다시 누르면 내림차순 / 오름차순 전환)";
		oProperties.group = "Sort";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "sortselectfirst";
		oProperties.displaytext = "Select first after sort";
		oProperties.edittype = "Boolean";
		oProperties.defaultvalue = this.SORT_SELECT_FIRST;
		oProperties.description = "정렬 후 첫 행 선택 (행 변경 이벤트로 연결된 Interaction 이 이어짐)";
		oProperties.group = "Sort";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "gridlayout";
		oProperties.displaytext = "Layout";
		oProperties.edittype = "GridLayout";
		oProperties.description = "그리드 포맷";
		oProperties.group = "Grid";
		oProperties.userproperties = { "headproperties": [], "bodyproperties": [], "summproperties": [] };
		oProperty = {};
		oProperty.id = "text";
		oProperty.displaytext = "Text";
		oProperty.edittype = "String";
		oProperty.defaultvalue = "";
		oProperty.description = "셀 글자";
		oProperties.userproperties.headproperties.push(oProperty);
		oProperty = {};
		oProperty.id = "cssclass";
		oProperty.displaytext = "CSS class";
		oProperty.edittype = "String";
		oProperty.defaultvalue = "";
		oProperty.description = "셀 스타일 (XCSS class)";
		oProperties.userproperties.headproperties.push(oProperty);
		oProperty = {};
		oProperty.id = "text";
		oProperty.displaytext = "Text";
		oProperty.edittype = "String";
		oProperty.defaultvalue = "";
		oProperty.description = "셀 글자";
		oProperties.userproperties.bodyproperties.push(oProperty);
		oProperty = {};
		oProperty.id = "textAlign";
		oProperty.displaytext = "Text align";
		oProperty.edittype = "Enum";
		oProperty.enumlist = ["left", "center", "right"];
		oProperty.defaultvalue = "center";
		oProperty.description = "글자 정렬";
		oProperties.userproperties.bodyproperties.push(oProperty);
		oProperty = {};
		oProperty.id = "suppress";
		oProperty.displaytext = "Suppress";
		oProperty.edittype = "Number";
		oProperty.description = "같은 값 셀 합쳐 보이기";
		oProperties.userproperties.bodyproperties.push(oProperty);
		oProperty = {};
		oProperty.id = "wordWrap";
		oProperty.displaytext = "Word wrap";
		oProperty.edittype = "Enum";
		oProperty.enumlist = ["none", "char", "english"];
		oProperty.defaultvalue = "none";
		oProperty.description = "줄바꿈";
		oProperties.userproperties.bodyproperties.push(oProperty);
		oProperty = {};
		oProperty.id = "tooltipText";
		oProperty.displaytext = "Tooltip text";
		oProperty.edittype = "String";
		oProperty.defaultvalue = "";
		oProperty.description = "툴팁";
		oProperties.userproperties.bodyproperties.push(oProperty);
		oProperty = {};
		oProperty.id = "maskeditformat";
		oProperty.displaytext = "Maskedit format";
		oProperty.edittype = "String";
		oProperty.defaultvalue = "";
		oProperty.description = "마스크 형식";
		oProperties.userproperties.bodyproperties.push(oProperty);
		oProperty = {};
		oProperty.id = "cssclass";
		oProperty.displaytext = "CSS class";
		oProperty.edittype = "String";
		oProperty.defaultvalue = "";
		oProperty.description = "셀 스타일 (XCSS class, 식이면 ? 포함)";
		oProperties.userproperties.bodyproperties.push(oProperty);
		oProperty = {};
		oProperty.id = "progressbarsmooth";
		oProperty.displaytext = "Progressbar smooth";
		oProperty.edittype = "Boolean";
		oProperty.defaultvalue = "false";
		oProperty.description = "진행 막대를 이어진 막대로";
		oProperties.userproperties.bodyproperties.push(oProperty);
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "autofittype";
		oProperties.displaytext = "Autofit";
		oProperties.edittype = "Enum";
		oProperties.enumlist = ["none", "col"];
		oProperties.defaultvalue = this.AUTOFIT_TYPE;
		oProperties.description = "컬럼 너비 자동 맞춤";
		oProperties.group = "Grid";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "nodatatext";
		oProperties.displaytext = "No data text";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.NODATA_TEXT;
		oProperties.description = "행이 없을 때(검색 결과 0건 포함) 표시할 문구";
		oProperties.group = "Grid";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "defaultsort";
		oProperties.displaytext = "Default sort";
		oProperties.edittype = "String";
		oProperties.defaultvalue = "";
		oProperties.description = "처음 정렬 컬럼 (-컬럼 : 내림차순, +컬럼 : 오름차순)";
		oProperties.group = "Sort";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "searchwidth";
		oProperties.displaytext = "Search Width";
		oProperties.edittype = "Number";
		oProperties.defaultvalue = this.SEARCH_WIDTH;
		oProperties.description = "검색칸 가로 크기 설정";
		oProperties.group = "Search";
		oViewAttr.attributes.push(oProperties);

		return JSON.stringify(oViewAttr, null, "\t");
	};

	this.set_fieldProperties = function() {
		let oFieldAttr = { "attributes": [] };
		let oProperties;

		oProperties = {};
		oProperties.id = "displaytype";
		oProperties.displaytext = "Display type";
		oProperties.edittype = "Enum";
		oProperties.enumlist = this.ARR_GRD_DISPLAY_TYPE;
		oProperties.defaultvalue = this.DISPLAY_TYPE;
		oProperties.description = "셀 표시 형식";
		oFieldAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "edittype";
		oProperties.displaytext = "Edit type";
		oProperties.edittype = "Enum";
		oProperties.enumlist = this.ARR_GRD_EDIT_TYPE;
		oProperties.defaultvalue = this.EDIT_TYPE;
		oProperties.description = "셀 편집 형식";
		oFieldAttr.attributes.push(oProperties);

		return JSON.stringify(oFieldAttr, null, "\t");
	};

	this.main = function(fieldarray, contents, viewproperties, extradata) {
		if (fieldarray) {
			this.oFieldArray = JSON.parse(fieldarray);
		}
		if (contents) {
			this.oContents = JSON.parse(contents);
			this.oContents.View.Model = [];
		}
		if (viewproperties) {
			this.oViewProperties = JSON.parse(viewproperties);
		}

		this.fn_GetModel();

		this.oContents.View.attribute.viewdataset = "${VIEW_DATASET}";
		this.oContents.View.InitValue = [];
		this.oContents.View.Objects = [];
		this.oContents.View.Script = this.fn_GetScript();

		/* 이전에 템플릿이 만든 컴포넌트는 지우고, 사용자가 추가한 컴포넌트는 유지 */
		this.fn_ClearContents();

		return JSON.stringify(this.oContents, null, "\t");
	};

	this.set_viewPropertiesValue = function() {
		return this.oViewPropertiesValue ? JSON.stringify(this.oViewPropertiesValue, null, "\t") : "";
	};


	/************************************************************************************************
	 * Functions Related to the main() Execution Flow
	 ************************************************************************************************/
		// View property value (없으면 기본값)
		this.fn_GetProp = function(sId, vDefault) {
			let oAttr = (this.oViewProperties && this.oViewProperties.attributes) ? this.oViewProperties.attributes : null;
			if (oAttr && oAttr[sId] !== undefined && oAttr[sId] !== null && oAttr[sId] !== "") {
				return oAttr[sId];
			}
			return vDefault;
		};

		this.fn_GetBoolProp = function(sId, vDefault) {
			return ("" + this.fn_GetProp(sId, vDefault)).toLowerCase() == "true";
		};

		// Model 에 컴포넌트 하나 추가
		this.fn_AddComp = function(sFieldId, sTag, oAttr) {
			this.oContents.View.Model.push({ "fieldid": sFieldId, "Components": [{ "tag": sTag, "attribute": oAttr }] });
		};

		this.fn_GetModel = function() {
			let nPad    = this.VIEW_PADDING;
			let nInner  = nPad + this.FRAME_PADDING;
			let sTitle  = this.fn_GetProp("titletext", this.TITLE_TEXT);
			let bSearch = this.fn_GetBoolProp("usesearch", this.USE_SEARCH);
			let bHeader = (sTitle != "") || bSearch;

			//---------------- 카드 배경 (가장 먼저 = 맨 뒤에 깔림) ----------------
			this.fn_AddComp("FRAME", "Static", {
				"id": this.ID_FRAME, "left": nPad, "top": nPad, "right": nPad, "bottom": nPad,
				"text": "", "border": this.FRAME_BORDER, "borderRadius": this.FRAME_RADIUS, "background": "#FFFFFF",
				"_fieldid": "FRAME", "_fieldcomptype": "label"
			});

			//---------------- 제목 (+ 건수는 실행 시점에 채움) ----------------
			if (sTitle != "") {
				this.fn_AddComp("TITLE", "Static", {
					"id": this.ID_TITLE, "left": nInner, "top": nInner, "height": this.HEADER_HEIGHT,
					"right": bSearch ? this.ID_SEARCH + ":8" : nInner,
					"text": sTitle, "font": this.TITLE_FONT, "color": this.TITLE_COLOR, "usedecorate": "true",
					"_fieldid": "TITLE", "_fieldcomptype": "label"
				});
			}

			//---------------- 검색칸 + 아이콘(왼쪽 안) + 지우기 버튼(오른쪽 안) ----------------
			if (bSearch) {
				let nSearchW = parseInt(this.fn_GetProp("searchwidth", this.SEARCH_WIDTH), 10);
				if (isNaN(nSearchW) || nSearchW < 60) {
					nSearchW = this.SEARCH_WIDTH;
				}
				this.fn_AddComp("_filterSearch", "Edit", {
					"id": this.ID_SEARCH, "top": nInner, "right": nInner, "width": nSearchW, "height": this.HEADER_HEIGHT,
					"displaynulltext": this.fn_GetProp("searchplaceholder", this.SEARCH_PLACEHOLDER),
					"padding": "0px " + this.ICON_WIDTH + "px 0px " + this.ICON_WIDTH + "px",
					"_fieldid": "_filterSearch", "_fieldcomptype": "comp"
				});
				/* 아이콘 / 지우기 버튼은 검색칸보다 뒤에 추가해야 위에 그려짐 */
				this.fn_AddComp("_searchIcon", "Static", {
					"id": this.ID_ICON, "left": this.ID_SEARCH + ":-" + nSearchW, "top": nInner,
					"width": this.ICON_WIDTH, "height": this.HEADER_HEIGHT, "text": "", "background": this.SEARCH_ICON,
					"_fieldid": "_searchIcon", "_fieldcomptype": "label"
				});
				this.fn_AddComp("_searchClear", "Button", {
					"id": this.ID_CLEAR, "top": nInner, "right": nInner, "width": this.ICON_WIDTH, "height": this.HEADER_HEIGHT,
					"text": "✕", "tooltiptext": "검색어 지우기", "border": "0px none", "background": "transparent", "color": this.MUTED_COLOR,
					"_fieldid": "_searchClear", "_fieldcomptype": "comp"
				});
			}

			//---------------- 그리드 ----------------
			let oLayout;
			let sLayout = this.fn_GetProp("gridlayout", "");
			if (sLayout) {
				oLayout = (typeof sLayout == "string") ? this.lfn_StringToJson(sLayout) : sLayout;
			} else {
				/* Layout 속성이 비어 있으면 필드 순서대로 새로 만들고, 그 값을 Layout 속성에 돌려줌 */
				this.bNewLayout = true;
				oLayout = this.fn_MakeLayout();
				this.oViewPropertiesValue = { "gridlayout": JSON.parse(JSON.stringify(oLayout)) };
			}

			let oGrid = {
				"tag": "Grid",
				"attribute": {
					"id": this.ID_GRID, "left": nInner, "right": nInner, "bottom": nInner,
					"top": bHeader ? nInner + this.HEADER_HEIGHT + this.HEADER_GAP : nInner,
					"binddataset": "${VIEW_DATASET}",
					"autofittype": this.fn_GetProp("autofittype", this.AUTOFIT_TYPE),
					"nodatatext": this.fn_GetProp("nodatatext", this.NODATA_TEXT),
					"cssclass": "grd_WF_Detail",
					"_fieldid": "grdList", "_fieldcomptype": "comp"
				},
				"Grid": [{ "tag": "Formats", "attribute": {}, "Formats": [this.fn_GetFormat(oLayout)] }]
			};
			oGrid = this.fn_MergeField(oGrid);

			let arrIds = [];
			for (let i = 0; i < this.oFieldArray.fields.length; i++) {
				arrIds.push(this.oFieldArray.fields[i].id);
			}
			this.oContents.View.Model.push({ "fieldid": arrIds.join(","), "Components": [oGrid] });
		};

		// 함수를 한 줄 문자열로 변환 (실행 함수 안에는 // 주석 금지 : 줄바꿈이 지워지면 뒤가 주석이 됨)
		this.fn_FuncString = function(sName) {
			let s = this[sName].toString().replace(/[\r\n\t]/g, "");
			return "this." + sName + " = " + s + ";";
		};

		this.fn_GetScript = function() {
			let oConf = {
				"titleText"   : this.fn_GetProp("titletext", this.TITLE_TEXT),
				"showCount"   : this.fn_GetBoolProp("showcount", this.SHOW_COUNT),
				"headSort"    : this.fn_GetBoolProp("useheadsort", this.USE_HEAD_SORT),
				"selectFirst" : this.fn_GetBoolProp("sortselectfirst", this.SORT_SELECT_FIRST),
				"mutedColor"  : this.MUTED_COLOR,
				"defaultSort" : this.fn_GetProp("defaultsort", "")
			};

			let sValue = "this.fvConf = " + JSON.stringify(oConf) + ";";
			sValue += this.fn_FuncString("_fnViewOnLoad");
			sValue += this.fn_FuncString("fn_ds_onchanged");
			sValue += this.fn_FuncString("fn_updateCount");
			sValue += this.fn_FuncString("fn_grid_onheadclick");
			sValue += this.fn_FuncString("fn_applySort");
			sValue += this.fn_FuncString("fn_getSortCol");

			return { "tag": "Script", "attribute": { "type": "xscript5.1" }, "value": sValue };
		};

		/* 이전에 템플릿이 만든 컴포넌트(_fieldid 있음)는 지우고, 사용자가 추가한 컴포넌트는 Model 뒤에 붙임 */
		this.fn_ClearContents = function() {
			let oLayout = this.oContents.View.View[0].Layouts[0].Layout;
			let oModel  = this.oContents.View.Model;
			if (!oLayout) {
				return;
			}
			for (let i = oLayout.length - 1; i >= 0; i--) {
				let oComp = oLayout.splice(i, 1);
				if (!(oComp[0].attribute && oComp[0].attribute._fieldid)) {
					oModel.push({ "fieldid": "", "Components": oComp });
				}
			}
		};

		/* 다시 생성할 때 사용자가 그리드에 직접 바꾼 속성(위치 제외)은 유지 */
		this.fn_MergeField = function(oComp) {
			if (this.bNewLayout) {
				return oComp;
			}
			let oLayout = this.oContents.View.View[0].Layouts[0].Layout;
			if (!oLayout) {
				return oComp;
			}
			let nIdx = oLayout.findIndex(function(item) {
				return item.attribute && item.attribute._fieldid === oComp.attribute._fieldid
				    && item.attribute._fieldcomptype === oComp.attribute._fieldcomptype;
			});
			if (nIdx < 0) {
				return oComp;
			}
			let oOrg = oLayout.splice(nIdx, 1)[0];
			if (oOrg.tag != oComp.tag) {
				return oComp;
			}
			let arrExclude = ["top", "left", "width", "height", "right", "bottom"];
			for (let sKey in oOrg.attribute) {
				if (arrExclude.indexOf(sKey) < 0 && !this.lfn_IsNull(oOrg.attribute[sKey]) && this.lfn_IsNull(oComp.attribute[sKey])) {
					oComp.attribute[sKey] = oOrg.attribute[sKey];
				}
			}
			return oComp;
		};

	/************************************************************************************************
	 * Grid Format Functions (Layout 속성 → <Format>)
	 ************************************************************************************************/
		/* Layout 편집기 셀 속성 목록 (head / body / summary) */
		this.fn_GetCellProperties = function() {
			let fnStr  = function(id, text, desc) { return { "id": id, "displaytext": text, "edittype": "String", "defaultvalue": "", "description": desc }; };
			let fnEnum = function(id, text, list, def, desc) { return { "id": id, "displaytext": text, "edittype": "Enum", "enumlist": list, "defaultvalue": def, "description": desc }; };
			return {
				"headproperties": [
					fnStr("text", "Text", "셀 글자"),
					fnStr("cssclass", "CSS class", "셀 스타일 (XCSS class)")
				],
				"bodyproperties": [
					fnStr("text", "Text", "셀 글자"),
					fnEnum("textAlign", "Text align", ["left", "center", "right"], "center", "글자 정렬"),
					{ "id": "suppress", "displaytext": "Suppress", "edittype": "Number", "defaultvalue": "", "description": "같은 값 셀 합쳐 보이기" },
					fnEnum("wordWrap", "Word wrap", ["none", "char", "english"], "none", "줄바꿈"),
					fnStr("tooltipText", "Tooltip text", "툴팁"),
					fnStr("maskeditformat", "Maskedit format", "마스크 형식"),
					fnStr("cssclass", "CSS class", "셀 스타일 (XCSS class, 식이면 ? 포함)"),
					{ "id": "progressbarsmooth", "displaytext": "Progressbar smooth", "edittype": "Boolean", "defaultvalue": "false", "description": "진행 막대를 이어진 막대로" }
				],
				"summproperties": []
			};
		};

		/* Layout 속성이 없을 때 : 필드마다 컬럼 1개, 헤더 = 라벨, 바디 = 바인딩 */
		this.fn_MakeLayout = function() {
			let oLayout = { "columns": [], "rows": [{ "band": "head", "size": 32 }, { "band": "body", "size": 32 }], "head": [], "body": [] };
			let arrFields = this.oFieldArray.fields;
			for (let i = 0; i < arrFields.length; i++) {
				oLayout.columns.push({ "band": "body", "size": 100 });
				oLayout.head.push({ "col": i, "row": 0, "text": arrFields[i].label });
				oLayout.body.push({ "col": i, "row": 0, "field": arrFields[i].id });
			}
			return oLayout;
		};

		this.fn_GetFormat = function(oLayout) {
			let oFormat = { "tag": "Format", "attribute": { "id": "default" }, "Format": [] };
			let i;

			let arrCols = [];
			for (i = 0; i < oLayout.columns.length; i++) {
				arrCols.push({ "tag": "Column", "attribute": { "size": oLayout.columns[i].size, "band": oLayout.columns[i].band } });
			}
			oFormat.Format.push({ "tag": "Columns", "attribute": {}, "Columns": arrCols });

			let arrRows = [];
			for (i = 0; i < oLayout.rows.length; i++) {
				arrRows.push({ "tag": "Row", "attribute": { "size": oLayout.rows[i].size, "band": oLayout.rows[i].band } });
			}
			oFormat.Format.push({ "tag": "Rows", "attribute": {}, "Rows": arrRows });

			oFormat.Format.push({ "tag": "Band", "attribute": { "id": "head" }, "Band": this.fn_GetCells(oLayout.head, "head") });
			oFormat.Format.push({ "tag": "Band", "attribute": { "id": "body" }, "Band": this.fn_GetCells(oLayout.body, "body") });
			if (oLayout.summary && oLayout.summary.length > 0) {
				oFormat.Format.push({ "tag": "Band", "attribute": { "id": "summary" }, "Band": this.fn_GetCells(oLayout.summary, "summary") });
			}
			return oFormat;
		};

		/* Layout 셀 → <Cell>. body 는 필드의 Display / Edit type 을 반영 */
		this.fn_GetCells = function(arrLayout, sBand) {
			let arrCells = [];
			for (let i = 0; i < arrLayout.length; i++) {
				let oItem = arrLayout[i];
				let oCell = { "tag": "Cell", "attribute": {} };
				let sSuffix = (sBand == "body") ? oItem.field : (sBand == "head" ? oItem.text : "");
				oCell.attribute.id = "cell_" + sBand + "_" + oItem.col + "_" + oItem.row + (sSuffix ? "_" + sSuffix : "");

				for (let sKey in oItem) {
					if (sKey == "field") {
						if (sBand != "body" || !oItem.text) {
							oCell.attribute.text = "bind:" + oItem[sKey];
						}
					} else if (sKey == "halign") {
						oCell.attribute.textAlign = oItem[sKey];
					} else if (sKey == "valign") {
						oCell.attribute.verticalAlign = oItem[sKey];
					} else if (sKey == "cssclass" && sBand == "body" && ("" + oItem[sKey]).indexOf("?") >= 0) {
						oCell.attribute.cssclass = "expr:" + oItem[sKey];
					} else {
						oCell.attribute[sKey] = oItem[sKey];
					}
				}

				if (sBand == "body") {
					let oField = this.fn_FindField(oItem.field);
					if (oField) {
						let sDisplay = this.fn_GetDisplayType(oField);
						let sEdit = oField.edittype;
						if (sDisplay) {
							oCell.attribute.displaytype = sDisplay;
						}
						if (sEdit) {
							oCell.attribute.edittype = sEdit;
						}
						let oCellProp = this.lfn_GetCellProp("body", sDisplay, sEdit, oField);
						if (oCellProp) {
							Object.assign(oCell.attribute, oCellProp);
						}
					}
				}
			
				if (sBand == "head" && this.fn_GetBoolProp("useheadsort", this.USE_HEAD_SORT)) {
					oCell.attribute.tooltiptext = "클릭하여 정렬";
				}

				arrCells.push(oCell);
			}
			return arrCells;
		};

		this.fn_FindField = function(sId) {
			let arrFields = this.oFieldArray.fields;
			for (let i = 0; i < arrFields.length; i++) {
				if (arrFields[i].id == sId) {
					return arrFields[i];
				}
			}
			return null;
		};

		/* Display type 이 auto 면 필드 타입으로 정함 */
		this.fn_GetDisplayType = function(oField) {
			let sDisplay = oField.displaytype;
			if (sDisplay != "auto") {
				return sDisplay;
			}
			let oMap = {
				"Boolean": "checkboxcontrol", "Date": "calendarcontrol", "Image": "imagecontrol",
				"Select": "combotext", "MultiSelect": "multicombocontrol", "Progressbar": "progressbarcontrol",
				"Email": "mask", "Phone": "mask", "Number": "number", "Price": "number"
			};
			return oMap[oField.fieldtype] ? oMap[oField.fieldtype] : "normal";
		};

	/************************************************************************************************
	 * Runtime Functions (생성된 View 안에서 실행. this = View 내부 폼)
	 * 주의 : 한 줄로 합쳐서 넣기 때문에 슬래시 두 개 주석은 쓰면 안 됨 (블록 주석만 사용)
	 ************************************************************************************************/
		this._fnViewOnLoad = function(objForm) {
			/* Sets the view form reference so that functions declared in the view can access it */
			this._ownerForm = objForm;
			if (!this._bSearchGridInit) {
				let oDs = this.parent.getViewDataset();
				if (oDs) {
					oDs.addEventHandler("onload", this.fn_ds_onchanged, this);
					oDs.addEventHandler("onrowsetchanged", this.fn_ds_onchanged, this);
				}

				if (this.fvConf.headSort && this.grdList) {
					this.grdList.addEventHandler("onheadclick", this.fn_grid_onheadclick, this);
				}

				if (this.fvConf.headSort && this.grdList) {
					let sDef = this.fvConf.defaultSort;
					let nDefCell = -1;
					let sColDef = "";
					if (sDef) {
						sColDef = sDef.replace(/^[+-]/, "");
						for (let j = 0; j < this.grdList.getCellCount("body"); j++) {
							if (this.fn_getSortCol(this.grdList, j) == sColDef) {
								nDefCell = j;
								break;
							}
						}
					}
					this.fn_applySort(this.grdList, nDefCell, nDefCell < 0 ? "" : sColDef, sDef.charAt(0) != "+", true);
				}

				this._bSearchGridInit = true;
			}
			this.fn_updateCount();
		};

		this.fn_ds_onchanged = function(obj, e) {
			this.fn_updateCount();
		};

		/* 제목 옆 건수 : 필터 중이면 보이는 건수 / 전체 건수 */
		this.fn_updateCount = function() {
			if (!this.sta_title) {
				return;
			}
			let c = this.fvConf;
			let sText = "<b v='true'>" + c.titleText + "</b>";
			let oDs = this.parent.getViewDataset();
			if (c.showCount && oDs) {
				let nShow = oDs.getRowCount();
				let nAll = oDs.getRowCountNF();
				let sCount = (nShow == nAll) ? (nAll + "건") : (nShow + " / " + nAll + "건");
				sText += "   <fc v='" + c.mutedColor + "'>" + sCount + "</fc>";
			}
			this.sta_title.set_text(sText);
		};

		/* 셀 Text 에서 정렬할 컬럼명 : bind:컬럼, 또는 expr: 식의 첫 단어가 데이터셋 컬럼일 때 */
		this.fn_getSortCol = function(oGrid, nCell) {
			let sText = "" + oGrid.getCellProperty("body", nCell, "text");
			if (sText.indexOf("bind:") == 0) {
				return sText.substr(5);
			}
			if (sText.indexOf("expr:") == 0) {
				let arr = /^expr:\s*([A-Za-z_][A-Za-z0-9_]*)/.exec(sText);
				let oDs = oGrid.getBindDataset();
				if (arr && oDs && oDs.getColIndex(arr[1]) >= 0) {
					return arr[1];
				}
			}
			return "";
		};

		/* 정렬 적용 + 헤더 화살표 */
		this.fn_applySort = function(oGrid, nCell, sCol, bDesc, bHint) {
			let i;
		
			if (!this._arrHeadText) {
				this._arrHeadText = [];
				for (i = 0; i < oGrid.getCellCount("head"); i++) {
					this._arrHeadText[i] = oGrid.getCellProperty("head", i, "text");
				}
			}
		
			if (sCol) {
				this._sSortCol = sCol;
				this._bSortDesc = bDesc;
				oGrid.getBindDataset().set_keystring("S:" + (bDesc ? "-" : "+") + sCol);
			}
		
			for (i = 0; i < this._arrHeadText.length; i++) {
				let sMark = "";
				if (i == nCell) {
					sMark = bDesc ? " ▼" : " ▲";
				} else if (bHint && this.fn_getSortCol(oGrid, i) != "") {
					sMark = " ⇅";
				}
				oGrid.setCellProperty("head", i, "text", this._arrHeadText[i] + sMark);
			}
		};

		this.fn_grid_onheadclick = function(obj, e) {
			let sCol = this.fn_getSortCol(obj, e.cell);
			if (!sCol) { 
				return;
			}

			let bDesc = !(this._sSortCol == sCol && this._bSortDesc);
			this.fn_applySort(obj, e.cell, sCol, bDesc);

			let oDs = obj.getBindDataset();
			if (this.fvConf.selectFirst && oDs.getRowCount() > 0) {
				oDs.set_rowposition(-1);
				oDs.set_rowposition(0);
			}

			this.fn_applySort(obj, e.cell, sCol, bDesc, false);
		};]]>
  </Script>
</ViewTemplateInfo>