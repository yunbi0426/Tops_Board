<?xml version="1.0" encoding="utf-8"?>
<ViewTemplateInfo version="2.1">
  <ViewTemplate id="SearchGridView" viewtype="Grid" manual="viewtemplates/SearchGridView.md" description_en="A grid in a card with a title, row count, keyword search box, clear button and header-click sorting"/>
  <UIConfig version="1.0"><![CDATA[{
	"includes": [
		{
			"value": "include \"./_lib_/util.xjs\";"
		},
		{
			"value": "include \"./_lib_/basicCommon.xjs\";"
		}
	],
	"viewProperties": [
		{
			"id": "titletext",
			"displaytext": "Title text",
			"editType": "String",
			"defaultValueExpr": "this.TITLE_TEXT",
			"description": "제목. 비우면 제목 없이 검색칸만 표시",
			"group": "Title"
		},
		{
			"id": "showcount",
			"displaytext": "Show count",
			"editType": "Boolean",
			"defaultValueExpr": "this.SHOW_COUNT",
			"description": "제목 옆 건수 (필터 중이면 '보이는 건수 / 전체 건수')",
			"group": "Title"
		},
		{
			"id": "usesearch",
			"displaytext": "Use search",
			"editType": "Boolean",
			"defaultValueExpr": "this.USE_SEARCH",
			"description": "검색칸(edt_filterSearch) + 지우기 버튼(btn_searchClear) 표시",
			"group": "Search"
		},
		{
			"id": "searchplaceholder",
			"displaytext": "Search placeholder",
			"editType": "String",
			"defaultValueExpr": "this.SEARCH_PLACEHOLDER",
			"description": "검색칸 안내 문구",
			"group": "Search"
		},
		{
			"id": "useheadsort",
			"displaytext": "Use head sort",
			"editType": "Boolean",
			"defaultValueExpr": "this.USE_HEAD_SORT",
			"description": "헤더 클릭 정렬 (다시 누르면 내림차순 / 오름차순 전환)",
			"group": "Sort"
		},
		{
			"id": "sortselectfirst",
			"displaytext": "Select first after sort",
			"editType": "Boolean",
			"defaultValueExpr": "this.SORT_SELECT_FIRST",
			"description": "정렬 후 첫 행 선택 (행 변경 이벤트로 연결된 Interaction 이 이어짐)",
			"group": "Sort"
		},
		{
			"id": "gridlayout",
			"displaytext": "Layout",
			"editType": "GridLayout",
			"defaultValue": "",
			"description": "그리드 포맷",
			"group": "Grid",
			"userProperties": {
				"headproperties": [
					{
						"id": "text",
						"editType": "String",
						"defaultValue": "",
						"displaytext": "Text",
						"description": "셀 글자"
					},
					{
						"id": "cssclass",
						"editType": "String",
						"defaultValue": "",
						"displaytext": "CSS class",
						"description": "셀 스타일 (XCSS class)"
					}
				],
				"bodyproperties": [
					{
						"id": "text",
						"editType": "String",
						"defaultValue": "",
						"displaytext": "Text",
						"description": "셀 글자"
					},
					{
						"id": "textAlign",
						"editType": "Enum",
						"defaultValue": "center",
						"displaytext": "Text align",
						"enumList": [
							"\"left\"",
							"\"center\"",
							"\"right\""
						],
						"description": "글자 정렬"
					},
					{
						"id": "suppress",
						"editType": "Number",
						"defaultValue": "",
						"displaytext": "Suppress",
						"description": "같은 값 셀 합쳐 보이기"
					},
					{
						"id": "wordWrap",
						"editType": "Enum",
						"defaultValue": "none",
						"displaytext": "Word wrap",
						"enumList": [
							"\"none\"",
