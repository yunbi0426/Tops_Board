<?xml version="1.0" encoding="utf-8"?>
<ViewSetInfo version="1.0">
  <ViewSet id="DashboardDetail_H" viewsettype="viewset" description_en="A dashboard layout with summary cards on top, a chart and a main grid side by side, and a detail grid at the bottom.">
    <Views>
      <View id="Summary" viewtemplate="SummaryCardView.viewtemplate"/>
      <View id="Chart" viewtemplate="RankBarChart.viewtemplate"/>
    </Views>
  </ViewSet>
  <FDL version="2.1">
    <Form id="DashboardDetail_H" width="1050" height="736" titletext="New Form">
      <Layouts>
        <Layout width="1050" height="736">
          <View id="Summary" left="10" top="10" height="110" text="Summary" right="10"/>
          <View id="Chart" left="10" top="Summary:10" width="40%" height="50%" text="Chart" viewtype="Chart"/>
          <View id="Main" left="Chart:10" top="Summary:10" height="50%" text="Main" right="10" viewtype="Grid"/>
          <View id="Detail" left="10" top="Chart:10" text="Detail" right="10" bottom="10" viewtype="Grid"/>
        </Layout>
      </Layouts>
      <Script type="xscript5.1"><![CDATA[]]>
      </Script>
      <Objects/>
      <Trigger/>
    </Form>
  </FDL>
