/************************************************************************************************
 * Include Declarations
 ************************************************************************************************/

/************************************************************************************************
 * Variable Definitions
 ************************************************************************************************/
	// Layout
	this.VIEW_PADDING = 0;	// View 가장자리 ~ 테두리 박스
	this.FRAME_PADDING = 0;	// 테두리 박스 ~ 내용
	this.HEADER_HEIGHT = 20;
	this.HEADER_GAP = 8;
	this.VALUE_FONT_SIZE = 22;
	this.LABEL_FONT_PT = 9;	// 라벨/단위 글자 크기 (decorate <fs> 는 pt 단위)
	this.CARD_GAP = 8;

	// Fonts / colors (화면과 무관한 스타일 기본 값)
	this.TEXT_FONT = "normal 12px/normal \"NotoSansKR-Regular\"";
	this.FRAME_BORDER = "0px none";
	this.HEADER_COLOR = "#A1A1AA";
	this.FRAME_BACKGROUND = "transparent";
	this.HEADER_ALIGN = "right";
	this.CARD_RADIUS = "10px";
	this.CARD_PADDING = "0px 20px";
	this.CARD_FONT_FAMILY = "\"NotoSansKR-Bold\"";

	// Default values of view properties (화면마다 다른 값은 비워두고 View Generation 속성에서 지정)
	this.HEADER_FIELDS = "";
	this.HEADER_FORMAT = "";
	this.EMPTY_TEXT = "데이터가 없습니다";
	this.CARD_COLORS = "#F4F4F5,#E1F5EE,#FAEEDA,#E6F1FB";
	this.BORDER_COLORS = "#E4E4E7,#9FE1CB,#FAC775,#B5D4F4";
	this.LABEL_COLORS = "#71717A,#0F6E56,#854F0B,#185FA5";
	this.VALUE_COLORS = "#18181B,#085041,#633806,#0C447C";

	// Component ids
	this.ID_FRAME = "staFrame";
	this.ID_HEADER = "staHeader";

	// View-related variables
	this.oFieldArray;
	this.oContents;
	this.oViewProperties;
	this.arrCardIds = [];
	this.arrCardLabels = [];
	this.arrCardSuffix = [];

/************************************************************************************************
 * Required Function Area for NexaLAP Studio
 ************************************************************************************************/

	this.set_viewProperties = function() {
		let oViewAttr = { "attributes": [] };
		let oProperties;
		// View generation options (set_viewProperties)

		oProperties = {};
		oProperties.id = "headerfields";
		oProperties.displaytext = "Header fields";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.HEADER_FIELDS;
		oProperties.description = "선택한 필드 중 카드로 만들지 않을 필드 ID (쉼표 구분)";
		oProperties.group = "Header";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "headerformat";
		oProperties.displaytext = "Header format";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.HEADER_FORMAT;
		oProperties.description = "제목 줄 형식. {필드ID} 를 현재 행 값으로 치환. <b v='true'>굵게</b> 사용 가능. 비우면 제목 줄 없음";
		oProperties.group = "Header";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "emptytext";
		oProperties.displaytext = "Empty text";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.EMPTY_TEXT;
		oProperties.description = "데이터가 없을 때 제목 줄 문구";
		oProperties.group = "Header";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "cardcolors";
		oProperties.displaytext = "Card colors";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.CARD_COLORS;
		oProperties.description = "카드 배경색 (카드 순서대로, 쉼표 구분)";
		oProperties.group = "Card";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "labelcolors";
		oProperties.displaytext = "Label colors";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.LABEL_COLORS;
		oProperties.description = "카드 라벨 글자색 (카드 순서대로, 쉼표 구분)";
		oProperties.group = "Card";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "valuecolors";
		oProperties.displaytext = "Value colors";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.VALUE_COLORS;
		oProperties.description = "카드 값 글자색 (카드 순서대로, 쉼표 구분)";
		oProperties.group = "Card";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "valuefontsize";
		oProperties.displaytext = "Value font size";
		oProperties.edittype = "Number";
		oProperties.defaultvalue = this.VALUE_FONT_SIZE;
		oProperties.description = "카드 값 글자 크기(px)";
		oProperties.group = "Card";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "cardgap";
		oProperties.displaytext = "Card gap";
		oProperties.edittype = "Number";
		oProperties.defaultvalue = this.CARD_GAP;
		oProperties.description = "카드 사이 간격(px)";
		oProperties.group = "Card";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "id";
		oProperties.displaytext = "bordercolors";
		oProperties.edittype = "String";
		oProperties.defaultvalue = "this.BORDER_COLORS";
		oProperties.description = "카드 테두리색 (카드 순서대로, 쉼표 구분)";
		oProperties.group = "Card";
		oViewAttr.attributes.push(oProperties);

		return JSON.stringify(oViewAttr, null, "\t");
	};

	this.set_fieldProperties = function() {
		let oFieldAttr = { "attributes": [] };
		let oProperties;

		oProperties = {};
		oProperties.id = "valuesuffix";
		oProperties.displaytext = "Value suffix";
		oProperties.edittype = "String";
		oProperties.defaultvalue = "";
		oProperties.description = "값 뒤에 작게 붙일 단위 (예: 건, %)";
		oFieldAttr.attributes.push(oProperties);

		return JSON.stringify(oFieldAttr, null, "\t");
	};

	this.main = function(fieldarray, contents, viewproperties, extradata) {
		if (fieldarray) {
			this.oFieldArray = JSON.parse(fieldarray);
		}

		if (contents) {
			this.oContents = JSON.parse(contents);

			// Initialize Model Information
			this.oContents.View.Model = [];

			// Initialize View layout
			if (this.oContents.View.View && this.oContents.View.View[0]) {
				this.oContents.View.View[0].tag = "Layouts";
				this.oContents.View.View[0].Layouts = [];
			}
		}

		if (viewproperties) {
			this.oViewProperties = JSON.parse(viewproperties);
		}

		this.arrCardIds = [];
		this.arrCardLabels = [];
		this.arrCardSuffix = [];

		// Generate model(component) information
		this.oContents.View.Model = this.fn_GetModel();

		// The viewdataset must be set (값은 바인딩 대신 스크립트로 채움 : 쉼표/단위 표시)
		this.oContents.View.attribute.viewdataset = "${VIEW_DATASET}";

		// Generate script information
		this.oContents.View.Script = this.fn_GetScript();

		return JSON.stringify(this.oContents, null, "\t");
	};

	/************************************************************************************************
	 * Functions Related to the main() Execution Flow
	 ************************************************************************************************/
		// View property value (없으면 기본값)
		this.fn_GetProp = function(sId, vDefault) {
			let oAttr = (this.oViewProperties && this.oViewProperties.attributes) ? this.oViewProperties.attributes : null;
			if (oAttr && oAttr[sId] !== undefined && oAttr[sId] !== null && oAttr[sId] !== "") {
				return oAttr[sId];
			}
			return vDefault;
		};

		// 숫자 속성 (잘못된 값이면 기본값)
		this.fn_GetNumProp = function(sId, nDefault) {
			let n = parseInt(this.fn_GetProp(sId, nDefault), 10);
			return isNaN(n) ? nDefault : n;
		};

		// 쉼표 문자열 → 배열 (공백 제거)
		this.fn_Split = function(sValue) {
			let arr = ("" + sValue).split(",");
			let arrResult = [];
			for (let i = 0; i < arr.length; i++) {
				let s = arr[i].replace(/^\s+|\s+$/g, "");
				if (s != "") {
					arrResult.push(s);
				}
			}
			return arrResult;
		};

		// 배열에서 i 번째 (모자라면 순환, 비었으면 기본값)
		this.fn_Pick = function(arr, i, sDefault) {
			return arr.length > 0 ? arr[i % arr.length] : sDefault;
		};

		// 카드로 만들 필드 = 선택한 필드 중 헤더 필드를 뺀 나머지
		this.fn_GetCardFields = function() {
			let arrFields = (this.oFieldArray && this.oFieldArray.fields) ? this.oFieldArray.fields : [];
			let arrHeader = this.fn_Split(this.fn_GetProp("headerfields", this.HEADER_FIELDS));
			let arrResult = [];

			for (let i = 0; i < arrFields.length; i++) {
				if (arrHeader.indexOf(arrFields[i].id) < 0) {
					arrResult.push(arrFields[i]);
				}
			}
			return arrResult;
		};

		this.fn_GetModel = function() {
			let oModel = [];

			let arrCards   = this.fn_GetCardFields();
			let arrBg      = this.fn_Split(this.fn_GetProp("cardcolors", this.CARD_COLORS));
			let arrValueFg = this.fn_Split(this.fn_GetProp("valuecolors", this.VALUE_COLORS));
			let arrBorder  = this.fn_Split(this.fn_GetProp("bordercolors", this.BORDER_COLORS));
			let nFontSize  = this.fn_GetNumProp("valuefontsize", this.VALUE_FONT_SIZE);
			let nGap       = this.fn_GetNumProp("cardgap", this.CARD_GAP);
			let bHeader    = this.fn_GetProp("headerformat", this.HEADER_FORMAT) != "";

			let nPad   = this.VIEW_PADDING;
			let nInner = nPad + this.FRAME_PADDING;     // 테두리 박스 안쪽 시작 위치
			let nTop   = nInner;

			//---------------- 테두리 박스 : View 를 가득 채움 (가장 먼저 = 맨 뒤에 깔림) ----------------
			let oFrame = {
				"tag": "Static",
				"attribute": {
					"id": this.ID_FRAME, "left": nPad, "top": nPad, "right": nPad, "bottom": nPad,
					"text": "", "border": this.FRAME_BORDER, "borderRadius": "12px", "background": this.FRAME_BACKGROUND
				}
			};
			oModel.push({ "fieldid": "", "Components": [oFrame] });

			//---------------- 제목 줄 (headerformat 이 있을 때만) ----------------
			if (bHeader) {
				let oHeader = {
					"tag": "Static",
					"attribute": {
						"id": this.ID_HEADER, "left": nInner, "top": nTop, "right": nInner, "height": this.HEADER_HEIGHT,
						"text": "", "color": this.HEADER_COLOR, "font": this.TEXT_FONT, "usedecorate": "true", "textAlign": this.HEADER_ALIGN
					}
				};
				oModel.push({ "fieldid": "", "Components": [oHeader] });

				nTop += this.HEADER_HEIGHT + this.HEADER_GAP;
			}

			//---------------- 카드 : 라벨 + 값을 한 Static 에 두 줄로 (세로 가운데) ----------------
			// 너비 : 테두리 안쪽 너비를 카드 수로 나눈 %(간격만큼 2% 덜어냄). 마지막 카드는 right 로 끝을 맞춤
			// 높이 : bottom 으로 테두리 안쪽 끝까지
			let nCount  = arrCards.length;
			let sWidth  = nCount > 0 ? (Math.floor(10000 / nCount) / 100 - 2) + "%" : "100%";
			let sPrevId = "";

			for (let i = 0; i < nCount; i++) {
				let oField  = arrCards[i];
				let sCardId = "staCard_" + oField.id;
				let bLast   = (i == nCount - 1);

				let oCard = {
					"tag": "Static",
					"attribute": {
						"id": sCardId, "left": (i == 0) ? nInner : sPrevId + ":" + nGap, "top": nTop, "bottom": nInner,
						"text": oField.label ? oField.label : oField.id,
						"background": this.fn_Pick(arrBg, i, "#F4F4F5"),
						"border": "1px solid " + this.fn_Pick(arrBorder, i, "#E4E4E7"),
						"borderRadius": this.CARD_RADIUS,
						"color": this.fn_Pick(arrValueFg, i, "#18181B"), "padding": this.CARD_PADDING,
						"verticalAlign": "middle", "usedecorate": "true",
						"font": "normal 700 " + nFontSize + "px/normal " + this.CARD_FONT_FAMILY,
					}
				};

				if (bLast) {
					oCard.attribute.right = nInner;
				} else {
					oCard.attribute.width = sWidth;
				}

				this.arrCardIds.push(oField.id);
				this.arrCardLabels.push(oField.label ? oField.label : oField.id);
				this.arrCardSuffix.push(oField.valuesuffix ? oField.valuesuffix : "");
				oModel.push({ "fieldid": oField.id, "Components": [oCard] });

				sPrevId = sCardId;
			}

			return oModel;
		};

		// 함수를 "this.<name> = function..." 문자열로 변환
		this.fn_FuncString = function(sName) {
			return "\n\tthis." + sName + " = " + this[sName].toString() + ";\n";
		};

		this.fn_GetScript = function() {
			// 실행 시점에 View 스크립트가 참조할 값
			let sValue = "\n\tthis.fvHeaderFormat = " + JSON.stringify(this.fn_GetProp("headerformat", this.HEADER_FORMAT)) + ";"
			           + "\n\tthis.fvEmptyText = " + JSON.stringify(this.fn_GetProp("emptytext", this.EMPTY_TEXT)) + ";"
			           + "\n\tthis.fvValueSuffix = " + JSON.stringify(this.arrCardSuffix) + ";"
			           + "\n\tthis.fvCardFields = " + JSON.stringify(this.arrCardIds) + ";"
			           + "\n\tthis.fvCardLabels = " + JSON.stringify(this.arrCardLabels) + ";"
			           + "\n\tthis.fvLabelColors = " + JSON.stringify(this.fn_Split(this.fn_GetProp("labelcolors", this.LABEL_COLORS))) + ";"
			           + "\n\tthis.fvSmallPt = " + this.LABEL_FONT_PT + ";\n";

			sValue += this.fn_FuncString("_fnViewOnLoad");
			sValue += this.fn_FuncString("fn_ds_onchanged");
			sValue += this.fn_FuncString("fn_refresh");
			sValue += this.fn_FuncString("fn_formatValue");
			sValue += this.fn_FuncString("fn_formatNumber");

			return {
				"tag": "Script",
				"attribute": { "type": "xscript5.1" },
				"value": sValue
			};
		};

	/************************************************************************************************
	 * Runtime Functions (생성된 View 안에서 실행되는 함수. this = View 내부 폼)
	 ************************************************************************************************/
		this._fnViewOnLoad = function(objForm) {
			/* Sets the view form reference so that functions declared in the view can access it */
			this._ownerForm = objForm;

			let oDs = this.parent.getViewDataset();
			if (oDs && !this._bSummaryInit) {
				/* 조회 완료(onload) / 값 변경(oncolumnchanged) / 행 이동(onrowposchanged) 때 갱신. 재호출 시 중복 등록 방지 */
				oDs.addEventHandler("onload", this.fn_ds_onchanged, this);
				oDs.addEventHandler("oncolumnchanged", this.fn_ds_onchanged, this);
				oDs.addEventHandler("onrowposchanged", this.fn_ds_onchanged, this);
				this._bSummaryInit = true;
			}

			this.fn_refresh();
		};

		this.fn_ds_onchanged = function(obj, e) {
			this.fn_refresh();
		};

		/* 제목 줄 + 카드 값을 현재 행 기준으로 다시 그림 */
		this.fn_refresh = function() {
			let oDs   = this.parent.getViewDataset();
			let bData = oDs && oDs.getRowCount() > 0 && oDs.rowposition >= 0;
			let nRow  = bData ? oDs.rowposition : -1;
			let oThis = this;

			// 제목 줄
			if (this.staHeader && this.fvHeaderFormat) {
				if (!bData) {
					this.staHeader.set_text(this.fvEmptyText);
				} else {
					let sText = ("" + this.fvHeaderFormat).replace(/\{([A-Za-z0-9_]+)\}/g, function(sAll, sCol) {
						return oThis.fn_formatValue(oDs.getColumn(nRow, sCol));
					});
					this.staHeader.set_text(sText);
				}
			}

			// 카드 : 1줄 라벨(작게, 라벨색) + 2줄 값(천 단위 쉼표) + 작은 단위
			let sSmall = "<fs v='" + this.fvSmallPt + "'>";
			for (let i = 0; i < this.fvCardFields.length; i++) {
				let sCol  = this.fvCardFields[i];
				let oCard = this["staCard_" + sCol];
				if (!oCard) {
					continue;
				}

				let sColor = this.fvLabelColors.length > 0 ? this.fvLabelColors[i % this.fvLabelColors.length] : "#71717A";
				let sLabel = "<fc v='" + sColor + "'>" + sSmall + this.fvCardLabels[i] + "</fs></fc>";

				let sValue = "-";
				if (bData) {
					let v = oDs.getColumn(nRow, sCol);
					if (v !== undefined && v !== null && v !== "") {
						let sSuffix = this.fvValueSuffix[i] || "";
						sValue = this.fn_formatNumber(v) + (sSuffix ? sSmall + " " + sSuffix + "</fs>" : "");
					}
				}

				oCard.set_text(sLabel + "\n" + sValue);
			}
		};

		/* 날짜 값은 yyyy-MM-dd (시각이 있으면 HH:mm 까지), 그 외는 문자열 */
		this.fn_formatValue = function(v) {
			if (v === undefined || v === null) {
				return "";
			}
			if (v.getFullYear) {
				let p = function(n) { return n < 10 ? "0" + n : "" + n; };
				let sDate = v.getFullYear() + "-" + p(v.getMonth() + 1) + "-" + p(v.getDate());
				if (v.getHours() == 0 && v.getMinutes() == 0) {
					return sDate;
				}
				return sDate + " " + p(v.getHours()) + ":" + p(v.getMinutes());
			}
			return "" + v;
		};

		/* 숫자는 천 단위 쉼표, 숫자가 아니면 그대로 */
		this.fn_formatNumber = function(v) {
			let s = "" + v;
			if (!/^-?\d+(\.\d+)?$/.test(s)) {
				return this.fn_formatValue(v);
			}
			let arr = s.split(".");
			arr[0] = arr[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
			return arr.join(".");
		};
