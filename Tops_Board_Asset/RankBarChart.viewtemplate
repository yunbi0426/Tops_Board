					"value": "\"데이터가 없습니다\""
				},
				{
					"name": "ETC_VALUE",
					"type": "string",
					"value": "\"Y\""
				},
				{
					"name": "BAR_COLOR",
					"type": "string",
					"value": "\"#534AB7\""
				},
				{
					"name": "ETC_COLOR",
					"type": "string",
					"value": "\"#B4B2A9\""
				},
				{
					"name": "TRACK_COLOR",
					"type": "string",
					"value": "\"#F1EFE8\""
				},
				{
					"name": "USE_TOPN",
					"type": "string",
					"value": "\"true\""
				},
				{
					"name": "TOPN_LABEL",
					"type": "string",
					"value": "\"상위\""
				},
				{
					"name": "TOPN_MIN",
					"type": "number",
					"value": "1"
				},
				{
					"name": "TOPN_MAX",
					"type": "number",
					"value": "15"
				},
				{
					"name": "TOPN_DEFAULT",
					"type": "number",
					"value": "5"
				}
			],
			"comment": "Default values of view properties (화면마다 다른 값은 비워두고 View Generation 속성에서 지정)"
		},
		{
			"id": "Component ids",
			"variables": [
				{
					"name": "ID_FRAME",
					"type": "string",
					"value": "\"staFrame\""
				},
				{
					"name": "ID_TITLE",
					"type": "string",
					"value": "\"staTitle\""
				},
				{
					"name": "ID_TOPNLABEL",
					"type": "string",
					"value": "\"staTopN\""
