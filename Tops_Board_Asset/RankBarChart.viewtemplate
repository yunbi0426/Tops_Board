<?xml version="1.0" encoding="utf-8"?>
<ViewTemplateInfo version="2.1">
  <ViewTemplate id="RankBarChart" viewtype="Chart" description_en="Horizontal ranking bars for each row of the view dataset, with an optional top-N spin"/>
  <UIConfig version="1.0"><![CDATA[{
	"includes": [],
	"viewProperties": [
		{
			"id": "titletext",
			"displaytext": "Title text",
			"editType": "String",
			"defaultValueExpr": "this.TITLE_TEXT",
			"description": "제목 줄 문구. 비우면 제목 없이 Spin 만 표시",
			"group": "Header"
		},
		{
			"id": "emptytext",
			"displaytext": "Empty text",
			"editType": "String",
			"defaultValueExpr": "this.EMPTY_TEXT",
			"description": "데이터가 없을 때 막대 영역에 표시할 문구",
			"group": "Header"
		},
		{
			"id": "usetopn",
			"displaytext": "Use top N",
			"editType": "Boolean",
			"defaultValueExpr": "this.USE_TOPN",
			"description": "제목 줄 오른쪽에 상위 N Spin(spnTopN) 표시",
			"group": "Top N"
		},
		{
			"id": "topnlabel",
			"displaytext": "Top N label",
			"editType": "String",
			"defaultValueExpr": "this.TOPN_LABEL",
			"description": "Spin 왼쪽 라벨",
			"group": "Top N"
		},
		{
			"id": "topnmin",
			"displaytext": "Top N min",
			"editType": "Number",
			"defaultValueExpr": "this.TOPN_MIN",
			"description": "Spin 최솟값",
			"group": "Top N"
		},
		{
			"id": "topnmax",
			"displaytext": "Top N max",
			"editType": "Number",
			"defaultValueExpr": "this.TOPN_MAX",
			"description": "Spin 최댓값",
			"group": "Top N"
		},
		{
			"id": "topndefault",
			"displaytext": "Top N default",
			"editType": "Number",
			"defaultValueExpr": "this.TOPN_DEFAULT",
			"description": "Spin 초기값 (서비스 기본값과 맞출 것)",
			"group": "Top N"
		},
		{
			"id": "etcvalue",
			"displaytext": "Etc value",
			"editType": "String",
			"defaultValueExpr": "this.ETC_VALUE",
			"description": "etc 필드가 이 값이면 기타 막대로 표시",
			"group": "Bar"
		},
		{
			"id": "barcolor",
			"displaytext": "Bar color",
			"editType": "String",
			"defaultValueExpr": "this.BAR_COLOR",
			"description": "막대 색",
			"group": "Bar"
		},
		{
			"id": "etccolor",
			"displaytext": "Etc color",
			"editType": "String",
			"defaultValueExpr": "this.ETC_COLOR",
			"description": "기타 막대 색",
			"group": "Bar"
		},
		{
			"id": "trackcolor",
			"displaytext": "Track color",
			"editType": "String",
			"defaultValueExpr": "this.TRACK_COLOR",
			"description": "막대 바탕(빈 부분) 색",
			"group": "Bar"
		},
		{
			"id": "labelwidth",
			"displaytext": "Label width",
			"editType": "Number",
			"defaultValueExpr": "this.LABEL_WIDTH",
			"description": "막대 이름 칸 너비(px)",
			"group": "Bar"
		},
		{
			"id": "rowheight",
			"displaytext": "Row height",
			"editType": "Number",
			"defaultValueExpr": "this.ROW_HEIGHT",
			"description": "막대 한 줄 높이(px)",
			"group": "Bar"
		}
	],
	"fieldProperties": [
		{
			"id": "barrole",
			"displaytext": "Bar role",
			"editType": "Enum",
			"defaultValue": "none",
			"enumList": [
				"\"none\"",
				"\"label\"",
				"\"value\"",
				"\"etc\""
			],
			"description": "label : 막대 이름 / value : 막대 값 / etc : 기타 구분 / none : 사용 안 함"
		}
	],
	"mainBody": "if (fieldarray) {\n\tthis.oFieldArray = JSON.parse(fieldarray);\n}\n\nif (contents) {\n\tthis.oContents = JSON.parse(contents);\n\n\t// Initialize Model Information\n\tthis.oContents.View.Model = [];\n\n\t// Initialize View layout\n\tif (this.oContents.View.View && this.oContents.View.View[0]) {\n\t\tthis.oContents.View.View[0].tag = \"Layouts\";\n\t\tthis.oContents.View.View[0].Layouts = [];\n\t}\n}\n\nif (viewproperties) {\n\tthis.oViewProperties = JSON.parse(viewproperties);\n}\n\n// Generate model(component) information\nthis.oContents.View.Model = this.fn_GetModel();\n\n// The viewdataset must be set (막대는 바인딩 대신 스크립트로 그림)\nthis.oContents.View.attribute.viewdataset = \"${VIEW_DATASET}\";\n\n// Generate script information\nthis.oContents.View.Script = this.fn_GetScript();\n\nreturn JSON.stringify(this.oContents, null, \"\\t\");",
	"variableGroups": [
		{
			"id": "Layout",
			"variables": [
				{
					"name": "VIEW_PADDING",
					"type": "number",
					"value": "0",
					"comment": "View 가장자리 ~ 테두리 박스"
				},
				{
					"name": "FRAME_PADDING",
					"type": "number",
					"value": "12",
					"comment": "테두리 박스 ~ 내용"
				},
				{
					"name": "HEADER_HEIGHT",
					"type": "number",
					"value": "26"
				},
				{
					"name": "HEADER_GAP",
					"type": "number",
					"value": "8"
				},
				{
					"name": "SPIN_WIDTH",
					"type": "number",
					"value": "64"
				},
				{
					"name": "SPIN_LABEL_W",
					"type": "number",
					"value": "40"
				},
				{
					"name": "ROW_HEIGHT",
					"type": "number",
					"value": "26",
					"comment": "막대 한 줄 높이"
				},
				{
					"name": "BAR_HEIGHT",
					"type": "number",
					"value": "10",
					"comment": "막대 두께"
				},
				{
					"name": "LABEL_WIDTH",
					"type": "number",
					"value": "140",
					"comment": "막대 이름 칸 너비"
				},
				{
