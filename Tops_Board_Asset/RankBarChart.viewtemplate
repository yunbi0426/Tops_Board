				}
			],
			"comment": "Fonts / colors (화면과 무관한 스타일 기본 값)"
		},
		{
			"id": "Default values of view properties",
			"variables": [
				{
					"name": "TITLE_TEXT",
					"type": "string",
					"value": "\"\""
				},
				{
					"name": "EMPTY_TEXT",
