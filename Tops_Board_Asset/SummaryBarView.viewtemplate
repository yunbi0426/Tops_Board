				{
					"name": "TEXT_FONT",
					"type": "string",
					"value": "\"normal 12px/normal \\\"NotoSansKR-Regular\\\"\""
				},
				{
					"name": "FRAME_BORDER",
					"type": "string",
					"value": "\"1px solid #E4E4E7\""
