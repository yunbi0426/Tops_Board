<?xml version="1.0" encoding="utf-8"?>
<ViewTemplateInfo version="2.1">
  <ViewTemplate id="SummaryBarView" viewtype="Others" manual="viewtemplates/SummaryBarView.md" description_en="One-line summary with a proportion bar for the current row of the view dataset"/>
  <UIConfig version="1.0"><![CDATA[{
	"includes": [],
	"viewProperties": [
		{
			"id": "headerformat",
			"displaytext": "Header format",
			"editType": "String",
			"defaultValueExpr": "this.HEADER_FORMAT",
			"description": "제목 형식. {필드ID} 를 현재 행 값으로 치환. <b v='true'>굵게</b> 사용 가능",
			"group": "Header"
		},
		{
			"id": "emptytext",
			"displaytext": "Empty text",
			"editType": "String",
			"defaultValueExpr": "this.EMPTY_TEXT",
			"description": "데이터가 없을 때 제목 문구",
			"group": "Header"
		},
		{
			"id": "totalfield",
			"displaytext": "Total field",
			"editType": "String",
			"defaultValueExpr": "this.TOTAL_FIELD",
			"description": "합계로 쓸 필드 ID (막대 전체 길이 기준)",
			"group": "Total"
		},
		{
			"id": "totallabel",
			"displaytext": "Total label",
			"editType": "String",
			"defaultValueExpr": "this.TOTAL_LABEL",
			"description": "합계 앞에 붙일 문구",
			"group": "Total"
		},
		{
			"id": "restlabel",
			"displaytext": "Rest label",
			"editType": "String",
			"defaultValueExpr": "this.REST_LABEL",
			"description": "합계에서 구간을 뺀 나머지의 범례 문구",
			"group": "Total"
		},
		{
			"id": "valuesuffix",
			"displaytext": "Value suffix",
			"editType": "String",
			"defaultValueExpr": "this.VALUE_SUFFIX",
			"description": "건수 뒤에 붙일 단위 (예: 건)",
			"group": "Total"
		},
		{
			"id": "segmentcolors",
			"displaytext": "Segment colors",
			"editType": "String",
			"defaultValueExpr": "this.SEGMENT_COLORS",
			"description": "구간 색 (선택한 필드 순서대로, 쉼표 구분)",
			"group": "Bar"
		},
		{
			"id": "restcolor",
			"displaytext": "Rest color",
			"editType": "String",
			"defaultValueExpr": "this.REST_COLOR",
			"description": "나머지(막대 바탕) 색",
			"group": "Bar"
		}
	],
	"fieldProperties": [],
	"mainBody": "if (fieldarray) {\n\tthis.oFieldArray = JSON.parse(fieldarray);\n}\n\nif (contents) {\n\tthis.oContents = JSON.parse(contents);\n\n\t// Initialize Model Information\n\tthis.oContents.View.Model = [];\n\n\t// Initialize View layout\n\tif (this.oContents.View.View && this.oContents.View.View[0]) {\n\t\tthis.oContents.View.View[0].tag = \"Layouts\";\n\t\tthis.oContents.View.View[0].Layouts = [];\n\t}\n}\n\nif (viewproperties) {\n\tthis.oViewProperties = JSON.parse(viewproperties);\n}\n\nthis.arrSegIds = [];\nthis.arrSegLabels = [];\n\n// Generate model(component) information\nthis.oContents.View.Model = this.fn_GetModel();\n\n// The viewdataset must be set (값은 바인딩 대신 스크립트로 채움)\nthis.oContents.View.attribute.viewdataset = \"${VIEW_DATASET}\";\n\n// Generate script information\nthis.oContents.View.Script = this.fn_GetScript();\n\nreturn JSON.stringify(this.oContents, null, \"\\t\");",
	"variableGroups": [
		{
			"id": "Layout",
			"variables": [
				{
					"name": "VIEW_PADDING",
					"type": "number",
					"value": "0",
					"comment": "View 가장자리 ~ 테두리 박스"
				},
				{
					"name": "FRAME_PADDING",
					"type": "number",
					"value": "16",
					"comment": "테두리 박스 ~ 내용"
				},
				{
					"name": "LINE_HEIGHT",
					"type": "number",
					"value": "22",
					"comment": "제목 줄 / 범례 줄 높이"
				},
				{
					"name": "BAR_HEIGHT",
					"type": "number",
					"value": "8"
				},
				{
