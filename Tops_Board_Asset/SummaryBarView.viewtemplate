	"sectionComments": {
		"viewProperties": "View generation options (set_viewProperties)"
	},
	"functionsCode": "/************************************************************************************************\n * @FileName    SummaryBarView\n * @Description 현재 행의 합계와 구성 비율을 막대 하나로 보여주는 요약 View\n *              - 1줄 : 제목(headerformat)          ...          합계(totalfield)\n *              - 2줄 : 비율 막대 (선택한 필드 = 구간, 나머지 = 합계 - 구간 합)\n *              - 3줄 : 범례 (구간별 건수 + 나머지)\n *              - 값은 View Dataset 의 현재 행(rowposition) 기준 → 그리드 선택을 따라감\n *              - 너비는 View 에 맞춰 늘어나고, 막대 길이는 실제 너비 기준으로 다시 계산\n ************************************************************************************************/\n\n/************************************************************************************************\n * Functions Related to the main() Execution Flow\n ************************************************************************************************/\n\t// View property value (없으면 기본값)\n\tthis.fn_GetProp = function(sId, vDefault) {\n\t\tvar oAttr = (this.oViewProperties && this.oViewProperties.attributes) ? this.oViewProperties.attributes : null;\n\t\tif (oAttr && oAttr[sId] !== undefined && oAttr[sId] !== null && oAttr[sId] !== \"\") {\n\t\t\treturn oAttr[sId];\n\t\t}\n\t\treturn vDefault;\n\t};\n\n\t// 쉼표 문자열 → 배열 (공백 제거)\n\tthis.fn_Split = function(sValue) {\n\t\tvar arr = (\"\" + sValue).split(\",\");\n\t\tvar arrResult = [];\n\t\tfor (var i = 0; i < arr.length; i++) {\n\t\t\tvar s = arr[i].replace(/^\\s+|\\s+$/g, \"\");\n\t\t\tif (s != \"\") {\n\t\t\t\tarrResult.push(s);\n\t\t\t}\n\t\t}\n\t\treturn arrResult;\n\t};\n\n\t// 구간으로 쓸 필드 = 선택한 필드 중 합계 필드를 뺀 나머지\n\tthis.fn_GetSegmentFields = function() {\n\t\tvar arrFields = (this.oFieldArray && this.oFieldArray.fields) ? this.oFieldArray.fields : [];\n\t\tvar sTotal    = this.fn_GetProp(\"totalfield\", this.TOTAL_FIELD);\n\t\tvar arrResult = [];\n\n\t\tfor (var i = 0; i < arrFields.length; i++) {\n\t\t\tif (arrFields[i].id != sTotal) {\n\t\t\t\tarrResult.push(arrFields[i]);\n\t\t\t}\n\t\t}\n\t\treturn arrResult;\n\t};\n\n\tthis.fn_GetModel = function() {\n\t\tvar oModel = [];\n\n\t\tvar arrSegs   = this.fn_GetSegmentFields();\n\t\tvar arrColors = this.fn_Split(this.fn_GetProp(\"segmentcolors\", this.SEGMENT_COLORS));\n\n\t\tvar nPad   = this.VIEW_PADDING;\n\t\tvar nInner = nPad + this.FRAME_PADDING;\n\t\tvar nTop   = nInner;\n\n\t\t//---------------- 테두리 박스 : View 를 가득 채움 ----------------\n\t\toModel.push({ \"fieldid\": \"\", \"Components\": [{\n\t\t\t\"tag\": \"Static\",\n\t\t\t\"attribute\": {\n\t\t\t\t\"id\": this.ID_FRAME, \"left\": nPad, \"top\": nPad, \"right\": nPad, \"bottom\": nPad,\n\t\t\t\t\"text\": \"\", \"border\": this.FRAME_BORDER, \"borderRadius\": this.FRAME_RADIUS, \"background\": \"#FFFFFF\"\n\t\t\t}\n\t\t}] });\n\n\t\t//---------------- 1줄 : 제목(왼쪽) + 합계(오른쪽) ----------------\n\t\toModel.push({ \"fieldid\": \"\", \"Components\": [\n\t\t\t{\n\t\t\t\t\"tag\": \"Static\",\n\t\t\t\t\"attribute\": {\n\t\t\t\t\t\"id\": this.ID_HEADER, \"left\": nInner, \"top\": nTop, \"right\": nInner, \"height\": this.LINE_HEIGHT,\n\t\t\t\t\t\"text\": \"\", \"color\": this.TEXT_COLOR, \"font\": this.TEXT_FONT, \"usedecorate\": \"true\"\n\t\t\t\t}\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"tag\": \"Static\",\n\t\t\t\t\"attribute\": {\n\t\t\t\t\t\"id\": this.ID_TOTAL, \"left\": \"50%\", \"top\": nTop, \"right\": nInner, \"height\": this.LINE_HEIGHT,\n\t\t\t\t\t\"text\": \"\", \"color\": this.TEXT_COLOR, \"font\": this.TEXT_FONT, \"usedecorate\": \"true\",\n\t\t\t\t\t\"textAlign\": \"right\"\n\t\t\t\t}\n\t\t\t}\n\t\t] });\n\n\t\tnTop += this.LINE_HEIGHT + this.LINE_GAP;\n\n\t\t//---------------- 2줄 : 비율 막대 (바탕 = 나머지 색, 위에 구간을 이어 붙임) ----------------\n\t\tvar arrBar = [{\n\t\t\t\"tag\": \"Static\",\n\t\t\t\"attribute\": {\n\t\t\t\t\"id\": this.ID_TRACK, \"left\": nInner, \"top\": nTop, \"right\": nInner, \"height\": this.BAR_HEIGHT,\n\t\t\t\t\"text\": \"\", \"background\": this.fn_GetProp(\"restcolor\", this.REST_COLOR), \"borderRadius\": \"4px\"\n\t\t\t}\n\t\t}];\n\n\t\tvar sPrevId = \"\";\n\t\tfor (var i = 0; i < arrSegs.length; i++) {\n\t\t\tvar oField = arrSegs[i];\n\t\t\tvar sId    = \"staSeg_\" + oField.id;\n\n\t\t\tarrBar.push({\n\t\t\t\t\"tag\": \"Static\",\n\t\t\t\t\"attribute\": {\n\t\t\t\t\t\"id\": sId, \"left\": (i == 0) ? nInner : sPrevId + \":0\", \"top\": nTop, \"width\": 0, \"height\": this.BAR_HEIGHT,\n\t\t\t\t\t\"text\": \"\", \"background\": arrColors.length > 0 ? arrColors[i % arrColors.length] : \"#639922\",\n\t\t\t\t\t\"_fieldid\": oField.id, \"_fieldcomptype\": \"comp\"\n\t\t\t\t}\n\t\t\t});\n\n\t\t\tthis.arrSegIds.push(oField.id);\n\t\t\tthis.arrSegLabels.push(oField.label ? oField.label : oField.id);\n\t\t\tsPrevId = sId;\n\t\t}\n\t\toModel.push({ \"fieldid\": \"\", \"Components\": arrBar });\n\n\t\tnTop += this.BAR_HEIGHT + this.LINE_GAP;\n\n\t\t//---------------- 3줄 : 범례 ----------------\n\t\toModel.push({ \"fieldid\": \"\", \"Components\": [{\n\t\t\t\"tag\": \"Static\",\n\t\t\t\"attribute\": {\n\t\t\t\t\"id\": this.ID_LEGEND, \"left\": nInner, \"top\": nTop, \"right\": nInner, \"height\": this.LINE_HEIGHT,\n\t\t\t\t\"text\": \"\", \"color\": this.TEXT_COLOR, \"font\": this.TEXT_FONT, \"usedecorate\": \"true\"\n\t\t\t}\n\t\t}] });\n\n\t\treturn oModel;\n\t};\n\n\t// 함수를 \"this.<name> = function...\" 문자열로 변환\n\tthis.fn_FuncString = function(sName) {\n\t\treturn \"\\n\\tthis.\" + sName + \" = \" + this[sName].toString() + \";\\n\";\n\t};\n\n\tthis.fn_GetScript = function() {\n\t\tvar arrColors = this.fn_Split(this.fn_GetProp(\"segmentcolors\", this.SEGMENT_COLORS));\n\n\t\t// 실행 시점에 View 스크립트가 참조할 값\n\t\tvar sValue = \"\\n\\tthis.fvHeaderFormat = \" + JSON.stringify(this.fn_GetProp(\"headerformat\", this.HEADER_FORMAT)) + \";\"\n\t\t           + \"\\n\\tthis.fvEmptyText = \" + JSON.stringify(this.fn_GetProp(\"emptytext\", this.EMPTY_TEXT)) + \";\"\n\t\t           + \"\\n\\tthis.fvTotalField = \" + JSON.stringify(this.fn_GetProp(\"totalfield\", this.TOTAL_FIELD)) + \";\"\n\t\t           + \"\\n\\tthis.fvTotalLabel = \" + JSON.stringify(this.fn_GetProp(\"totallabel\", this.TOTAL_LABEL)) + \";\"\n\t\t           + \"\\n\\tthis.fvRestLabel = \" + JSON.stringify(this.fn_GetProp(\"restlabel\", this.REST_LABEL)) + \";\"\n\t\t           + \"\\n\\tthis.fvValueSuffix = \" + JSON.stringify(this.fn_GetProp(\"valuesuffix\", this.VALUE_SUFFIX)) + \";\"\n\t\t           + \"\\n\\tthis.fvSegFields = \" + JSON.stringify(this.arrSegIds) + \";\"\n\t\t           + \"\\n\\tthis.fvSegLabels = \" + JSON.stringify(this.arrSegLabels) + \";\"\n\t\t           + \"\\n\\tthis.fvSegColors = \" + JSON.stringify(arrColors) + \";\"\n\t\t           + \"\\n\\tthis.fvRestColor = \" + JSON.stringify(this.fn_GetProp(\"restcolor\", this.REST_COLOR)) + \";\"\n\t\t           + \"\\n\\tthis.fvMinSegPx = \" + this.MIN_SEG_PX + \";\\n\";\n\n\t\tsValue += this.fn_FuncString(\"_fnViewOnLoad\");\n\t\tsValue += this.fn_FuncString(\"fn_ds_onchanged\");\n\t\tsValue += this.fn_FuncString(\"fn_onsize\");\n\t\tsValue += this.fn_FuncString(\"fn_refresh\");\n\t\tsValue += this.fn_FuncString(\"fn_toNumber\");\n\t\tsValue += this.fn_FuncString(\"fn_formatValue\");\n\t\tsValue += this.fn_FuncString(\"fn_formatNumber\");\n\n\t\treturn {\n\t\t\t\"tag\": \"Script\",\n\t\t\t\"attribute\": { \"type\": \"xscript5.1\" },\n\t\t\t\"value\": sValue\n\t\t};\n\t};\n\n/************************************************************************************************\n * Runtime Functions (생성된 View 안에서 실행되는 함수. this = View 내부 폼)\n ************************************************************************************************/\n\tthis._fnViewOnLoad = function(objForm) {\n\t\t/* Sets the view form reference so that functions declared in the view can access it */\n\t\tthis._ownerForm = objForm;\n\n\t\tvar oDs = this.parent.getViewDataset();\n\t\tif (!this._bSummaryInit) {\n\t\t\t/* 조회 완료 / 값 변경 / 행 이동 때 갱신, 크기 변경 때 막대 길이 재계산. 재호출 시 중복 등록 방지 */\n\t\t\tif (oDs) {\n\t\t\t\toDs.addEventHandler(\"onload\", this.fn_ds_onchanged, this);\n\t\t\t\toDs.addEventHandler(\"oncolumnchanged\", this.fn_ds_onchanged, this);\n\t\t\t\toDs.addEventHandler(\"onrowposchanged\", this.fn_ds_onchanged, this);\n\t\t\t}\n\t\t\tthis.addEventHandler(\"onsize\", this.fn_onsize, this);\n\t\t\tthis._bSummaryInit = true;\n\t\t}\n\n\t\tthis.fn_refresh();\n\t};\n\n\tthis.fn_ds_onchanged = function(obj, e) {\n\t\tthis.fn_refresh();\n\t};\n\n\tthis.fn_onsize = function(obj, e) {\n\t\tthis.fn_refresh();\n\t};\n\n\t/* 제목 + 합계 + 막대 + 범례를 현재 행 기준으로 다시 그림 */\n\tthis.fn_refresh = function() {\n\t\tvar oDs    = this.parent.getViewDataset();\n\t\tvar bData  = oDs && oDs.getRowCount() > 0 && oDs.rowposition >= 0;\n\t\tvar nRow   = bData ? oDs.rowposition : -1;\n\t\tvar oThis  = this;\n\t\tvar sUnit  = this.fvValueSuffix ? \" \" + this.fvValueSuffix : \"\";\n\t\tvar i;\n\n\t\t// 제목\n\t\tif (!bData) {\n\t\t\tthis.staHeader.set_text(this.fvEmptyText);\n\t\t} else {\n\t\t\tthis.staHeader.set_text((\"\" + this.fvHeaderFormat).replace(/\\{([A-Za-z0-9_]+)\\}/g, function(sAll, sCol) {\n\t\t\t\treturn oThis.fn_formatValue(oDs.getColumn(nRow, sCol));\n\t\t\t}));\n\t\t}\n\n\t\t// 구간 값과 합계 (합계 필드가 없으면 구간 합을 합계로)\n\t\tvar arrValues = [];\n\t\tvar nSegSum   = 0;\n\t\tfor (i = 0; i < this.fvSegFields.length; i++) {\n\t\t\tvar n = bData ? this.fn_toNumber(oDs.getColumn(nRow, this.fvSegFields[i])) : 0;\n\t\t\tarrValues.push(n);\n\t\t\tnSegSum += n;\n\t\t}\n\t\tvar nTotal = (bData && this.fvTotalField) ? this.fn_toNumber(oDs.getColumn(nRow, this.fvTotalField)) : nSegSum;\n\t\tvar nRest  = Math.max(nTotal - nSegSum, 0);\n\n\t\t// 합계 (오른쪽)\n\t\tthis.staTotal.set_text(bData\n\t\t\t? this.fvTotalLabel + \" <b v='true'><fs v='12'>\" + this.fn_formatNumber(nTotal) + \"</fs></b>\" + sUnit\n\t\t\t: \"\");\n\n\t\t// 막대 : 실제 막대 너비(px) 기준으로 구간 길이 계산\n\t\tvar nTrackW = this.staTrack.getOffsetWidth();\n\t\tfor (i = 0; i < this.fvSegFields.length; i++) {\n\t\t\tvar oSeg = this[\"staSeg_\" + this.fvSegFields[i]];\n\t\t\tif (!oSeg) {\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tvar nW = 0;\n\t\t\tif (nTotal > 0 && arrValues[i] > 0) {\n\t\t\t\tnW = Math.max(Math.round(nTrackW * arrValues[i] / nTotal), this.fvMinSegPx);\n\t\t\t}\n\t\t\toSeg.set_width(nW);\n\t\t}\n\n\t\t// 범례\n\t\tvar sLegend = \"\";\n\t\tif (bData) {\n\t\t\tfor (i = 0; i < this.fvSegFields.length; i++) {\n\t\t\t\tvar sColor = this.fvSegColors.length > 0 ? this.fvSegColors[i % this.fvSegColors.length] : \"#639922\";\n\t\t\t\tsLegend += \"<fc v='\" + sColor + \"'>■</fc> \" + this.fvSegLabels[i] + \" \" + this.fn_formatNumber(arrValues[i]) + sUnit + \"      \";\n\t\t\t}\n\t\t\tsLegend += \"<fc v='\" + this.fvRestColor + \"'>■</fc> \" + this.fvRestLabel + \" \" + this.fn_formatNumber(nRest) + sUnit;\n\t\t}\n\t\tthis.staLegend.set_text(sLegend);\n\t};\n\n\t/* 숫자로 변환 (숫자가 아니면 0) */\n\tthis.fn_toNumber = function(v) {\n\t\tvar n = parseFloat(v);\n\t\treturn isNaN(n) ? 0 : n;\n\t};\n\n\t/* 날짜 값은 yyyy-MM-dd (시각이 있으면 HH:mm 까지), 그 외는 문자열 */\n\tthis.fn_formatValue = function(v) {\n\t\tif (v === undefined || v === null) {\n\t\t\treturn \"\";\n\t\t}\n\t\tif (v.getFullYear) {\n\t\t\tvar p = function(n) { return n < 10 ? \"0\" + n : \"\" + n; };\n\t\t\tvar sDate = v.getFullYear() + \"-\" + p(v.getMonth() + 1) + \"-\" + p(v.getDate());\n\t\t\tif (v.getHours() == 0 && v.getMinutes() == 0) {\n\t\t\t\treturn sDate;\n\t\t\t}\n\t\t\treturn sDate + \" \" + p(v.getHours()) + \":\" + p(v.getMinutes());\n\t\t}\n\t\treturn \"\" + v;\n\t};\n\n\t/* 숫자는 천 단위 쉼표, 숫자가 아니면 그대로 */\n\tthis.fn_formatNumber = function(v) {\n\t\tvar s = \"\" + v;\n\t\tif (!/^-?\\d+(\\.\\d+)?$/.test(s)) {\n\t\t\treturn this.fn_formatValue(v);\n\t\t}\n\t\tvar arr = s.split(\".\");\n\t\tarr[0] = arr[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\");\n\t\treturn arr.join(\".\");\n\t};\n",
	"viewPropertiesValueBody": ""
}]]>
  </UIConfig>
  <Script version="1.0" type="xscript5.1"><![CDATA[/************************************************************************************************
 * Include Declarations
 ************************************************************************************************/

/************************************************************************************************
 * Variable Definitions
 ************************************************************************************************/
	// Layout
	this.VIEW_PADDING = 0;	// View 가장자리 ~ 테두리 박스
	this.FRAME_PADDING = 16;	// 테두리 박스 ~ 내용
	this.LINE_HEIGHT = 22;	// 제목 줄 / 범례 줄 높이
	this.BAR_HEIGHT = 8;
	this.LINE_GAP = 8;
	this.MIN_SEG_PX = 3;	// 0 이 아닌 구간의 최소 길이 (너무 작아 안 보이는 것 방지)

	// Fonts / colors (화면과 무관한 스타일 기본값)
	this.TEXT_FONT = "normal 12px/normal \"NotoSansKR-Regular\"";
	this.FRAME_BORDER = "1px solid #E4E4E7";
	this.TEXT_COLOR = "#3F3F46";
	this.FRAME_RADIUS = "10px";

	// Default values of view properties (화면마다 다른 값은 비워두고 View Generation 속성에서 지정)
	this.HEADER_FORMAT = "";
	this.EMPTY_TEXT = "데이터가 없습니다";
	this.TOTAL_FIELD = "";
	this.TOTAL_LABEL = "전체";
	this.REST_LABEL = "나머지";
	this.VALUE_SUFFIX = "";
	this.SEGMENT_COLORS = "#1D9E75,#EF9F27,#378ADD,#D4537E";
	this.REST_COLOR = "#E4E4E7";

	// Component ids
	this.ID_FRAME = "staFrame";
	this.ID_HEADER = "staHeader";
	this.ID_TOTAL = "staTotal";
	this.ID_TRACK = "staTrack";
	this.ID_LEGEND = "staLegend";

	// View-related variables
	this.oFieldArray;
	this.oContents;
	this.oViewProperties;
	this.arrSegIds = [];
	this.arrSegLabels = [];

/************************************************************************************************
 * Required Function Area for NexaLAP Studio
 ************************************************************************************************/

	this.set_viewProperties = function() {
		let oViewAttr = { "attributes": [] };
		let oProperties;
		// View generation options (set_viewProperties)

		oProperties = {};
		oProperties.id = "headerformat";
		oProperties.displaytext = "Header format";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.HEADER_FORMAT;
		oProperties.description = "제목 형식. {필드ID} 를 현재 행 값으로 치환. <b v='true'>굵게</b> 사용 가능";
		oProperties.group = "Header";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "emptytext";
		oProperties.displaytext = "Empty text";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.EMPTY_TEXT;
		oProperties.description = "데이터가 없을 때 제목 문구";
		oProperties.group = "Header";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "totalfield";
		oProperties.displaytext = "Total field";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.TOTAL_FIELD;
		oProperties.description = "합계로 쓸 필드 ID (막대 전체 길이 기준)";
		oProperties.group = "Total";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "totallabel";
		oProperties.displaytext = "Total label";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.TOTAL_LABEL;
		oProperties.description = "합계 앞에 붙일 문구";
		oProperties.group = "Total";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "restlabel";
		oProperties.displaytext = "Rest label";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.REST_LABEL;
		oProperties.description = "합계에서 구간을 뺀 나머지의 범례 문구";
		oProperties.group = "Total";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "valuesuffix";
		oProperties.displaytext = "Value suffix";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.VALUE_SUFFIX;
		oProperties.description = "건수 뒤에 붙일 단위 (예: 건)";
		oProperties.group = "Total";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "segmentcolors";
		oProperties.displaytext = "Segment colors";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.SEGMENT_COLORS;
		oProperties.description = "구간 색 (선택한 필드 순서대로, 쉼표 구분)";
		oProperties.group = "Bar";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "restcolor";
		oProperties.displaytext = "Rest color";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.REST_COLOR;
		oProperties.description = "나머지(막대 바탕) 색";
		oProperties.group = "Bar";
		oViewAttr.attributes.push(oProperties);

		return JSON.stringify(oViewAttr, null, "\t");
	};

	this.set_fieldProperties = function() {
		let oFieldAttr = { "attributes": [] };

		return JSON.stringify(oFieldAttr, null, "\t");
	};

	this.main = function(fieldarray, contents, viewproperties, extradata) {
		if (fieldarray) {
			this.oFieldArray = JSON.parse(fieldarray);
		}

		if (contents) {
			this.oContents = JSON.parse(contents);

			// Initialize Model Information
			this.oContents.View.Model = [];

			// Initialize View layout
			if (this.oContents.View.View && this.oContents.View.View[0]) {
				this.oContents.View.View[0].tag = "Layouts";
				this.oContents.View.View[0].Layouts = [];
			}
		}

		if (viewproperties) {
			this.oViewProperties = JSON.parse(viewproperties);
		}

		this.arrSegIds = [];
		this.arrSegLabels = [];

		// Generate model(component) information
		this.oContents.View.Model = this.fn_GetModel();

		// The viewdataset must be set (값은 바인딩 대신 스크립트로 채움)
		this.oContents.View.attribute.viewdataset = "${VIEW_DATASET}";

		// Generate script information
		this.oContents.View.Script = this.fn_GetScript();

		return JSON.stringify(this.oContents, null, "\t");
	};

	/************************************************************************************************
	 * @FileName    SummaryBarView
	 * @Description 현재 행의 합계와 구성 비율을 막대 하나로 보여주는 요약 View
	 *              - 1줄 : 제목(headerformat)          ...          합계(totalfield)
	 *              - 2줄 : 비율 막대 (선택한 필드 = 구간, 나머지 = 합계 - 구간 합)
	 *              - 3줄 : 범례 (구간별 건수 + 나머지)
	 *              - 값은 View Dataset 의 현재 행(rowposition) 기준 → 그리드 선택을 따라감
	 *              - 너비는 View 에 맞춰 늘어나고, 막대 길이는 실제 너비 기준으로 다시 계산
	 ************************************************************************************************/

	/************************************************************************************************
	 * Functions Related to the main() Execution Flow
	 ************************************************************************************************/
		// View property value (없으면 기본값)
		this.fn_GetProp = function(sId, vDefault) {
			var oAttr = (this.oViewProperties && this.oViewProperties.attributes) ? this.oViewProperties.attributes : null;
			if (oAttr && oAttr[sId] !== undefined && oAttr[sId] !== null && oAttr[sId] !== "") {
				return oAttr[sId];
			}
			return vDefault;
		};

		// 쉼표 문자열 → 배열 (공백 제거)
		this.fn_Split = function(sValue) {
			var arr = ("" + sValue).split(",");
			var arrResult = [];
			for (var i = 0; i < arr.length; i++) {
				var s = arr[i].replace(/^\s+|\s+$/g, "");
				if (s != "") {
					arrResult.push(s);
				}
			}
			return arrResult;
		};

		// 구간으로 쓸 필드 = 선택한 필드 중 합계 필드를 뺀 나머지
		this.fn_GetSegmentFields = function() {
			var arrFields = (this.oFieldArray && this.oFieldArray.fields) ? this.oFieldArray.fields : [];
			var sTotal    = this.fn_GetProp("totalfield", this.TOTAL_FIELD);
			var arrResult = [];

			for (var i = 0; i < arrFields.length; i++) {
				if (arrFields[i].id != sTotal) {
					arrResult.push(arrFields[i]);
				}
			}
			return arrResult;
		};

		this.fn_GetModel = function() {
			var oModel = [];

			var arrSegs   = this.fn_GetSegmentFields();
			var arrColors = this.fn_Split(this.fn_GetProp("segmentcolors", this.SEGMENT_COLORS));

			var nPad   = this.VIEW_PADDING;
			var nInner = nPad + this.FRAME_PADDING;
			var nTop   = nInner;

			//---------------- 테두리 박스 : View 를 가득 채움 ----------------
			oModel.push({ "fieldid": "", "Components": [{
				"tag": "Static",
				"attribute": {
					"id": this.ID_FRAME, "left": nPad, "top": nPad, "right": nPad, "bottom": nPad,
					"text": "", "border": this.FRAME_BORDER, "borderRadius": this.FRAME_RADIUS, "background": "#FFFFFF"
				}
			}] });

			//---------------- 1줄 : 제목(왼쪽) + 합계(오른쪽) ----------------
			oModel.push({ "fieldid": "", "Components": [
				{
					"tag": "Static",
					"attribute": {
						"id": this.ID_HEADER, "left": nInner, "top": nTop, "right": nInner, "height": this.LINE_HEIGHT,
						"text": "", "color": this.TEXT_COLOR, "font": this.TEXT_FONT, "usedecorate": "true"
					}
				},
				{
					"tag": "Static",
					"attribute": {
						"id": this.ID_TOTAL, "left": "50%", "top": nTop, "right": nInner, "height": this.LINE_HEIGHT,
						"text": "", "color": this.TEXT_COLOR, "font": this.TEXT_FONT, "usedecorate": "true",
						"textAlign": "right"
					}
				}
			] });

			nTop += this.LINE_HEIGHT + this.LINE_GAP;

			//---------------- 2줄 : 비율 막대 (바탕 = 나머지 색, 위에 구간을 이어 붙임) ----------------
			var arrBar = [{
				"tag": "Static",
				"attribute": {
					"id": this.ID_TRACK, "left": nInner, "top": nTop, "right": nInner, "height": this.BAR_HEIGHT,
					"text": "", "background": this.fn_GetProp("restcolor", this.REST_COLOR), "borderRadius": "4px"
				}
			}];

			var sPrevId = "";
			for (var i = 0; i < arrSegs.length; i++) {
				var oField = arrSegs[i];
				var sId    = "staSeg_" + oField.id;

				arrBar.push({
					"tag": "Static",
					"attribute": {
						"id": sId, "left": (i == 0) ? nInner : sPrevId + ":0", "top": nTop, "width": 0, "height": this.BAR_HEIGHT,
						"text": "", "background": arrColors.length > 0 ? arrColors[i % arrColors.length] : "#639922",
						"_fieldid": oField.id, "_fieldcomptype": "comp"
					}
				});

				this.arrSegIds.push(oField.id);
				this.arrSegLabels.push(oField.label ? oField.label : oField.id);
				sPrevId = sId;
			}
			oModel.push({ "fieldid": "", "Components": arrBar });

			nTop += this.BAR_HEIGHT + this.LINE_GAP;

			//---------------- 3줄 : 범례 ----------------
			oModel.push({ "fieldid": "", "Components": [{
				"tag": "Static",
				"attribute": {
					"id": this.ID_LEGEND, "left": nInner, "top": nTop, "right": nInner, "height": this.LINE_HEIGHT,
					"text": "", "color": this.TEXT_COLOR, "font": this.TEXT_FONT, "usedecorate": "true"
				}
			}] });

			return oModel;
		};

		// 함수를 "this.<name> = function..." 문자열로 변환
		this.fn_FuncString = function(sName) {
			return "\n\tthis." + sName + " = " + this[sName].toString() + ";\n";
		};

		this.fn_GetScript = function() {
			var arrColors = this.fn_Split(this.fn_GetProp("segmentcolors", this.SEGMENT_COLORS));

			// 실행 시점에 View 스크립트가 참조할 값
			var sValue = "\n\tthis.fvHeaderFormat = " + JSON.stringify(this.fn_GetProp("headerformat", this.HEADER_FORMAT)) + ";"
			           + "\n\tthis.fvEmptyText = " + JSON.stringify(this.fn_GetProp("emptytext", this.EMPTY_TEXT)) + ";"
			           + "\n\tthis.fvTotalField = " + JSON.stringify(this.fn_GetProp("totalfield", this.TOTAL_FIELD)) + ";"
			           + "\n\tthis.fvTotalLabel = " + JSON.stringify(this.fn_GetProp("totallabel", this.TOTAL_LABEL)) + ";"
			           + "\n\tthis.fvRestLabel = " + JSON.stringify(this.fn_GetProp("restlabel", this.REST_LABEL)) + ";"
			           + "\n\tthis.fvValueSuffix = " + JSON.stringify(this.fn_GetProp("valuesuffix", this.VALUE_SUFFIX)) + ";"
			           + "\n\tthis.fvSegFields = " + JSON.stringify(this.arrSegIds) + ";"
			           + "\n\tthis.fvSegLabels = " + JSON.stringify(this.arrSegLabels) + ";"
			           + "\n\tthis.fvSegColors = " + JSON.stringify(arrColors) + ";"
			           + "\n\tthis.fvRestColor = " + JSON.stringify(this.fn_GetProp("restcolor", this.REST_COLOR)) + ";"
			           + "\n\tthis.fvMinSegPx = " + this.MIN_SEG_PX + ";\n";

			sValue += this.fn_FuncString("_fnViewOnLoad");
			sValue += this.fn_FuncString("fn_ds_onchanged");
			sValue += this.fn_FuncString("fn_onsize");
			sValue += this.fn_FuncString("fn_refresh");
			sValue += this.fn_FuncString("fn_toNumber");
			sValue += this.fn_FuncString("fn_formatValue");
			sValue += this.fn_FuncString("fn_formatNumber");

			return {
				"tag": "Script",
				"attribute": { "type": "xscript5.1" },
				"value": sValue
			};
		};

	/************************************************************************************************
	 * Runtime Functions (생성된 View 안에서 실행되는 함수. this = View 내부 폼)
	 ************************************************************************************************/
		this._fnViewOnLoad = function(objForm) {
			/* Sets the view form reference so that functions declared in the view can access it */
			this._ownerForm = objForm;

			var oDs = this.parent.getViewDataset();
			if (!this._bSummaryInit) {
				/* 조회 완료 / 값 변경 / 행 이동 때 갱신, 크기 변경 때 막대 길이 재계산. 재호출 시 중복 등록 방지 */
				if (oDs) {
					oDs.addEventHandler("onload", this.fn_ds_onchanged, this);
					oDs.addEventHandler("oncolumnchanged", this.fn_ds_onchanged, this);
					oDs.addEventHandler("onrowposchanged", this.fn_ds_onchanged, this);
				}
				this.addEventHandler("onsize", this.fn_onsize, this);
				this._bSummaryInit = true;
			}

			this.fn_refresh();
		};

		this.fn_ds_onchanged = function(obj, e) {
			this.fn_refresh();
		};

		this.fn_onsize = function(obj, e) {
			this.fn_refresh();
		};

		/* 제목 + 합계 + 막대 + 범례를 현재 행 기준으로 다시 그림 */
		this.fn_refresh = function() {
			var oDs    = this.parent.getViewDataset();
			var bData  = oDs && oDs.getRowCount() > 0 && oDs.rowposition >= 0;
			var nRow   = bData ? oDs.rowposition : -1;
			var oThis  = this;
			var sUnit  = this.fvValueSuffix ? " " + this.fvValueSuffix : "";
			var i;

			// 제목
			if (!bData) {
				this.staHeader.set_text(this.fvEmptyText);
			} else {
				this.staHeader.set_text(("" + this.fvHeaderFormat).replace(/\{([A-Za-z0-9_]+)\}/g, function(sAll, sCol) {
					return oThis.fn_formatValue(oDs.getColumn(nRow, sCol));
				}));
			}

			// 구간 값과 합계 (합계 필드가 없으면 구간 합을 합계로)
			var arrValues = [];
			var nSegSum   = 0;
			for (i = 0; i < this.fvSegFields.length; i++) {
				var n = bData ? this.fn_toNumber(oDs.getColumn(nRow, this.fvSegFields[i])) : 0;
				arrValues.push(n);
				nSegSum += n;
			}
			var nTotal = (bData && this.fvTotalField) ? this.fn_toNumber(oDs.getColumn(nRow, this.fvTotalField)) : nSegSum;
			var nRest  = Math.max(nTotal - nSegSum, 0);

			// 합계 (오른쪽)
			this.staTotal.set_text(bData
				? this.fvTotalLabel + " <b v='true'><fs v='12'>" + this.fn_formatNumber(nTotal) + "</fs></b>" + sUnit
				: "");

			// 막대 : 실제 막대 너비(px) 기준으로 구간 길이 계산
			var nTrackW = this.staTrack.getOffsetWidth();
			for (i = 0; i < this.fvSegFields.length; i++) {
				var oSeg = this["staSeg_" + this.fvSegFields[i]];
				if (!oSeg) {
					continue;
				}
				var nW = 0;
				if (nTotal > 0 && arrValues[i] > 0) {
					nW = Math.max(Math.round(nTrackW * arrValues[i] / nTotal), this.fvMinSegPx);
				}
				oSeg.set_width(nW);
			}

			// 범례
			var sLegend = "";
			if (bData) {
				for (i = 0; i < this.fvSegFields.length; i++) {
					var sColor = this.fvSegColors.length > 0 ? this.fvSegColors[i % this.fvSegColors.length] : "#639922";
					sLegend += "<fc v='" + sColor + "'>■</fc> " + this.fvSegLabels[i] + " " + this.fn_formatNumber(arrValues[i]) + sUnit + "      ";
				}
				sLegend += "<fc v='" + this.fvRestColor + "'>■</fc> " + this.fvRestLabel + " " + this.fn_formatNumber(nRest) + sUnit;
			}
			this.staLegend.set_text(sLegend);
		};

		/* 숫자로 변환 (숫자가 아니면 0) */
		this.fn_toNumber = function(v) {
			var n = parseFloat(v);
			return isNaN(n) ? 0 : n;
		};

		/* 날짜 값은 yyyy-MM-dd (시각이 있으면 HH:mm 까지), 그 외는 문자열 */
		this.fn_formatValue = function(v) {
			if (v === undefined || v === null) {
				return "";
			}
			if (v.getFullYear) {
				var p = function(n) { return n < 10 ? "0" + n : "" + n; };
				var sDate = v.getFullYear() + "-" + p(v.getMonth() + 1) + "-" + p(v.getDate());
				if (v.getHours() == 0 && v.getMinutes() == 0) {
					return sDate;
				}
				return sDate + " " + p(v.getHours()) + ":" + p(v.getMinutes());
			}
			return "" + v;
		};

		/* 숫자는 천 단위 쉼표, 숫자가 아니면 그대로 */
		this.fn_formatNumber = function(v) {
			var s = "" + v;
			if (!/^-?\d+(\.\d+)?$/.test(s)) {
				return this.fn_formatValue(v);
			}
			var arr = s.split(".");
			arr[0] = arr[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
			return arr.join(".");
		};
]]>
  </Script>
</ViewTemplateInfo>