<?xml version="1.0" encoding="utf-8"?>
<ViewTemplateInfo version="2.1">
  <ViewTemplate id="ExcelUploadView" viewtype="Others" manual="viewtemplates/ExcelUploadView.md" description_en="Base date + single excel file select + upload button"/>
  <UIConfig version="1.0"><![CDATA[{
	"includes": [],
	"viewProperties": [
		{
			"id": "basedatefield",
			"displaytext": "Base date field",
			"editType": "String",
			"defaultValueExpr": "this.BASE_DATE_FIELD",
			"description": "기준일로 사용할 Model 필드 ID",
			"group": "Field"
		},
		{
			"id": "filenamefield",
			"displaytext": "File name field",
			"editType": "String",
			"defaultValueExpr": "this.FILE_NAME_FIELD",
			"group": "Field",
			"description": "선택한 파일명을 넣을 Model 필드 ID"
		},
		{
			"id": "filefilter",
			"displaytext": "File filter",
			"editType": "String",
			"defaultValueExpr": "this.FILE_FILTER",
			"description": "파일 선택 창 필터",
			"group": "Field"
		},
		{
			"id": "selecttext",
			"displaytext": "Select button text",
			"editType": "String",
			"defaultValueExpr": "this.SELECT_TEXT",
			"description": "파일 선택 버튼 문구",
			"group": "Button"
		},
		{
			"id": "uploadtext",
			"displaytext": "Upload button text",
			"editType": "String",
			"group": "Button",
			"defaultValueExpr": "this.UPLOAD_TEXT",
			"description": "업로드 버튼 문구"
		}
	],
	"fieldProperties": [],
	"mainBody": "if (fieldarray) {\n\tthis.oFieldArray = JSON.parse(fieldarray);\n}\n\nif (contents) {\n\tthis.oContents = JSON.parse(contents);\n\n\t// Initialize Model Information\n\tthis.oContents.View.Model = [];\n\n\t// Initialize View layout\n\tif (this.oContents.View.View && this.oContents.View.View[0]) {\n\t\tthis.oContents.View.View[0].tag = \"Layouts\";\n\t\tthis.oContents.View.View[0].Layouts = [];\n\t}\n}\n\nif (viewproperties) {\n\tthis.oViewProperties = JSON.parse(viewproperties);\n}\n\nthis.arrBindItems = [];\n\n// Generate model(component) information\nthis.oContents.View.Model = this.fn_GetModel();\n\n// The viewdataset must be set for binding\nthis.oContents.View.attribute.viewdataset = \"${VIEW_DATASET}\";\n\n// Generate object information\nthis.oContents.View.Objects = this.fn_GetObjects();\n\n// Generate bind information\nthis.oContents.View.Bind = this.fn_GetBind();\n\n// Generate script information\nthis.oContents.View.Script = this.fn_GetScript();\n\nreturn JSON.stringify(this.oContents, null, \"\\t\");",
	"variableGroups": [
		{
			"id": "Layout",
			"variables": [
				{
					"name": "VIEW_PADDING",
					"type": "number",
					"value": "10"
				},
				{
					"name": "COMP_HEIGHT",
					"type": "number",
					"value": "32"
				},
				{
					"name": "COMP_GAP",
					"type": "number",
					"value": "8"
				},
				{
					"name": "LABEL_GAP",
					"type": "number",
					"value": "6"
				},
				{
					"name": "CLEAR_WIDTH",
					"type": "number",
					"value": "30"
				},
				{
					"name": "MUTED_COLOR",
					"type": "string",
					"value": "\"#A1A1AA\""
				},
				{
					"name": "UPLOAD_CSSCLASS",
					"type": "string",
					"value": "\"btn_Primary\""
				}
			],
			"comment": "Layout"
		},
		{
			"id": "Default values of view properties",
			"variables": [
				{
					"name": "BASE_DATE_FIELD",
					"type": "string",
					"value": "\"base_date\""
				},
				{
					"name": "FILE_NAME_FIELD",
					"type": "string",
					"value": "\"file_name\""
				},
				{
					"name": "FILE_FILTER",
					"type": "string",
					"value": "\"Excel(*.xlsx)|*.xlsx|\""
				},
				{
					"name": "SELECT_TEXT",
					"type": "string",
					"value": "\"파일 선택\""
				},
				{
					"name": "UPLOAD_TEXT",
					"type": "string",
					"value": "\"엑셀 업로드\""
				}
			],
			"comment": "Default values of view properties"
		},
		{
			"id": "Component ids",
			"variables": [
				{
					"name": "ID_DIALOG",
					"type": "string",
					"value": "\"fdgExcel\""
				},
				{
					"name": "ID_CAL",
					"type": "string",
					"value": "\"calBaseDate\""
				},
				{
					"name": "ID_EDIT",
					"type": "string",
					"value": "\"edtFileName\""
				},
				{
					"name": "ID_SELECT",
					"type": "string",
					"value": "\"btnSelect\""
				},
				{
					"name": "ID_UPLOAD",
					"type": "string",
					"value": "\"btnUpload\""
				},
				{
					"name": "ID_CLEAR",
					"type": "string",
					"value": "\"btnFileClear\""
				}
			],
			"comment": "Component ids (업로드 버튼 id 는 Interaction 의 Trigger 대상이므로 고정)"
		},
		{
			"id": "View-related variables",
			"variables": [
				{
					"name": "oFieldArray"
				},
				{
					"name": "oContents"
				},
				{
					"name": "oViewProperties"
				},
				{
					"name": "arrBindItems",
					"type": "array",
					"items": []
				}
			],
			"comment": "View-related variables"
		}
	],
	"sectionComments": {
		"viewProperties": "View generation options (set_viewProperties)"
	},
	"functionsCode": "// View property value (없으면 기본값)\nthis.fn_GetProp = function(sId, vDefault) {\n\tvar oAttr = (this.oViewProperties && this.oViewProperties.attributes) ? this.oViewProperties.attributes : null;\n\tif (oAttr && oAttr[sId] !== undefined && oAttr[sId] !== null && oAttr[sId] !== \"\") {\n\t\treturn oAttr[sId];\n\t}\n\treturn vDefault;\n};\n\n// Model field 찾기 (없으면 null)\nthis.fn_FindField = function(sFieldId) {\n\tvar arrFields = (this.oFieldArray && this.oFieldArray.fields) ? this.oFieldArray.fields : [];\n\tfor (var i = 0; i < arrFields.length; i++) {\n\t\tif (arrFields[i].id == sFieldId) {\n\t\t\treturn arrFields[i];\n\t\t}\n\t}\n\treturn null;\n};\n\nthis.fn_GetModel = function() {\n\tvar oModel = [];\n\n\tvar sDateField = this.fn_GetProp(\"basedatefield\", this.BASE_DATE_FIELD);\n\tvar sFileField = this.fn_GetProp(\"filenamefield\", this.FILE_NAME_FIELD);\n\tvar oDateField = this.fn_FindField(sDateField);\n\tvar oFileField = this.fn_FindField(sFileField);\n\n\tvar nTop    = this.VIEW_PADDING;\n\tvar nLeft   = this.VIEW_PADDING;\n\tvar nHeight = this.COMP_HEIGHT;\n\n\t//---------------- 기준일 : Label + Calendar ----------------\n\tvar oDateLabel = {\n\t\t\"tag\": \"Static\",\n\t\t\"attribute\": {\n\t\t\t\"id\": \"staBaseDate\", \"left\": nLeft, \"top\": nTop, \"width\": 56, \"height\": nHeight,\n\t\t\t\"text\": (oDateField && oDateField.label) ? oDateField.label : \"기준일\"\n\t\t}\n\t};\n\tnLeft += 56 + this.LABEL_GAP;\n\n\tvar oCal = {\n\t\t\"tag\": \"Calendar\",\n\t\t\"attribute\": {\n\t\t\t\"id\": this.ID_CAL, \"left\": nLeft, \"top\": nTop, \"width\": 140, \"height\": nHeight,\n\t\t\t\"dateformat\": \"yyyy-MM-dd\", \"editformat\": \"yyyy-MM-dd\"\n\t\t}\n\t};\n\tnLeft += 140 + this.COMP_GAP * 2;\n\n\tif (oDateField) {\n\t\toDateLabel.attribute._fieldid = sDateField;\n\t\toDateLabel.attribute._fieldcomptype = \"label\";\n\t\toCal.attribute._fieldid = sDateField;\n\t\toCal.attribute._fieldcomptype = \"comp\";\n\t\tthis.arrBindItems.push({ \"compid\": this.ID_CAL, \"fieldid\": sDateField, \"propid\": \"value\" });\n\t}\n\toModel.push({ \"fieldid\": oDateField ? sDateField : \"\", \"Components\": [oDateLabel, oCal] });\n\n\t//---------------- 파일 : Label + Edit(readonly) ----------------\n\tvar oFileLabel = {\n\t\t\"tag\": \"Static\",\n\t\t\"attribute\": {\n\t\t\t\"id\": \"staFileName\", \"left\": nLeft, \"top\": nTop, \"width\": 40, \"height\": nHeight,\n\t\t\t\"text\": (oFileField && oFileField.label) ? oFileField.label : \"파일\"\n\t\t}\n\t};\n\tnLeft += 40 + this.LABEL_GAP;\n\n\tvar oEdit = {\n\t\t\"tag\": \"Edit\",\n\t\t\"attribute\": {\n\t\t\t\"id\": this.ID_EDIT, \"left\": nLeft, \"top\": nTop, \"width\": 300, \"height\": nHeight,\n\t\t\t\"readonly\": \"true\", \"padding\": \"0px \" + this.CLEAR_WIDTH + \"px 0px 10px\"\n\t\t}\n\t};\n\tnLeft += 300 + this.COMP_GAP;\n\n\tif (oFileField) {\n\t\toFileLabel.attribute._fieldid = sFileField;\n\t\toFileLabel.attribute._fieldcomptype = \"label\";\n\t\toEdit.attribute._fieldid = sFileField;\n\t\toEdit.attribute._fieldcomptype = \"comp\";\n\t\tthis.arrBindItems.push({ \"compid\": this.ID_EDIT, \"fieldid\": sFileField, \"propid\": \"value\" });\n\t}\n\toModel.push({ \"fieldid\": oFileField ? sFileField : \"\", \"Components\": [oFileLabel, oEdit] });\n\n\tvar oClear = {\n\t\t\"tag\": \"Button\",\n\t\t\"attribute\": {\n\t\t\t\"id\": this.ID_CLEAR, \"left\": this.ID_EDIT + \":-\" + this.CLEAR_WIDTH, \"top\": nTop,\n\t\t\t\"width\": this.CLEAR_WIDTH, \"height\": nHeight,\n\t\t\t\"text\": \"✕\", \"tooltiptext\": \"선택 취소\", \"border\": \"0px none\", \"background\": \"transparent\",\n\t\t\t\"color\": this.MUTED_COLOR, \"visible\": \"false\"\n\t\t}\n\t};\n\toModel.push({ \"fieldid\": \"\", \"Components\": [oClear] });\n\n\t//---------------- 버튼 : 파일 선택 / 업로드 ----------------\n\tvar oSelect = {\n\t\t\"tag\": \"Button\",\n\t\t\"attribute\": {\n\t\t\t\"id\": this.ID_SELECT, \"left\": nLeft, \"top\": nTop, \"width\": 80, \"height\": nHeight,\n\t\t\t\"text\": this.fn_GetProp(\"selecttext\", this.SELECT_TEXT)\n\t\t}\n\t};\n\tnLeft += 90 + this.COMP_GAP;\n\toModel.push({ \"fieldid\": \"\", \"Components\": [oSelect] });\n\n\tvar oUpload = {\n\t\t\"tag\": \"Button\",\n\t\t\"attribute\": {\n\t\t\t\"id\": this.ID_UPLOAD, \"left\": this.ID_SELECT + \":\" + \"10\", \"top\": nTop, \"width\": 100, \"height\": nHeight,\n\t\t\t\"text\": this.fn_GetProp(\"uploadtext\", this.UPLOAD_TEXT), \"cssclass\": this.UPLOAD_CSSCLASS\n\t\t}\n\t};\n\toModel.push({ \"fieldid\": \"\", \"Components\": [oUpload] });\n\n\treturn oModel;\n};\n\nthis.fn_GetObjects = function() {\n\tvar oObjects = [];\n\n\toObjects.push({\n\t\t\"tag\": \"FileDialog\",\n\t\t\"attribute\": {\n\t\t\t\"id\": this.ID_DIALOG,\n\t\t\t\"filter\": this.fn_GetProp(\"filefilter\", this.FILE_FILTER)\n\t\t}\n\t});\n\n\treturn oObjects;\n};\n\nthis.fn_GetBind = function() {\n\tvar oBind = [];\n\tvar oBindItems = [];\n\n\tfor (var i = 0; i < this.arrBindItems.length; i++) {\n\t\toBindItems.push({\n\t\t\t\"tag\": \"BindItem\",\n\t\t\t\"attribute\": {\n\t\t\t\t\"id\": \"bind_\" + this.arrBindItems[i].compid,\n\t\t\t\t\"compid\": this.arrBindItems[i].compid,\n\t\t\t\t\"propid\": this.arrBindItems[i].propid,\n\t\t\t\t\"datasetid\": \"${VIEW_DATASET}\",\n\t\t\t\t\"columnid\": this.arrBindItems[i].fieldid\n\t\t\t}\n\t\t});\n\t}\n\n\tif (oBindItems.length > 0) {\n\t\toBind.push({ \"tag\": \"Bind\", \"Bind\": oBindItems });\n\t}\n\n\treturn oBind;\n};\n\n// 함수를 \"this.<name> = function...\" 문자열로 변환\nthis.fn_FuncString = function(sName) {\n\treturn \"\\n\\tthis.\" + sName + \" = \" + this[sName].toString() + \";\\n\";\n};\n\nthis.fn_GetScript = function() {\n\tvar sDateField = this.fn_FindField(this.fn_GetProp(\"basedatefield\", this.BASE_DATE_FIELD)) ? this.fn_GetProp(\"basedatefield\", this.BASE_DATE_FIELD) : \"\";\n\tvar sFileField = this.fn_FindField(this.fn_GetProp(\"filenamefield\", this.FILE_NAME_FIELD)) ? this.fn_GetProp(\"filenamefield\", this.FILE_NAME_FIELD) : \"\";\n\n\t// 실행 시점에 View 스크립트가 참조할 필드 ID\n\tvar sValue = \"\\n\\tthis.fvBaseDateField = \" + JSON.stringify(sDateField) + \";\"\n\t\t\t\t+ \"\\n\\tthis.fvFileNameField = \" + JSON.stringify(sFileField) + \";\\n\";\n\n\tsValue += this.fn_FuncString(\"_fnViewOnLoad\");\n\tsValue += this.fn_FuncString(\"fn_getToday\");\n\tsValue += this.fn_FuncString(\"fn_setFileName\");\n\tsValue += this.fn_FuncString(\"fn_btnSelect_onclick\");\n\tsValue += this.fn_FuncString(\"fn_fileDialog_onclose\");\n\tsValue += this.fn_FuncString(\"fn_clearFile\");\n\n\treturn {\n\t\t\"tag\": \"Script\",\n\t\t\"attribute\": { \"type\": \"xscript5.1\" },\n\t\t\"value\": sValue\n\t};\n};\n\n/************************************************************************************************\n* Runtime Functions (생성된 View 안에서 실행되는 함수. this = View 내부 폼)\n************************************************************************************************/\nthis._fnViewOnLoad = function(objForm) {\n\t/* Sets the view form reference so that functions declared in the view can access it */\n\tthis._ownerForm = objForm;\n\n\t/* 업로드 Action 이 읽어가는 파일 목록 */\n\tthis.oUploadFileList = [];\n\n\t/* View Dataset : 1행 보장 + 기준일 기본값(오늘) */\n\tvar oDs = this.parent.getViewDataset();\n\tif (oDs) {\n\t\t/* 기본 행(Normal)을 지우고 Insert 상태 행으로 새로 만든다 */\n\t\toDs.clearData();\n\t\toDs.addRow();\n\t\t\n\t\tif (this.fvBaseDateField) {\n\t\t\tvar vDate = oDs.getColumn(0, this.fvBaseDateField);\n\t\t\tif (vDate === undefined || vDate === null || vDate === \"\") {\n\t\t\t\toDs.setColumn(0, this.fvBaseDateField, this.fn_getToday());\n\t\t\t}\n\t\t}\n\t} else if (this.calBaseDate) {\n\t\tthis.calBaseDate.set_value(this.fn_getToday());\n\t}\n\n\tthis.fdgExcel.addEventHandler(\"onclose\", this.fn_fileDialog_onclose, this);\n\tthis.btnSelect.addEventHandler(\"onclick\", this.fn_btnSelect_onclick, this);\n};\n\nthis.fn_getToday = function() {\n\tvar d = new Date();\n\tvar m = d.getMonth() + 1;\n\tvar n = d.getDate();\n\treturn \"\" + d.getFullYear() + (m < 10 ? \"0\" + m : m) + (n < 10 ? \"0\" + n : n);\n};\n\nthis.fn_setFileName = function(sFileName) {\n\tvar oDs = this.parent.getViewDataset();\n\tif (oDs && this.fvFileNameField) {\n\t\tif (oDs.getRowCount() < 1) {\n\t\t\toDs.addRow();\n\t\t}\n\t\toDs.setColumn(0, this.fvFileNameField, sFileName);\n\t} else if (this.edtFileName) {\n\t\tthis.edtFileName.set_value(sFileName);\n\t}\n\n\tif (this.btnFileClear) {\n\t\tthis.btnFileClear.set_visible(!!sFileName);\n\t}\n};\n\nthis.fn_btnSelect_onclick = function(obj, e) {\n\t/* 1 : FileDialog.LOAD (파일 1개) */\n\tthis.fdgExcel.open(\"엑셀 파일 선택\", 1);\n};\n\nthis.fn_fileDialog_onclose = function(obj, e) {\n\tvar aFiles = e.virtualfiles;\n\tif (!aFiles || aFiles.length < 1) {\n\t\treturn;\t\t// 취소 : 기존 선택 유지\n\t}\n\n\tvar oFile = aFiles[0];\n\tvar sName = oFile.filename ? (\"\" + oFile.filename) : \"\";\n\tif (sName.toLowerCase().lastIndexOf(\".xlsx\") != sName.length - 5 || sName.length < 6) {\n\t\tthis.fn_clearFile();\n\t\tthis.alert(\"xlsx 파일만 업로드할 수 있습니다.\");\n\t\treturn;\n\t}\n\n\tthis.oUploadFileList = [oFile];\n\tthis.fn_setFileName(sName);\n};\n\n/* 업로드 완료 후 선택 초기화가 필요할 때 호출 */\nthis.fn_clearFile = function() {\n\tthis.oUploadFileList = [];\n\tthis.fn_setFileName(\"\");\n};\n",
	"viewPropertiesValueBody": ""
}]]>
  </UIConfig>
  <Script version="1.0" type="xscript5.1"><![CDATA[/************************************************************************************************
 * Include Declarations
 ************************************************************************************************/

/************************************************************************************************
 * Variable Definitions
 ************************************************************************************************/
	// Layout
	this.VIEW_PADDING = 10;
	this.COMP_HEIGHT = 32;
	this.COMP_GAP = 8;
	this.LABEL_GAP = 6;
	this.CLEAR_WIDTH = 30;
	this.MUTED_COLOR = "#A1A1AA";
	this.UPLOAD_CSSCLASS = "btn_Primary";

	// Default values of view properties
	this.BASE_DATE_FIELD = "base_date";
	this.FILE_NAME_FIELD = "file_name";
	this.FILE_FILTER = "Excel(*.xlsx)|*.xlsx|";
	this.SELECT_TEXT = "파일 선택";
	this.UPLOAD_TEXT = "엑셀 업로드";

	// Component ids (업로드 버튼 id 는 Interaction 의 Trigger 대상이므로 고정)
	this.ID_DIALOG = "fdgExcel";
	this.ID_CAL = "calBaseDate";
	this.ID_EDIT = "edtFileName";
	this.ID_SELECT = "btnSelect";
	this.ID_UPLOAD = "btnUpload";
	this.ID_CLEAR = "btnFileClear";

	// View-related variables
	this.oFieldArray;
	this.oContents;
	this.oViewProperties;
	this.arrBindItems = [];

/************************************************************************************************
 * Required Function Area for NexaLAP Studio
 ************************************************************************************************/

	this.set_viewProperties = function() {
		let oViewAttr = { "attributes": [] };
		let oProperties;
		// View generation options (set_viewProperties)

		oProperties = {};
		oProperties.id = "basedatefield";
		oProperties.displaytext = "Base date field";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.BASE_DATE_FIELD;
		oProperties.description = "기준일로 사용할 Model 필드 ID";
		oProperties.group = "Field";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "filenamefield";
		oProperties.displaytext = "File name field";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.FILE_NAME_FIELD;
		oProperties.description = "선택한 파일명을 넣을 Model 필드 ID";
		oProperties.group = "Field";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "filefilter";
		oProperties.displaytext = "File filter";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.FILE_FILTER;
		oProperties.description = "파일 선택 창 필터";
		oProperties.group = "Field";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "selecttext";
		oProperties.displaytext = "Select button text";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.SELECT_TEXT;
		oProperties.description = "파일 선택 버튼 문구";
		oProperties.group = "Button";
		oViewAttr.attributes.push(oProperties);

		oProperties = {};
		oProperties.id = "uploadtext";
		oProperties.displaytext = "Upload button text";
		oProperties.edittype = "String";
		oProperties.defaultvalue = this.UPLOAD_TEXT;
		oProperties.description = "업로드 버튼 문구";
		oProperties.group = "Button";
		oViewAttr.attributes.push(oProperties);

		return JSON.stringify(oViewAttr, null, "\t");
	};

	this.set_fieldProperties = function() {
		let oFieldAttr = { "attributes": [] };

		return JSON.stringify(oFieldAttr, null, "\t");
	};

	this.main = function(fieldarray, contents, viewproperties, extradata) {
		if (fieldarray) {
			this.oFieldArray = JSON.parse(fieldarray);
		}

		if (contents) {
			this.oContents = JSON.parse(contents);

			// Initialize Model Information
			this.oContents.View.Model = [];

			// Initialize View layout
			if (this.oContents.View.View && this.oContents.View.View[0]) {
				this.oContents.View.View[0].tag = "Layouts";
				this.oContents.View.View[0].Layouts = [];
			}
		}

		if (viewproperties) {
			this.oViewProperties = JSON.parse(viewproperties);
		}

		this.arrBindItems = [];

		// Generate model(component) information
		this.oContents.View.Model = this.fn_GetModel();

		// The viewdataset must be set for binding
		this.oContents.View.attribute.viewdataset = "${VIEW_DATASET}";

		// Generate object information
		this.oContents.View.Objects = this.fn_GetObjects();

		// Generate bind information
		this.oContents.View.Bind = this.fn_GetBind();

		// Generate script information
		this.oContents.View.Script = this.fn_GetScript();

		return JSON.stringify(this.oContents, null, "\t");
	};

	// View property value (없으면 기본값)
	this.fn_GetProp = function(sId, vDefault) {
		var oAttr = (this.oViewProperties && this.oViewProperties.attributes) ? this.oViewProperties.attributes : null;
		if (oAttr && oAttr[sId] !== undefined && oAttr[sId] !== null && oAttr[sId] !== "") {
			return oAttr[sId];
		}
		return vDefault;
	};

	// Model field 찾기 (없으면 null)
	this.fn_FindField = function(sFieldId) {
		var arrFields = (this.oFieldArray && this.oFieldArray.fields) ? this.oFieldArray.fields : [];
		for (var i = 0; i < arrFields.length; i++) {
			if (arrFields[i].id == sFieldId) {
				return arrFields[i];
			}
		}
		return null;
	};

	this.fn_GetModel = function() {
		var oModel = [];

		var sDateField = this.fn_GetProp("basedatefield", this.BASE_DATE_FIELD);
		var sFileField = this.fn_GetProp("filenamefield", this.FILE_NAME_FIELD);
		var oDateField = this.fn_FindField(sDateField);
		var oFileField = this.fn_FindField(sFileField);

		var nTop    = this.VIEW_PADDING;
		var nLeft   = this.VIEW_PADDING;
		var nHeight = this.COMP_HEIGHT;

		//---------------- 기준일 : Label + Calendar ----------------
		var oDateLabel = {
			"tag": "Static",
			"attribute": {
				"id": "staBaseDate", "left": nLeft, "top": nTop, "width": 56, "height": nHeight,
				"text": (oDateField && oDateField.label) ? oDateField.label : "기준일"
			}
		};
		nLeft += 56 + this.LABEL_GAP;

		var oCal = {
			"tag": "Calendar",
			"attribute": {
				"id": this.ID_CAL, "left": nLeft, "top": nTop, "width": 140, "height": nHeight,
				"dateformat": "yyyy-MM-dd", "editformat": "yyyy-MM-dd"
			}
		};
		nLeft += 140 + this.COMP_GAP * 2;

		if (oDateField) {
			oDateLabel.attribute._fieldid = sDateField;
			oDateLabel.attribute._fieldcomptype = "label";
			oCal.attribute._fieldid = sDateField;
			oCal.attribute._fieldcomptype = "comp";
			this.arrBindItems.push({ "compid": this.ID_CAL, "fieldid": sDateField, "propid": "value" });
		}
		oModel.push({ "fieldid": oDateField ? sDateField : "", "Components": [oDateLabel, oCal] });

		//---------------- 파일 : Label + Edit(readonly) ----------------
		var oFileLabel = {
			"tag": "Static",
			"attribute": {
				"id": "staFileName", "left": nLeft, "top": nTop, "width": 40, "height": nHeight,
				"text": (oFileField && oFileField.label) ? oFileField.label : "파일"
			}
		};
		nLeft += 40 + this.LABEL_GAP;

		var oEdit = {
			"tag": "Edit",
			"attribute": {
				"id": this.ID_EDIT, "left": nLeft, "top": nTop, "width": 300, "height": nHeight,
				"readonly": "true", "padding": "0px " + this.CLEAR_WIDTH + "px 0px 10px"
			}
		};
		nLeft += 300 + this.COMP_GAP;

		if (oFileField) {
			oFileLabel.attribute._fieldid = sFileField;
			oFileLabel.attribute._fieldcomptype = "label";
			oEdit.attribute._fieldid = sFileField;
			oEdit.attribute._fieldcomptype = "comp";
			this.arrBindItems.push({ "compid": this.ID_EDIT, "fieldid": sFileField, "propid": "value" });
		}
		oModel.push({ "fieldid": oFileField ? sFileField : "", "Components": [oFileLabel, oEdit] });

		var oClear = {
			"tag": "Button",
			"attribute": {
				"id": this.ID_CLEAR, "left": this.ID_EDIT + ":-" + this.CLEAR_WIDTH, "top": nTop,
				"width": this.CLEAR_WIDTH, "height": nHeight,
				"text": "✕", "tooltiptext": "선택 취소", "border": "0px none", "background": "transparent",
				"color": this.MUTED_COLOR, "visible": "false"
			}
		};
		oModel.push({ "fieldid": "", "Components": [oClear] });

		//---------------- 버튼 : 파일 선택 / 업로드 ----------------
		var oSelect = {
			"tag": "Button",
			"attribute": {
				"id": this.ID_SELECT, "left": nLeft, "top": nTop, "width": 80, "height": nHeight,
				"text": this.fn_GetProp("selecttext", this.SELECT_TEXT)
			}
		};
		nLeft += 90 + this.COMP_GAP;
		oModel.push({ "fieldid": "", "Components": [oSelect] });

		var oUpload = {
			"tag": "Button",
			"attribute": {
				"id": this.ID_UPLOAD, "left": this.ID_SELECT + ":" + "10", "top": nTop, "width": 100, "height": nHeight,
				"text": this.fn_GetProp("uploadtext", this.UPLOAD_TEXT), "cssclass": this.UPLOAD_CSSCLASS
			}
		};
		oModel.push({ "fieldid": "", "Components": [oUpload] });

		return oModel;
	};

	this.fn_GetObjects = function() {
		var oObjects = [];

		oObjects.push({
			"tag": "FileDialog",
			"attribute": {
				"id": this.ID_DIALOG,
				"filter": this.fn_GetProp("filefilter", this.FILE_FILTER)
			}
		});

		return oObjects;
	};

	this.fn_GetBind = function() {
		var oBind = [];
		var oBindItems = [];

		for (var i = 0; i < this.arrBindItems.length; i++) {
			oBindItems.push({
				"tag": "BindItem",
				"attribute": {
					"id": "bind_" + this.arrBindItems[i].compid,
					"compid": this.arrBindItems[i].compid,
					"propid": this.arrBindItems[i].propid,
					"datasetid": "${VIEW_DATASET}",
					"columnid": this.arrBindItems[i].fieldid
				}
			});
		}

		if (oBindItems.length > 0) {
			oBind.push({ "tag": "Bind", "Bind": oBindItems });
		}

		return oBind;
	};

	// 함수를 "this.<name> = function..." 문자열로 변환
	this.fn_FuncString = function(sName) {
		return "\n\tthis." + sName + " = " + this[sName].toString() + ";\n";
	};

	this.fn_GetScript = function() {
		var sDateField = this.fn_FindField(this.fn_GetProp("basedatefield", this.BASE_DATE_FIELD)) ? this.fn_GetProp("basedatefield", this.BASE_DATE_FIELD) : "";
		var sFileField = this.fn_FindField(this.fn_GetProp("filenamefield", this.FILE_NAME_FIELD)) ? this.fn_GetProp("filenamefield", this.FILE_NAME_FIELD) : "";

		// 실행 시점에 View 스크립트가 참조할 필드 ID
		var sValue = "\n\tthis.fvBaseDateField = " + JSON.stringify(sDateField) + ";"
					+ "\n\tthis.fvFileNameField = " + JSON.stringify(sFileField) + ";\n";

		sValue += this.fn_FuncString("_fnViewOnLoad");
		sValue += this.fn_FuncString("fn_getToday");
		sValue += this.fn_FuncString("fn_setFileName");
		sValue += this.fn_FuncString("fn_btnSelect_onclick");
		sValue += this.fn_FuncString("fn_fileDialog_onclose");
		sValue += this.fn_FuncString("fn_clearFile");

		return {
			"tag": "Script",
			"attribute": { "type": "xscript5.1" },
			"value": sValue
		};
	};

	/************************************************************************************************
	* Runtime Functions (생성된 View 안에서 실행되는 함수. this = View 내부 폼)
	************************************************************************************************/
	this._fnViewOnLoad = function(objForm) {
		/* Sets the view form reference so that functions declared in the view can access it */
		this._ownerForm = objForm;

		/* 업로드 Action 이 읽어가는 파일 목록 */
		this.oUploadFileList = [];

		/* View Dataset : 1행 보장 + 기준일 기본값(오늘) */
		var oDs = this.parent.getViewDataset();
		if (oDs) {
			/* 기본 행(Normal)을 지우고 Insert 상태 행으로 새로 만든다 */
			oDs.clearData();
			oDs.addRow();
		
			if (this.fvBaseDateField) {
				var vDate = oDs.getColumn(0, this.fvBaseDateField);
				if (vDate === undefined || vDate === null || vDate === "") {
					oDs.setColumn(0, this.fvBaseDateField, this.fn_getToday());
				}
			}
		} else if (this.calBaseDate) {
			this.calBaseDate.set_value(this.fn_getToday());
		}

		this.fdgExcel.addEventHandler("onclose", this.fn_fileDialog_onclose, this);
		this.btnSelect.addEventHandler("onclick", this.fn_btnSelect_onclick, this);
	};

	this.fn_getToday = function() {
		var d = new Date();
		var m = d.getMonth() + 1;
		var n = d.getDate();
		return "" + d.getFullYear() + (m < 10 ? "0" + m : m) + (n < 10 ? "0" + n : n);
	};

	this.fn_setFileName = function(sFileName) {
		var oDs = this.parent.getViewDataset();
		if (oDs && this.fvFileNameField) {
			if (oDs.getRowCount() < 1) {
				oDs.addRow();
			}
			oDs.setColumn(0, this.fvFileNameField, sFileName);
		} else if (this.edtFileName) {
			this.edtFileName.set_value(sFileName);
		}

		if (this.btnFileClear) {
			this.btnFileClear.set_visible(!!sFileName);
		}
	};

	this.fn_btnSelect_onclick = function(obj, e) {
		/* 1 : FileDialog.LOAD (파일 1개) */
		this.fdgExcel.open("엑셀 파일 선택", 1);
	};

	this.fn_fileDialog_onclose = function(obj, e) {
		var aFiles = e.virtualfiles;
		if (!aFiles || aFiles.length < 1) {
			return;		// 취소 : 기존 선택 유지
		}

		var oFile = aFiles[0];
		var sName = oFile.filename ? ("" + oFile.filename) : "";
		if (sName.toLowerCase().lastIndexOf(".xlsx") != sName.length - 5 || sName.length < 6) {
			this.fn_clearFile();
			this.alert("xlsx 파일만 업로드할 수 있습니다.");
			return;
		}

		this.oUploadFileList = [oFile];
		this.fn_setFileName(sName);
	};

	/* 업로드 완료 후 선택 초기화가 필요할 때 호출 */
	this.fn_clearFile = function() {
		this.oUploadFileList = [];
		this.fn_setFileName("");
	};
]]>
  </Script>
</ViewTemplateInfo>