					"value": "{ \"neutral\": [\"#F1EFE8\", \"#5F5E5A\"], \"info\": [\"#E6F1FB\", \"#0C447C\"], \"success\": [\"#EAF3DE\", \"#27500A\"], \"warning\": [\"#FAEEDA\", \"#854F0B\"], \"danger\": [\"#FCEBEB\", \"#A32D2D\"] }"
				}
			],
			"comment": "Fonts / colors"
		},
