					"type": "number",
					"value": "18"
				},
				{
					"name": "BADGE_HEIGHT",
					"type": "number",
					"value": "22"
				},
				{
					"name": "INFO_LABEL_HEIGHT",
					"type": "number",
					"value": "16"
				},
				{
