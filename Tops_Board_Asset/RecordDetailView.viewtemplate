<?xml version="1.0" encoding="utf-8"?>
<ViewTemplateInfo version="2.1">
  <ViewTemplate id="RecordDetailView" viewtype="Freeform" description_en="Single record detail card: key, status badge and info list on the left, title and tabbed long-text fields on the right"/>
  <UIConfig version="1.0"><![CDATA[{
	"includes": [
		{
			"value": "include \"./_lib_/util.xjs\";"
		},
		{
			"value": "include \"./_lib_/basicCommon.xjs\";"
		}
	],
	"viewProperties": [
		{
			"id": "sidewidth",
			"displaytext": "Side width",
			"editType": "Number",
			"defaultValueExpr": "this.SIDE_WIDTH",
			"description": "왼쪽 정보 영역 폭",
			"group": "Layout"
		},
		{
			"id": "emptytext",
			"displaytext": "Empty text",
			"editType": "String",
			"defaultValueExpr": "this.EMPTY_TEXT",
			"description": "본문(body) 내용이 비었을 때 표시 문구",
			"group": "Body"
		},
		{
			"id": "defaulttab",
			"displaytext": "Default tab",
			"editType": "Enum",
			"defaultValueExpr": "this.DEFAULT_TAB",
			"enumListExpr": "this.ARR_DEFAULT_TAB",
			"description": "처음 열 탭. last = 내용 있는 마지막 탭, first = 내용 있는 첫 탭",
			"group": "Body"
		},
		{
			"id": "tonemap",
			"displaytext": "Badge tone map",
			"editType": "String",
			"defaultValueExpr": "this.TONE_MAP",
			"description": "badgetone 값 → 배지 색(:배지 뒤 문구). 예) A:warning:잔여,B:success:완료 (색 = neutral/info/success/warning/danger)",
			"group": "Badge"
		}
	],
	"fieldProperties": [
		{
			"id": "fieldrole",
			"displaytext": "Field role",
			"editType": "Enum",
			"defaultValueExpr": "this.FIELD_ROLE",
			"enumListExpr": "this.ARR_FIELD_ROLE",
			"description": "key=번호(여러 개 가능), badge=상태 배지, badgetone=배지 색 기준(표시 안 함), title=제목, info=왼쪽 정보, body=오른쪽 탭, none=표시 안 함"
		},
		{
			"id": "tabgroup",
			"displaytext": "Tab group",
			"editType": "String",
			"defaultValueExpr": "\"\"",
			"description": "body 전용. 같은 이름끼리 한 탭에 위아래로 표시 (탭 이름 = 그룹 이름). 비우면 필드마다 탭 1개"
		}
	],
	"mainBody": "if (fieldarray) {\n\tthis.oFieldArray = JSON.parse(fieldarray);\n}\nif (contents) {\n\tthis.oContents = JSON.parse(contents);\n\tthis.oContents.View.Model = [];\n}\nif (viewproperties) {\n\tthis.oViewProperties = JSON.parse(viewproperties);\n}\n\nthis.fn_GetModel();\n\nthis.oContents.View.attribute.viewdataset = \"${VIEW_DATASET}\";\nthis.oContents.View.InitValue = [];\nthis.oContents.View.Objects = [];\nthis.oContents.View.Script = this.fn_GetScript();\n\n/* 이전에 템플릿이 만든 컴포넌트는 지우고, 사용자가 추가한 컴포넌트는 유지 */\nthis.fn_ClearContents();\n\nreturn JSON.stringify(this.oContents, null, \"\\t\");",
	"variableGroups": [
		{
			"id": "Layout",
			"variables": [
				{
					"name": "VIEW_PADDING",
					"type": "number",
					"value": "0"
				},
				{
					"name": "FRAME_PADDING",
					"type": "number",
					"value": "16"
				},
				{
