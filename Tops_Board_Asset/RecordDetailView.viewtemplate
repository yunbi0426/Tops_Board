					"type": "number",
					"value": "18"
				},
				{
					"name": "BODY_TOP",
					"type": "number",
					"value": "12"
				},
				{
					"name": "TITLE_GAP",
					"type": "number",
					"value": "24"
				},
				{
					"name": "TAB_INSET",
					"type": "number",
					"value": "0"
				},
				{
					"name": "TAB_BUTTON_GAP",
					"type": "number",
					"value": "24"
				},
				{
					"name": "TAB_BUTTON_HEIGHT",
					"type": "number",
					"value": "34"
				}
			],
			"comment": "Layout"
		},
		{
			"id": "Fonts & Colors",
			"variables": [
				{
					"name": "KEY_FONT",
					"type": "string",
					"value": "\"normal 12px/normal Consolas, \\\"Malgun Gothic\\\"\""
				},
				{
