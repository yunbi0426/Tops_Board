					"type": "string",
					"value": "\"\""
				},
				{
					"name": "FIELD_ROLE",
					"type": "string",
					"value": "\"info\""
				},
				{
					"name": "ARR_FIELD_ROLE",
					"type": "array",
					"items": [
						"\"info\"",
						"\"key\"",
						"\"badge\"",
						"\"badgetone\"",
						"\"title\"",
						"\"body\"",
						"\"none\""
					]
				},
				{
					"name": "ARR_DEFAULT_TAB",
					"type": "array",
					"items": [
						"\"last\"",
						"\"first\""
					]
				}
			],
			"comment": "Default values of view properties"
		},
		{
			"id": "Component ids",
			"variables": [
				{
					"name": "ID_FRAME",
					"type": "string",
					"value": "\"sta_frame\""
				},
				{
					"name": "ID_KEY",
					"type": "string",
					"value": "\"sta_key\""
				},
				{
					"name": "ID_BADGE",
					"type": "string",
					"value": "\"sta_badge\""
				},
				{
					"name": "ID_SIDE",
					"type": "string",
					"value": "\"sta_side\""
				},
				{
					"name": "ID_TITLE",
					"type": "string",
					"value": "\"sta_title\""
				},
				{
					"name": "ID_TAB",
					"type": "string",
					"value": "\"tabBody\""
				},
				{
					"name": "ID_TAB_LINE",
					"type": "string",
					"value": "\"sta_tabLine\""
				}
