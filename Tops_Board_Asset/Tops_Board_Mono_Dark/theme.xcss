<?xml version="1.0" encoding="utf-8"?>
<XCSS version="1.1">
  <Predefines>
    <Group id="MainColor">
      <Define id="primary" value="#FAFAFA"/>
      <Define id="secondary" value="#27272A"/>
      <Define id="teriary01" value="#D4D4D8"/>
      <Define id="teriary02" value="#3F3F46"/>
    </Group>
    <Group id="component">
      <Define id="border_nm" value="#3F3F46"/>
      <Define id="text_nm" value="#E4E4E7"/>
      <Define id="text_ds" value="#52525B"/>
      <Define id="background_nm" value="#18181B"/>
      <Define id="background_ds" value="#1F1F23"/>
      <Define id="btn_background" value="#18181B"/>
      <Define id="box_background" value="#1F1F23"/>
      <Define id="box_border" value="#2E2E33"/>
      <Define id="label_text" value="#A1A1AA"/>
      <Define id="fontsize_s" value="10px"/>
      <Define id="fontsize_m" value="12px"/>
      <Define id="fontsize_l" value="15px"/>
    </Group>
  </Predefines>
  <CSSData><![CDATA[/***********************************************************************/
/***** THEME : Tops_Board_Mono_Dark (dark, monochrome)	********/
/***** PROJECT NAME : TOBESOFT					********/
/***** CREATION DATES : 2025.00					********/
/***** DRAFTER : UX Team					********/
/***********************************************************************/

/***********************************************************************/
/****************************  FRAME START  ****************************/
/***********************************************************************/

/***** TitleBarControl *****/


.TitleBarControl .titleicon,
.TitleBarControl .titleicon[status=mouseover],
.TitleBarControl .titleicon[status=deactivate],
.TitleBarControl .titleicon[status=disabled]
{
	-nexa-padding : 0px 0px 0px 16px;
	color : #18181B;
	font : 700 -nexa-define(--fontsize_m) "NotoSansKR-Bold";
}



.TitleBarControl .minbutton,
.TitleBarControl .minbutton[status=focused],
.TitleBarControl .minbutton[userstatus=selected],
.TitleBarControl .minbutton[status=deactivate]
{
	-nexa-icon : URL("theme://images/tib_WF_Min.png");
}



.TitleBarControl .minbutton[status=mouseover],
.TitleBarControl .minbutton[userstatus=pushed]
{
	-nexa-icon : URL("theme://images/tib_WF_Min.png");
}



.TitleBarControl .minbutton[status=disabled]
{
	-nexa-icon : URL("theme://images/tib_WF_MinD.png");
}



.TitleBarControl .maxbutton,
.TitleBarControl .maxbutton[status=focused],
.TitleBarControl .maxbutton[userstatus=selected],
.TitleBarControl .maxbutton[status=deactivate]
{
	-nexa-icon : URL("theme://images/tib_WF_Max.png");
}



.TitleBarControl .maxbutton[status=mouseover],
.TitleBarControl .maxbutton[userstatus=pushed]
{
	-nexa-icon : URL("theme://images/tib_WF_Max.png");
}



.TitleBarControl .maxbutton[status=disabled]
{
	-nexa-icon : URL("theme://images/tib_WF_MaxD.png");
}



.TitleBarControl .normalbutton,
.TitleBarControl .normalbutton[status=focused],
.TitleBarControl .normalbutton[userstatus=selected],
.TitleBarControl .normalbutton[status=deactivate]
{
	-nexa-icon : URL("theme://images/tib_WF_Normal.png");
}



.TitleBarControl .normalbutton[status=mouseover],
.TitleBarControl .normalbutton[userstatus=pushed]
{
	-nexa-icon : URL("theme://images/tib_WF_Normal.png");
}



.TitleBarControl .normalbutton[status=disabled]
{
	-nexa-icon : URL("theme://images/tib_WF_NormalD.png");
}



.TitleBarControl .closebutton,
.TitleBarControl .closebutton[status=focused],
.TitleBarControl .closebutton[userstatus=selected],
.TitleBarControl .closebutton[status=deactivate]
{
	-nexa-icon : URL("theme://images/tib_WF_Close.png");
}



.TitleBarControl .closebutton[status=mouseover],
.TitleBarControl .closebutton[userstatus=pushed]
{
	-nexa-icon : URL("theme://images/tib_WF_Close.png");
}



.TitleBarControl .closebutton[status=disabled]
{
	-nexa-icon : URL("theme://images/tib_WF_CloseD.png");
}




/***** VscrollBarControl *****/
.VScrollBarControl,
.VScrollBarControl[status=mouseover]
{
	-nexa-border : 0px none, 0px none, 0px none, 1px solid -nexa-define(--box_border);
	-nexa-padding : 1px 1px 1px 1px;
	background : -nexa-define(--box_background);
}



.VScrollBarControl[status=disabled]
{
	-nexa-border : 0px none, 0px none, 0px none, 1px solid -nexa-define(--box_border);
	background : -nexa-define(--background_ds);
}



.VScrollBarControl .decbutton
{
	-nexa-icon : URL("theme://images/btn_WF_Vdec.png");
}



.VScrollBarControl .decbutton[status=mouseover],
.VScrollBarControl .decbutton[status=focused],
.VScrollBarControl .decbutton[userstatus=pushed],
.VScrollBarControl .decbutton[userstatus=selected]
{
	-nexa-icon : URL("theme://images/btn_WF_VdecO.png");
}



.VScrollBarControl .decbutton[status=disabled]
{
	-nexa-icon : URL("theme://images/btn_WF_VdecD.png");
}



.VScrollBarControl .incbutton
{
	-nexa-icon : URL("theme://images/btn_WF_Vinc.png");
}



.VScrollBarControl .incbutton[status=mouseover],
.VScrollBarControl .incbutton[status=focused],
.VScrollBarControl .incbutton[userstatus=pushed],
.VScrollBarControl .incbutton[userstatus=selected]
{
	-nexa-icon : URL("theme://images/btn_WF_VincO.png");
}



.VScrollBarControl .incbutton[status=disabled]
{
	-nexa-icon : URL("theme://images/btn_WF_VincD.png");
}



.VScrollBarControl .trackbar,
.VScrollBarControl .trackbar[status=focused]
{
	background : #2E2E33;
}



.VScrollBarControl .trackbar[status=mouseover]
{
	background : #9D9DA0;
}



.VScrollBarControl .trackbar[userstatus=pushed],
.VScrollBarControl .trackbar[userstatus=selected]
{
	background : #9D9DA0;
}



.VScrollBarControl .trackbar[status=disabled]
{
	background : #1F1F23;
}




/***** HscrollBarControl *****/
.HScrollBarControl,
.HScrollBarControl[status=mouseover]
{
	-nexa-border : 1px solid -nexa-define(--box_border), 0px none, 0px none, 0px none;
	-nexa-padding : 1px 1px 1px 1px;
	background : -nexa-define(--box_background);
}



.HScrollBarControl[status=disabled]
{
	-nexa-border : 1px solid -nexa-define(--box_border), 0px none, 0px none, 0px none;
	background : -nexa-define(--background_ds);
}



.HScrollBarControl .decbutton
{
	-nexa-icon : URL("theme://images/btn_WF_Hdec.png");
}



.HScrollBarControl .decbutton[status=mouseover],
.HScrollBarControl .decbutton[status=focused],
.HScrollBarControl .decbutton[userstatus=pushed],
.HScrollBarControl .decbutton[userstatus=selected]
{
	-nexa-icon : URL("theme://images/btn_WF_HdecO.png");
}



.HScrollBarControl .decbutton[status=disabled]
{
	-nexa-icon : URL("theme://images/btn_WF_HdecD.png");
}



.HScrollBarControl .incbutton
{
	-nexa-icon : URL("theme://images/btn_WF_Hinc.png");
}



.HScrollBarControl .incbutton[status=disabled]
{
	-nexa-icon : URL("theme://images/btn_WF_HincD.png");
}



.HScrollBarControl .incbutton[status=mouseover],
.HScrollBarControl .incbutton[status=focused],
.HScrollBarControl .incbutton[userstatus=pushed],
.HScrollBarControl .incbutton[userstatus=selected]
{
	-nexa-icon : URL("theme://images/btn_WF_HincO.png");
}



.HScrollBarControl .trackbar,
.HScrollBarControl .trackbar[status=focused]
{
	background : #2E2E33;
}



.HScrollBarControl .trackbar[status=mouseover]
{
	background : #9D9DA0;
}



.HScrollBarControl .trackbar[userstatus=pushed],
.HScrollBarControl .trackbar[userstatus=selected]
{
	background : #9D9DA0;
}



.HScrollBarControl .trackbar[status=disabled]
{
	background : #1F1F23;
}




/***** Form *****/


.Form[userstatus=contents]
{
	background : transparent;
}




/***********************************************************************/
/*****************************  FRAME END  *****************************/
/***********************************************************************/

/***********************************************************************/
/***********************  BASE COMPONENT START  ************************/
/***********************************************************************/

/***** Button *****/







/***** Calendar *****/
.CalendarControl
{
	-nexa-border : 1px solid -nexa-define(--border_nm);
	background : -nexa-define(--background_nm);
}



.CalendarControl[status=mouseover],
.CalendarControl[status=focused]
{
	-nexa-border : 1px solid -nexa-define(--primary);
}



.CalendarControl[status=readonly]
{
	background : -nexa-define(--background_ds);
}



.CalendarControl[status=disabled]
{
	background : -nexa-define(--background_ds);
	color : #FAFAFA;
}



.Calendar .calendaredit[status=mouseover],
.Calendar .calendaredit[status=focused],
.Calendar .calendaredit[status=readonly],
.Calendar .calendaredit[status=disabled],
.CalendarControl .calendaredit,
.CalendarControl .calendaredit[status=mouseover],
.CalendarControl .calendaredit[status=focused],
.CalendarControl .calendaredit[status=readonly],
.CalendarControl .calendaredit[status=disabled]
{
	-nexa-border : 0px none;
	-nexa-padding : 0px 6px 0px 6px;
	background : transparent;
}



.Calendar .calendaredit[userstatus=nulltext],
.CalendarControl .calendaredit[userstatus=nulltext]
{
	color : -nexa-define(--text_ds);
}



.Calendar .dropbutton,
.Calendar .dropbutton[status=focused],
.CalendarControl .dropbutton,
.CalendarControl .dropbutton[status=focused]
{
	-nexa-icon : URL("theme://images/cal_WF_DropN.png");
}



.Calendar .dropbutton[status=mouseover],
.Calendar .dropbutton[userstatus=pushed],
.Calendar .dropbutton[userstatus=selected],
.CalendarControl .dropbutton[status=mouseover],
.CalendarControl .dropbutton[userstatus=pushed],
.CalendarControl .dropbutton[userstatus=selected]
{
	-nexa-icon : URL("theme://images/cal_WF_DropO.png");
}



.Calendar .dropbutton[status=disabled],
.CalendarControl .dropbutton[status=disabled]
{
	-nexa-icon : URL("theme://images/cal_WF_DropD.png");
}



.Calendar .calendarspindownbutton,
.Calendar .calendarspindownbutton[status=focused]
{
	-nexa-icon : URL("theme://images/spn_WF_DownN.png");
}



.Calendar .calendarspindownbutton[status=mouseover],
.Calendar .calendarspindownbutton[userstatus=pushed],
.Calendar .calendarspindownbutton[userstatus=selected]
{
	-nexa-icon : URL("theme://images/spn_WF_DownO.png");
}



.Calendar .calendarspindownbutton[status=disabled]
{
	-nexa-icon : URL("theme://images/spn_WF_DownD.png");
}



.Calendar .calendarspinupbutton,
.Calendar .calendarspinupbutton[status=focused]
{
	-nexa-icon : URL("theme://images/spn_WF_UpN.png");
}



.Calendar .calendarspinupbutton[status=mouseover],
.Calendar .calendarspinupbutton[userstatus=pushed],
.Calendar .calendarspinupbutton[userstatus=selected]
{
	-nexa-icon : URL("theme://images/spn_WF_UpO.png");
}



.Calendar .calendarspinupbutton[status=disabled]
{
	-nexa-icon : URL("theme://images/spn_WF_UpD.png");
}




/***** CheckBox *****/
.CheckBox,
.CheckBox[status=focused],
.CheckBoxControl,
.CheckBoxControl[status=focused]
{
	-nexa-icon : URL("theme://images/chk_WF_BoxN.png");
	-nexa-text-padding : 0px 16px 2px 6px;
}



.CheckBox[status=mouseover],
.CheckBoxControl[status=mouseover]
{
	-nexa-icon : URL("theme://images/chk_WF_BoxO.png");
}



.CheckBox[status=mouseover][userstatus=selected],
.CheckBoxControl[status=mouseover][userstatus=selected]
{
	-nexa-icon : URL("theme://images/chk_WF_BoxSO.png");
}



.CheckBox[userstatus=selected],
.CheckBoxControl[userstatus=selected]
{
	-nexa-icon : URL("theme://images/chk_WF_BoxSN.png");
}



.CheckBox[status=disabled],
.CheckBoxControl[status=disabled]
{
	-nexa-icon : URL("theme://images/chk_WF_BoxD.png");
	color : -nexa-define(--text_ds);
}



.CheckBox[status=readonly],
.CheckBoxControl[status=readonly]
{
	-nexa-icon : URL("theme://images/chk_WF_BoxD.png");
}



.CheckBox[status=disabled][userstatus=selected],
.CheckBoxControl[status=disabled][userstatus=selected],
.CheckBox[status=readonly][userstatus=selected],
.CheckBoxControl[status=readonly][userstatus=selected]
{
	-nexa-icon : URL("theme://images/chk_WF_BoxSD.png");
}




/***** CheckBoxSet *****/
.CheckBoxSet .checkboxsetitem,
.CheckBoxSet .checkboxsetitem[status=focused],
.CheckBoxSetControl .checkboxsetitem,
.CheckBoxSetControl .checkboxsetitem[status=focused]
{
	-nexa-icon : URL("theme://images/chk_WF_BoxN.png");
	-nexa-padding : 2px 0px 5px 0px;
	-nexa-text-padding : 0px 16px 2px 6px;
}



.CheckBoxSet .checkboxsetitem[status=mouseover],
.CheckBoxSetControl .checkboxsetitem[status=mouseover]
{
	-nexa-icon : URL("theme://images/chk_WF_BoxO.png");
}



.CheckBoxSet .checkboxsetitem[status=mouseover][userstatus=selected],
.CheckBoxSetControl .checkboxsetitem[status=mouseover][userstatus=selected]
{
	-nexa-icon : URL("theme://images/chk_WF_BoxSO.png");
}



.CheckBoxSet .checkboxsetitem[userstatus=selected],
.CheckBoxSetControl .checkboxsetitem[userstatus=selected]
{
	-nexa-icon : URL("theme://images/chk_WF_BoxSN.png");
}



.CheckBoxSet .checkboxsetitem[status=readonly],
.CheckBoxSetControl .checkboxsetitem[status=readonly]
{
	-nexa-icon : URL("theme://images/chk_WF_BoxD.png");
}



.CheckBoxSet .checkboxsetitem[status=readonly][userstatus=selected],
.CheckBoxSetControl .checkboxsetitem[status=readonly][userstatus=selected]
{
	-nexa-icon : URL("theme://images/chk_WF_BoxSD.png");
}




/***** Combo *****/
.ComboControl
{
	-nexa-border : 1px solid -nexa-define(--border_nm);
	background : -nexa-define(--background_nm);
}



.ComboControl[status=mouseover],
.ComboControl[status=focused]
{
	-nexa-border : 1px solid -nexa-define(--primary);
}



.ComboControl[status=readonly]
{
	background : -nexa-define(--background_ds);
}



.ComboControl[status=disabled]
{
	background : -nexa-define(--background_ds);
}



.Combo .comboedit[status=focused],
.Combo .comboedit[status=mouseover],
.Combo .comboedit[status=readonly],
.ComboControl .comboedit,
.ComboControl .comboedit[status=focused],
.ComboControl .comboedit[status=mouseover],
.ComboControl .comboedit[status=readonly]
{
	-nexa-border : 0px none;
	-nexa-padding : 0px 0px 0px 6px;
	background : transparent;
}



.Combo .comboedit[status=disabled],
.ComboControl .comboedit[status=disabled]
{
	-nexa-border : 0px none;
	color : -nexa-define(--text_ds);
}



.Combo .comboedit[userstatus=nulltext],
.ComboControl .comboedit[userstatus=nulltext]
{
	-nexa-border : 0px none;
	color : -nexa-define(--text_ds);
}



.Combo .dropbutton,
.ComboControl .dropbutton
{
	-nexa-icon : URL("theme://images/cbo_WF_DropN.png");
}



.Combo .dropbutton[status=mouseover],
.Combo .dropbutton[userstatus=pushed],
.Combo .dropbutton[userstatus=selected],
.ComboControl .dropbutton[status=mouseover],
.ComboControl .dropbutton[userstatus=pushed],
.ComboControl .dropbutton[userstatus=selected]
{
	-nexa-icon : URL("theme://images/cbo_WF_DropO.png");
}



.Combo .dropbutton[status=disabled],
.ComboControl .dropbutton[status=disabled]
{
	-nexa-icon : URL("theme://images/cbo_WF_DropD.png");
}



.Combo .combolist
{
	-nexa-border : 1px solid -nexa-define(--border_nm);
	background : -nexa-define(--background_nm);
}



.Combo .combolist .listboxitem
{
	-nexa-padding : 4px 0px 4px 6px;
	color : -nexa-define(--text_nm);
}



.Combo .combolist .listboxitem[status=mouseover]
{
	background : -nexa-define(--box_background);
	color : -nexa-define(--primary);
}



.Combo .combolist .listboxitem[userstatus=selected]
{
	background : -nexa-define(--primary);
	color : #18181B;
}




/***** DatePickerControl *****/
.DatePickerControl
{
	-nexa-border : 1px solid -nexa-define(--border_nm);
	background : -nexa-define(--background_nm);
}



.DatePickerControl .head
{
	background : -nexa-define(--box_background);
	color : -nexa-define(--text_nm);
	font : 700 12px "NotoSansKR-Bold";
}



.DatePickerControl .head .prevbutton,
.DatePickerControl .head .prevbutton[status=focused]
{
	-nexa-icon : URL("theme://images/cal_WF_CalPrevN.png");
	-nexa-padding : 0px 5px;
}



.DatePickerControl .head .prevbutton[status=mouseover],
.DatePickerControl .head .prevbutton[userstatus=pushed],
.DatePickerControl .head .prevbutton[userstatus=selected]
{
	-nexa-icon : URL("theme://images/cal_WF_CalPrevO.png");
	-nexa-padding : 0px 5px;
}



.DatePickerControl .head .prevbutton[status=disabled]
{
	-nexa-icon : URL("theme://images/cal_WF_CalPrevD.png");
	-nexa-padding : 0px 5px;
}



.DatePickerControl .head .nextbutton,
.DatePickerControl .head .nextbutton[status=focused]
{
	-nexa-icon : URL("theme://images/cal_WF_CalNextN.png");
	-nexa-padding : 0px 5px;
}



.DatePickerControl .head .nextbutton[status=mouseover],
.DatePickerControl .head .nextbutton[userstatus=pushed],
.DatePickerControl .head .nextbutton[userstatus=selected]
{
	-nexa-icon : URL("theme://images/cal_WF_CalNextO.png");
	-nexa-padding : 0px 5px;
}



.DatePickerControl .head .nextbutton[status=disabled]
{
	-nexa-icon : URL("theme://images/cal_WF_CalNextD.png");
	-nexa-padding : 0px 5px;
}



.DatePickerControl .head .yearstatic
{
	font : 700 12px "NotoSansKR-Bold";
}



.DatePickerControl .body
{
	background : -nexa-define(--background_nm);
}



.DatePickerControl .body .weekband
{
	background : -nexa-define(--box_background);
}



.DatePickerControl .body .weekitem
{
	color : -nexa-define(--text_nm);
}



.DatePickerControl .body .weekitem[userstatus=saturday]
{
	color : #3B82F6;
}



.DatePickerControl .body .weekitem[userstatus=sunday]
{
	color : #EF4444;
}



.DatePickerControl .body .dayitem,
.DatePickerControl .body .monthitem,
.DatePickerControl .body .yearitem
{
	color : -nexa-define(--text_nm);
}



.DatePickerControl .body .dayitem[status=mouseover],
.DatePickerControl .body .monthitem[status=mouseover],
.DatePickerControl .body .yearitem[status=mouseover]
{
	background : -nexa-define(--primary);
	color : #18181B;
}



.DatePickerControl .body .dayitem[userstatus=selected],
.DatePickerControl .body .monthitem[userstatus=selected],
.DatePickerControl .body .yearitem[userstatus=selected]
{
	background : -nexa-define(--btn_background);
	color : -nexa-define(--primary);
	font : 700 12px "NotoSansKR-Bold";
}



.DatePickerControl .body .dayitem[userstatus=day]
{
	color : -nexa-define(--text_nm);
}



.DatePickerControl .body .dayitem[userstatus=today]
{
	background : -nexa-define(--box_background);
	color : -nexa-define(--primary);
	font : 700 12px "NotoSansKR-Bold";
}



.DatePickerControl .body .dayitem[userstatus=saturday]
{
	color : -nexa-define(--primary);
}



.DatePickerControl .body .dayitem[userstatus=saturday][status=focused],
.DatePickerControl .body .dayitem[userstatus=saturday][status=mouseover]
{
	color : #3B82F6;
}



.DatePickerControl .body .dayitem[userstatus=sunday]
{
	color : #EF4444;
}



.DatePickerControl .body .dayitem[userstatus=trailingday]
{
	color : -nexa-define(--text_ds);
}




/***** DateField *****/
.DateField .box,
.DateFieldBoxControl
{
	-nexa-border : 1px solid -nexa-define(--border_nm);
	-nexa-padding : 0px 0px 0px 6px;
	background : -nexa-define(--background_nm);
}



.DateField .box[status=focused],
.DateField .box[status=mouseover],
.DateFieldBoxControl[status=focused],
.DateFieldBoxControl[status=mouseover]
{
	-nexa-border : 1px solid -nexa-define(--primary);
}



.DateField .box[status=readonly],
.DateFieldBoxControl[status=readonly]
{
	background : -nexa-define(--background_ds);
}



.DateField .box[status=disabled],
.DateFieldBoxControl[status=disabled]
{
	background : -nexa-define(--background_ds);
	color : #FAFAFA;
}



.DateField .box[userstatus=invalid],
.DateFieldBoxControl[userstatus=invalid]
{
	-nexa-border : 1px solid #EF4444;
	background : -nexa-define(--background_nm);
}



.DateField .box[userstatus=valid],
.DateFieldBoxControl[userstatus=valid]
{
	-nexa-border : 1px solid #22C55E;
	background : -nexa-define(--background_nm);
}



.DateField .box .dropbutton,
.DateFieldBoxControl .dropbutton
{
	background : URL("theme://images/cal_WF_DropN.png") no-repeat center center;
}



.DateField .box .dropbutton[status=mouseover],
.DateField .box .dropbutton[userstatus=pushed],
.DateField .box .dropbutton[userstatus=selected],
.DateFieldBoxControl .dropbutton[status=mouseover],
.DateFieldBoxControl .dropbutton[userstatus=pushed],
.DateFieldBoxControl .dropbutton[userstatus=selected]
{
	background : URL("theme://images/cal_WF_DropO.png") no-repeat center center;
}



.DateField .box .dropbutton[status=disabled],
.DateFieldBoxControl .dropbutton[status=disabled]
{
	background : URL("theme://images/cal_WF_DropD.png") no-repeat center center;
}



.DateField .box .dropbutton[userstatus=invalid],
.DateFieldBoxControl .dropbutton[userstatus=invalid],
.DateField .box .dropbutton[userstatus=invalid][status=focused],
.DateFieldBoxControl .dropbutton[userstatus=invalid][status=focused],
.DateField .box .dropbutton[userstatus=invalid][status=mouseover],
.DateFieldBoxControl .dropbutton[userstatus=invalid][status=mouseover]
{
	background : URL("theme://images/cal_WF_DropINV.png") no-repeat center center;
}



.DateField .box .dropbutton[userstatus=valid],
.DateFieldBoxControl .dropbutton[userstatus=valid],
.DateField .box .dropbutton[userstatus=valid][status=focused],
.DateFieldBoxControl .dropbutton[userstatus=valid][status=focused],
.DateField .box .dropbutton[userstatus=valid][status=mouseover],
.DateFieldBoxControl .dropbutton[userstatus=valid][status=mouseover]
{
	background : URL("theme://images/cal_WF_DropV.png") no-repeat center center;
}



.DateField .nulltext,
.DateFieldControl .nulltext
{
	-nexa-padding : 0px 0px 0px 8px;
	color : -nexa-define(--text_ds);
}



.DateField .datetimepicker
{
	-nexa-padding : 0px 0px 5px 0px;
	background : -nexa-define(--btn_background);
}



.DateField .datetimepicker .cancelbutton
{
	-nexa-padding : 5px 10px 0px 10px;
	background : transparent;
	color : -nexa-define(--text_nm);
	font : 700 12px "NotoSansKR-Bold";
}



.DateField .datetimepicker .okbutton
{
	-nexa-padding : 5px 10px 0px 10px;
	background : transparent;
