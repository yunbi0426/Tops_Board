        "showcount": "true",
        "usesearch": "true",
        "searchplaceholder": "검색",
        "useheadsort": "true",
        "sortselectfirst": "true",
        "autofittype": "col",
        "nodatatext": "데이터가 없습니다"
    }
}]]>
